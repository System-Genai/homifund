<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const supportUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = supportUser.fullName || 'Renter'; %>
    <%- include('../partials/sidebar-renter') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Renter workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/profile" aria-label="Renter profile" title="Renter profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8">
          <p class="mb-1 text-label-md font-bold text-secondary">Help and guidance</p>
          <h1 class="text-headline-lg font-bold text-primary">Support</h1>
          <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Find the right renter workspace, review current product boundaries, or open the contact form for an account or platform question.</p>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="renter-support-availability-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">support_agent</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Current capability</p>
                <h2 id="renter-support-availability-title" class="mt-1 text-headline-md font-bold text-primary">Self-service help is available</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">The Contact page validates support enquiries, but delivery depends on configured email service. A private support inbox, ticket history, live chat, and response-time tracking are not connected.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">No ticket tracking</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="renter-support-topics-title">
              <div class="mb-4">
                <h2 id="renter-support-topics-title" class="text-headline-md font-bold text-on-surface">Choose a help topic</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Open the authoritative workspace for the area you are working on.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/applications"><span class="material-symbols-outlined text-primary" aria-hidden="true">assignment</span><h3 class="mt-3 font-bold text-on-surface">Applications</h3><p class="mt-2 text-body-sm text-on-surface-variant">Review application availability, prerequisites, and submission boundaries.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open applications</span></a>
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/homiscore"><span class="material-symbols-outlined text-primary" aria-hidden="true">verified</span><h3 class="mt-3 font-bold text-on-surface">HomiScore and verification</h3><p class="mt-2 text-body-sm text-on-surface-variant">Check source readiness and the current scoring boundary.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open HomiScore</span></a>
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/documents"><span class="material-symbols-outlined text-primary" aria-hidden="true">description</span><h3 class="mt-3 font-bold text-on-surface">Documents</h3><p class="mt-2 text-body-sm text-on-surface-variant">Review secure-storage requirements before providing sensitive files.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open documents</span></a>
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/payments"><span class="material-symbols-outlined text-primary" aria-hidden="true">account_balance_wallet</span><h3 class="mt-3 font-bold text-on-surface">Payments</h3><p class="mt-2 text-body-sm text-on-surface-variant">Check the payment-provider, ledger, and financial-data boundary.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open payments</span></a>
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/settings"><span class="material-symbols-outlined text-primary" aria-hidden="true">settings</span><h3 class="mt-3 font-bold text-on-surface">Account settings</h3><p class="mt-2 text-body-sm text-on-surface-variant">Review account access and the settings currently supported.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open settings</span></a>
                <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/renter/profile"><span class="material-symbols-outlined text-primary" aria-hidden="true">person</span><h3 class="mt-3 font-bold text-on-surface">Renter profile</h3><p class="mt-2 text-body-sm text-on-surface-variant">Review authenticated identity and saved renter-onboarding context.</p><span class="mt-4 inline-flex min-h-11 items-center font-bold text-primary">Open profile</span></a>
              </div>
            </section>

            <section aria-labelledby="renter-support-answers-title">
              <div class="mb-4">
                <h2 id="renter-support-answers-title" class="text-headline-md font-bold text-on-surface">Current answers</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">These answers reflect what the application supports today.</p>
              </div>
              <div class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest">
                <details class="group">
                  <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 p-5 font-bold text-on-surface hover:bg-surface-container-low"><span>Can I submit a property application?</span><span class="material-symbols-outlined shrink-0 text-on-surface-variant transition-transform group-open:rotate-180" aria-hidden="true">expand_more</span></summary>
                  <p class="px-5 pb-5 text-body-sm text-on-surface-variant">A persisted application submission service is not connected. The Applications workspace explains the required listing, consent, evidence, authorization, and review foundations.</p>
                </details>
                <details class="group">
                  <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 p-5 font-bold text-on-surface hover:bg-surface-container-low"><span>Why is no HomiScore shown?</span><span class="material-symbols-outlined shrink-0 text-on-surface-variant transition-transform group-open:rotate-180" aria-hidden="true">expand_more</span></summary>
                  <p class="px-5 pb-5 text-body-sm text-on-surface-variant">The application does not have enough validated source data or a scoring service to produce an accountable score. HomiScore shows readiness without inventing a result.</p>
                </details>
                <details class="group">
                  <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 p-5 font-bold text-on-surface hover:bg-surface-container-low"><span>Where can I see my support requests?</span><span class="material-symbols-outlined shrink-0 text-on-surface-variant transition-transform group-open:rotate-180" aria-hidden="true">expand_more</span></summary>
                  <p class="px-5 pb-5 text-body-sm text-on-surface-variant">There is no persisted support-request inbox or ticket timeline. The Contact page reports whether an enquiry was accepted for email delivery.</p>
                </details>
              </div>
              <a class="mt-4 inline-flex min-h-11 items-center gap-2 font-bold text-primary hover:underline" href="/faqs"><span class="material-symbols-outlined text-xl" aria-hidden="true">quiz</span>Browse public FAQs</a>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Support contact guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="renter-contact-support-title">
              <h2 id="renter-contact-support-title" class="text-headline-md font-bold text-primary">Contact support</h2>
              <p class="mt-2 text-body-sm text-on-surface-variant">Use the Contact form for an account or platform question. The page will show a clear success or delivery error state after submission.</p>
              <a class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-primary px-5 font-bold text-on-primary hover:opacity-90" href="/contact#contact-form"><span class="material-symbols-outlined text-xl" aria-hidden="true">contact_support</span>Open contact form</a>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="renter-request-details-title">
              <h2 id="renter-request-details-title" class="text-headline-md font-bold text-primary">Useful request details</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>The page or workspace where the issue occurred.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>The action you took and the exact visible error.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Safe steps that reproduce the issue.</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-error bg-error-container p-6" aria-labelledby="renter-support-safety-title">
              <h2 id="renter-support-safety-title" class="text-headline-md font-bold text-on-error-container">Keep sensitive data private</h2>
              <p class="mt-2 text-body-sm text-on-error-container">Do not send passwords, identity or income documents, bank or card details, access tokens, or full application records in an initial support message.</p>
            </section>

            <section class="border-l-4 border-primary bg-surface-container-low px-5 py-4" aria-labelledby="renter-urgent-help-title">
              <h2 id="renter-urgent-help-title" class="font-bold text-on-surface">Urgent property or personal safety</h2>
              <p class="mt-2 text-body-sm text-on-surface-variant">HomiFund support is not an emergency service. Contact the appropriate local emergency, property, utility, or legal service for urgent help.</p>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
