<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="bg-surface text-on-surface">
    <%- include('../partials/sidebar-renter') %>
    <!-- SideNavBar Anchor -->

    <!-- Main Viewport -->
    <main class="md:ml-[240px] min-h-screen flex flex-col">
      <!-- TopNavBar Anchor -->
      <header
        class="sticky top-0 z-40 h-16 bg-surface flex justify-between items-center gap-3 pl-16 pr-4 sm:pr-6 md:pl-6 md:pr-6 lg:px-10 border-b border-outline-variant shadow-sm"
      >
        <div class="hidden sm:flex items-center gap-4 flex-1">
          <div class="hidden sm:block relative w-full max-w-md">
            <span
              class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant"
              data-icon="search"
              >search</span
            >
            <input
              class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container transition-all"
              placeholder="Search properties, applications, documents..."
              type="text"
            />
          </div>
        </div>
        <div class="flex items-center gap-1 sm:gap-3 lg:gap-6 ml-auto">
          <div class="flex items-center gap-0.5 sm:gap-2 lg:gap-4 text-on-surface-variant">
            <a
              class="relative hover:bg-surface-container-low p-2 rounded-full transition-colors"
              href="/user/renter/notification-bell"
              aria-label="Notifications"
            >
              <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
              <span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"></span>
            </a>
            <a
              class="hover:bg-surface-container-low p-2 rounded-full transition-colors"
              href="/user/renter/settings"
              aria-label="Settings"
            >
              <span class="material-symbols-outlined" data-icon="settings">settings</span>
            </a>
            <a
              class="hover:bg-surface-container-low p-2 rounded-full transition-colors"
              href="/user/renter/messages"
              aria-label="Messages"
            >
              <span class="material-symbols-outlined" data-icon="chat_bubble">chat_bubble</span>
            </a>
          </div>
          <div class="hidden sm:block h-8 w-px bg-outline-variant"></div>
          <div class="flex items-center gap-3 lg:pl-2 group cursor-pointer shrink-0">
            <div class="hidden lg:block text-right">
              <p
                class="text-label-md font-bold text-on-surface leading-none flex items-center gap-1 justify-end"
              >
                Marcus R.
                <span
                  class="material-symbols-outlined text-primary text-[16px]"
                  style="font-variation-settings: &quot;FILL&quot; 1"
                  >verified</span
                >
              </p>
              <p class="text-label-sm text-on-surface-variant">
                Premium Member
              </p>
            </div>
            <div
              class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border-2 border-primary-container overflow-hidden shrink-0"
            >
              <img
                class="w-full h-full object-cover"
                data-alt="A professional studio headshot of a young adult man with a friendly expression, soft cinematic lighting, warm office background, high-resolution photography style consistent with a modern corporate PropTech platform."
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-K-ZZ89ru1SWv-PEdlTck1PFzK0rEckAq1tIhzdaNziZzV6IR6qu1yFTugsZtGCb8Gtz__AVoHptbp6WcnYRfz5gN32QFNpWUD5Kv6KGncaGDgAaFLqeBErnudLzR0tWbMVknKadoN_FU4tlBlt_sBYAWVnJm2BYHceYG_WSfoWBEkX44SZEPWF_67iBx_wS6OeBMds5keqwJWPc9myWl6dw-S_VApHflgfTATnUwhjHwDgU5Lk51nTX49yptiULVd_LkGsUjHpFe"
              />
            </div>
          </div>
        </div>
      </header>
      <!-- Hero Section -->
      <section class="px-margin-desktop py-10 bg-surface">
        <div class="max-w-container-max mx-auto">
          <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6"
          >
            <div>
              <h2
                class="text-headline-xl font-headline-xl text-primary tracking-tight"
              >
                Welcome back, Marcus
              </h2>
              <p class="text-body-lg text-on-surface-variant max-w-2xl mt-2">
                Your HomiScore is active and helping trusted landlords assess
                your application faster.
              </p>
            </div>
            <div class="grid grid-cols-2 sm:flex gap-3 sm:gap-4">
              <div
                class="bg-surface-container-lowest border border-outline-variant p-4 rounded-xl sm:min-w-[140px] shadow-sm"
