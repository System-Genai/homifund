                  </div>
                  <div class="p-5">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="text-headline-md text-on-surface">
                        Brick Lane Lofts
                      </h4>
                      <span class="text-primary font-black"
                        >£2,850<span
                          class="text-label-sm font-normal text-on-surface-variant"
                          >/mo</span
                        ></span
                      >
                    </div>
                    <p
                      class="text-body-md text-on-surface-variant mb-4 flex items-center gap-1"
                    >
                      <span class="material-symbols-outlined text-[18px]"
