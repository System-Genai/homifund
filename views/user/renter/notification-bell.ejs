                    <div class="flex items-center gap-4 mb-6">
                      <span
                        class="text-label-sm text-on-surface-variant flex items-center gap-1"
                        ><span class="material-symbols-outlined text-[16px]"
                          >bed</span
                        >
                        1 Bed</span
                      >
                      <span
                        class="text-label-sm text-on-surface-variant flex items-center gap-1"
                        ><span class="material-symbols-outlined text-[16px]"
                          >bathtub</span
                        >
                        1 Bath</span
