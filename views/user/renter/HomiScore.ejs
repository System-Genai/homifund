                <div class="w-px flex-1 bg-outline-variant"></div>
              </div>
              <div class="flex-1 pb-3">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
                  <h4 class="font-label-md text-label-md font-bold">
                    Rental reference added
                  </h4>
                  <span
                    class="font-label-sm text-label-sm text-primary font-bold"
                    >+20 pts</span
                  >
                </div>
                <p
                  class="font-label-sm text-label-sm text-on-surface-variant mt-1"
                >
                  Previous landlord reference confirmed three years of positive
                  rental history.
                </p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="flex flex-col items-center">
                <div class="w-3 h-3 rounded-full bg-outline-variant mt-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
                  <h4 class="font-label-md text-label-md font-bold">
                    Initial renter HomiScore generated
                  </h4>
                  <span
                    class="font-label-sm text-label-sm text-on-surface-variant font-bold"
                    >842</span
                  >
                </div>
                <p
                  class="font-label-sm text-label-sm text-on-surface-variant mt-1"
                >
                  Score generated after identity, affordability, income and
                  rental profile review.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Report Footer -->
        <div class="mt-10 pt-8 border-t border-outline-variant/30 pb-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center md:text-left">
              <p
                class="text-[11px] uppercase tracking-[0.18em] text-on-surface-variant mb-2"
              >
                Last Updated
              </p>
              <p class="font-semibold text-on-surface">Today, 14:20 GMT</p>
            </div>
            <div class="text-center">
              <p
                class="text-[11px] uppercase tracking-[0.18em] text-on-surface-variant mb-2"
              >
                Report Version
              </p>
              <p class="font-semibold text-on-surface">HomiScore Report v1.0</p>
            </div>
            <div class="text-center md:text-right">
              <p
                class="text-[11px] uppercase tracking-[0.18em] text-on-surface-variant mb-2"
              >
                Verification Status
              </p>
              <div
                class="inline-flex items-center gap-2 font-semibold text-primary"
              >
                <span
                  class="material-symbols-outlined text-[18px]"
                  style="font-variation-settings: &quot;FILL&quot; 1"
                  >verified</span
                >
                Verified by HomiFund
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <!-- Contextual FAB (Suppressed on Details as per rules, but included if viewed as 'HomiScore Home') -->

    <script>
      // Simple interaction for checkboxes
      document.querySelectorAll(".group").forEach((item) => {
        item.addEventListener("click", function () {
          const icon = this.querySelector(".material-symbols-outlined");
          if (icon && icon.classList.contains("text-transparent")) {
            icon.classList.remove("text-transparent");
            icon.classList.add("text-primary");
            this.classList.add("bg-green-50");
          }
        });
      });

      // Search bar focus effect
      const searchInput = document.querySelector('input[type="text"]');
      searchInput.addEventListener("focus", () => {
        searchInput.parentElement.classList.add("ring-2", "ring-primary/20");
      });
      searchInput.addEventListener("blur", () => {
        searchInput.parentElement.classList.remove("ring-2", "ring-primary/20");
      });
    </script>

    <script src="/js/main.js"></script>
  </body>
</html>
