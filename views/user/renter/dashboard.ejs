<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const dashboardUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const savedProfile = typeof renterProfile === 'object' && renterProfile ? renterProfile : {}; %>
    <% const displayName = dashboardUser.fullName || 'Renter'; %>
    <% const householdLabels = { one: '1 person', two: '2 people', three: '3 people', 'four-plus': '4 or more people' }; %>
    <% const petLabels = { none: 'No pets', one: 'One pet', multiple: 'Multiple pets' }; %>
    <% const employmentLabels = { employed: 'Employed', 'self-employed': 'Self-employed', student: 'Student', retired: 'Retired', other: 'Other' }; %>
    <% const propertyLabels = { apartment: 'Apartment', house: 'House', studio: 'Studio', 'shared-home': 'Shared home', flexible: 'Flexible' }; %>
    <%- include('../partials/sidebar-renter') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0"><p class="truncate text-label-sm font-bold text-secondary">Renter workspace</p><p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p></div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/renter/profile" aria-label="Renter profile" title="Renter profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8">
          <p class="mb-1 text-label-md font-bold text-secondary">Renter workspace</p>
          <h1 class="text-headline-lg font-bold text-primary">Renter dashboard</h1>
          <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review your saved account and search preferences. Property discovery, matching, applications, documents, payments, messages, and viewings need their own persisted services.</p>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="renter-dashboard-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">space_dashboard</span>
              <div><p class="text-label-sm font-bold uppercase text-secondary">Workspace status</p><h2 id="renter-dashboard-status-title" class="mt-1 text-headline-md font-bold text-primary">Renter activity is not connected</h2><p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">This application has no Property, Match, Application, Viewing, Message, Document, Payment, or Notification records to summarize.</p></div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 linked activity records</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section class="border border-outline-variant bg-surface-container-lowest p-6 sm:p-8" aria-labelledby="saved-renter-profile-title">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div><p class="text-label-sm font-bold uppercase text-secondary">Saved account context</p><h2 id="saved-renter-profile-title" class="mt-1 text-headline-md font-bold text-on-surface"><%= displayName %></h2><p class="mt-1 break-words text-body-sm text-on-surface-variant"><%= dashboardUser.email || 'Email unavailable' %></p></div>
                <div class="flex flex-col gap-3 sm:items-end"><a class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 font-bold text-on-primary hover:opacity-90" href="/onboarding-tenant"><span class="material-symbols-outlined text-xl" aria-hidden="true">edit</span>Update renter profile</a><a class="inline-flex min-h-11 items-center justify-center gap-2 font-bold text-primary hover:underline" href="/tenant-verification">Prepare verification</a></div>
              </div>
              <dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Legal name</dt><dd class="mt-1 break-words text-body-sm text-on-surface"><%= savedProfile.legalName || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Phone</dt><dd class="mt-1 break-words text-body-sm text-on-surface"><%= savedProfile.phone || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Household</dt><dd class="mt-1 text-body-sm text-on-surface"><%= householdLabels[savedProfile.householdSize] || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Pets</dt><dd class="mt-1 text-body-sm text-on-surface"><%= petLabels[savedProfile.petStatus] || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Employment</dt><dd class="mt-1 text-body-sm text-on-surface"><%= employmentLabels[savedProfile.employmentStatus] || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Property preference</dt><dd class="mt-1 text-body-sm text-on-surface"><%= propertyLabels[savedProfile.propertyType] || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Preferred locations</dt><dd class="mt-1 break-words text-body-sm text-on-surface"><%= savedProfile.preferredLocations || 'Not saved' %></dd></div>
                <div class="rounded-lg bg-surface-container-low p-4"><dt class="text-label-sm font-bold text-secondary">Monthly budget preference</dt><dd class="mt-1 text-body-sm text-on-surface"><%= savedProfile.monthlyBudget !== undefined && savedProfile.monthlyBudget !== null ? String(savedProfile.monthlyBudget) + ' (currency not recorded)' : 'Not saved' %></dd></div>
              </dl>
            </section>

            <section aria-labelledby="renter-workspace-foundations-title">
              <div class="mb-4"><h2 id="renter-workspace-foundations-title" class="text-headline-md font-bold text-on-surface">Required renter-workspace foundations</h2><p class="mt-1 text-body-sm text-on-surface-variant">Dashboard summaries should come from explicit records, never decorative sample data.</p></div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">manage_accounts</span><h3 class="mt-3 font-bold text-on-surface">Profile-owned preferences</h3><p class="mt-2 text-body-sm text-on-surface-variant">Search preferences remain renter-owned, editable, separately consented, and distinct from verification evidence or application criteria.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">travel_explore</span><h3 class="mt-3 font-bold text-on-surface">Authoritative discovery</h3><p class="mt-2 text-body-sm text-on-surface-variant">Matches require published listings, current availability, renter-selected filters, explainable ranking, saved state, and correction controls.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">assignment</span><h3 class="mt-3 font-bold text-on-surface">Application lifecycle</h3><p class="mt-2 text-body-sm text-on-surface-variant">Applications need listing identity, consented submission versions, delivery, landlord receipt, status history, withdrawal, and decision explanations.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">shield_lock</span><h3 class="mt-3 font-bold text-on-surface">Protected activity services</h3><p class="mt-2 text-body-sm text-on-surface-variant">Documents, messages, payments, notifications, and viewings require scoped authorization, secure storage, delivery state, and audit history.</p></article>
              </div>
            </section>

            <section aria-labelledby="renter-record-counts-title">
              <div class="mb-4"><h2 id="renter-record-counts-title" class="text-headline-md font-bold text-on-surface">Current linked records</h2><p class="mt-1 text-body-sm text-on-surface-variant">Zero means no connected record was found. It is not a risk, rejection, or eligibility result.</p></div>
              <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Property matches</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Applications</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Viewings</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Messages</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Documents</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Payments</dt><dd class="mt-2 text-headline-md font-bold text-primary">0</dd></div>
              </dl>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Renter dashboard boundaries">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="renter-journeys-title"><h2 id="renter-journeys-title" class="text-headline-md font-bold text-primary">Available account journeys</h2><nav class="mt-4 flex flex-col"><a class="inline-flex min-h-11 items-center justify-between gap-3 border-b border-outline-variant py-3 font-bold text-primary hover:underline" href="/onboarding-tenant">Update saved profile<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a><a class="inline-flex min-h-11 items-center justify-between gap-3 border-b border-outline-variant py-3 font-bold text-primary hover:underline" href="/tenant-verification">Prepare verification<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a><a class="inline-flex min-h-11 items-center justify-between gap-3 py-3 font-bold text-primary hover:underline" href="/user/renter/homiscore">Review HomiScore readiness<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a></nav></section>
            <section class="rounded-lg border border-error bg-error-container p-6" aria-labelledby="renter-dashboard-privacy-title"><h2 id="renter-dashboard-privacy-title" class="text-headline-md font-bold text-on-error-container">Keep sensitive evidence private</h2><p class="mt-2 text-body-sm text-on-error-container">Do not send identity files, income evidence, bank details, card information, access credentials, or complete applications through Contact or unverified channels.</p></section>
            <section class="border-l-4 border-primary bg-surface-container-low px-5 py-4" aria-labelledby="zero-record-meaning-title"><h2 id="zero-record-meaning-title" class="font-bold text-on-surface">No inferred outcomes</h2><p class="mt-2 text-body-sm text-on-surface-variant">Missing activity remains unavailable. The dashboard does not invent matches, scores, verification, affordability, payment health, or landlord decisions.</p></section>
          </aside>
        </div>
      </div>
    </main>
    <script src="/js/main.js"></script>
  </body>
</html>
