    <script>
      (() => {
        const messageMenu = document.getElementById("messages-menu");
        const messageToggle = document.getElementById("messages-toggle");
        const messageDropdown = document.getElementById("messages-dropdown");
        const workspace = document.getElementById("messages-workspace");
        const closeWorkspace = document.getElementById(
          "close-messages-workspace",
        );
        const conversationRows = [
          ...document.querySelectorAll(".conversation-row"),
        ];
        const previewRows = [...document.querySelectorAll(".message-preview")];
        const openAllButtons = [
          document.getElementById("open-all-messages"),
          document.getElementById("open-all-messages-bottom"),
        ];
        const activeAvatar = document.getElementById("active-avatar");
        const activeTitle = document.getElementById("active-title");
        const activeSubtitle = document.getElementById("active-subtitle");
        const thread = document.getElementById("message-thread");
        const input = document.getElementById("message-input");
        const sendButton = document.getElementById("send-message");
        const conversationSearch = document.getElementById(
          "conversation-search",
        );

        const conversations = {
          sapphire: {
            initials: "TS",
            title: "The Sapphire Suites",
            subtitle: "Landlord · Application and viewing messages",
            messages: [
              {
                side: "them",
                text: "Hello Marcus, thanks for your interest in The Sapphire Suites.",
                time: "Today, 10:12",
              },
              {
                side: "me",
                text: "Thank you. I would like to confirm the viewing details.",
                time: "Today, 10:18",
              },
              {
                side: "them",
                text: "The viewing is confirmed for Tuesday at 2:00 PM. Please let us know if anything changes.",
                time: "Now",
              },
            ],
          },
          bricklane: {
            initials: "BL",
            title: "Brick Lane Lofts",
            subtitle: "Lettings agent · Application messages",
            messages: [
              {
                side: "them",
                text: "Thanks for your application for Brick Lane Lofts.",
                time: "Yesterday, 15:42",
              },
              {
                side: "me",
                text: "Thank you. Please let me know if you need anything else from me.",
                time: "Yesterday, 16:05",
              },
              {
                side: "them",
                text: "We will be in touch once the next review step is complete.",
                time: "Yesterday, 16:11",
              },
            ],
          },
          regents: {
            initials: "RP",
            title: "Regent's Park Estate",
            subtitle: "Property team · Application messages",
            messages: [
              {
                side: "them",
                text: "Your application is currently under review.",
                time: "Monday, 11:26",
              },
              {
                side: "me",
                text: "Thank you for the update.",
                time: "Monday, 11:31",
              },
              {
                side: "them",
                text: "We will contact you through HomiFund when there is a further update.",
                time: "Monday, 11:36",
              },
            ],
          },
        };

        let activeConversation = "sapphire";

        function setDropdownOpen(open) {
          messageDropdown.classList.toggle("hidden", !open);
          messageToggle.setAttribute("aria-expanded", String(open));
          messageToggle.classList.toggle("bg-secondary-container", open);
          messageToggle.classList.toggle("text-primary", open);
        }


        // --- responsive master/detail (mobile shows one pane at a time) ---
        const listPane = document.getElementById("conversation-pane");
        const threadPane = document.getElementById("thread-pane");
        const backBtn = document.getElementById("thread-back");
        const isMobilePane = () => window.matchMedia("(max-width: 767px)").matches;
        function showThreadPane() {
          if (!isMobilePane()) return;
          listPane?.classList.add("hidden");
          threadPane?.classList.remove("hidden");
          threadPane?.classList.add("flex");
        }
        function showListPane() {
          if (!isMobilePane()) return;
          listPane?.classList.remove("hidden");
          threadPane?.classList.add("hidden");
          threadPane?.classList.remove("flex");
        }
        backBtn?.addEventListener("click", showListPane);
        window.addEventListener("resize", () => {
          if (!isMobilePane()) {
            listPane?.classList.remove("hidden");
            threadPane?.classList.remove("hidden");
            threadPane?.classList.add("flex");
          } else {
            showListPane();
          }
        });

        function renderThread() {
          const conversation = conversations[activeConversation];
          activeAvatar.textContent = conversation.initials;
          activeTitle.textContent = conversation.title;
          activeSubtitle.textContent = conversation.subtitle;
          thread.innerHTML = conversation.messages
            .map((message) => {
              const own = message.side === "me";
              return `<div class="flex ${own ? "justify-end" : "justify-start"}">
        <div class="max-w-[75%]">
          <div class="${own ? "bg-primary text-white" : "bg-surface-container-lowest border border-outline-variant text-on-surface"} rounded-xl px-4 py-3 text-sm">
            ${message.text}
          </div>
          <p class="text-[11px] text-on-surface-variant mt-1 ${own ? "text-right" : ""}">${message.time}</p>
        </div>
      </div>`;
            })
            .join("");
          thread.scrollTop = thread.scrollHeight;
        }

        function setActiveConversation(id) {
          activeConversation = id;
          conversationRows.forEach((row) => {
            const selected = row.dataset.conversation === id;
            row.classList.toggle("bg-secondary-container", selected);
            row.classList.toggle("hover:bg-surface-container-low", !selected);
            row.querySelectorAll("p").forEach((p) => {
              p.classList.toggle(
                "text-primary",
                selected && p.classList.contains("font-semibold"),
              );
            });
          });
          renderThread();
        }

        function openWorkspace(id = activeConversation) {
          setDropdownOpen(false);
          workspace.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
          setActiveConversation(id);
          if (isMobilePane()) showListPane();
          setTimeout(() => {
            if (!isMobilePane()) input.focus();
          }, 60);
        }

        function closeWorkspacePanel() {
          workspace.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
        }

        messageToggle.addEventListener("click", (event) => {
          event.stopPropagation();
          setDropdownOpen(messageDropdown.classList.contains("hidden"));
        });

        document.addEventListener("click", (event) => {
          if (!messageMenu.contains(event.target)) setDropdownOpen(false);
        });

        previewRows.forEach((row) => {
          row.addEventListener("click", () =>
            openWorkspace(row.dataset.conversation),
          );
        });

        conversationRows.forEach((row) => {
          row.addEventListener("click", () => {
            setActiveConversation(row.dataset.conversation);
            showThreadPane();
          });
        });

        openAllButtons.forEach((button) =>
          button?.addEventListener("click", () => openWorkspace()),
        );
        closeWorkspace.addEventListener("click", closeWorkspacePanel);

        workspace.addEventListener("click", (event) => {
          if (event.target === workspace) closeWorkspacePanel();
        });

        function sendMessage() {
          const value = input.value.trim();
          if (!value) return;
          conversations[activeConversation].messages.push({
            side: "me",
            text: value,
            time: "Just now",
          });
          input.value = "";
          renderThread();
        }

        sendButton.addEventListener("click", sendMessage);
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
          }
        });

        conversationSearch.addEventListener("input", (event) => {
          const query = event.target.value.toLowerCase().trim();
          conversationRows.forEach((row) => {
            const title = row.textContent.toLowerCase();
            row.classList.toggle("hidden", query && !title.includes(query));
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setDropdownOpen(false);
            closeWorkspacePanel();
          }
        });

        renderThread();
      })();
    </script>

    <script src="/js/main.js"></script>
  </body>
</html>
