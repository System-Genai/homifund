                class="relative hover:bg-surface-container-low p-2 rounded-full transition-colors"
                aria-label="Messages"
                aria-expanded="false"
                aria-controls="messages-dropdown"
              >
                <span class="material-symbols-outlined" data-icon="chat_bubble"
                  >chat_bubble</span
                >
                <span
                  class="absolute top-2 right-2 w-2 h-2 bg-primary rounded-full border border-surface"
                ></span>
              </button>

              <div
