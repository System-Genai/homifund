                    <div
                      class="w-10 h-10 rounded-full bg-secondary-container text-primary flex items-center justify-center shrink-0 font-bold text-xs"
                    >
                      TS
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between gap-3">
                        <p
                          class="text-sm font-semibold text-on-surface truncate"
