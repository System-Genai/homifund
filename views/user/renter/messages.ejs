                    Open messages
                  </button>
                </div>

                <div class="divide-y divide-outline-variant">
                  <button
                    class="message-preview w-full text-left flex gap-3 px-5 py-4 hover:bg-surface-container-low transition-colors"
                    data-conversation="sapphire"
