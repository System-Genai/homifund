                    class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                  >
                    Rental history
                  </p>
                  <p class="text-label-sm font-bold text-on-surface mt-0.5">
                    Reference confirmed
                  </p>
                </div>
              </section>
            </div>
            <div class="lg:col-span-4 flex items-center justify-end">
              <button
                class="text-primary text-label-sm font-bold hover:underline"
              >
                Manage application profile
              </button>
            </div>
          </section>
        </div>
      </section>
    </main>

    <script>
      // Micro-interaction for sidebar hover states
      document.querySelectorAll("aside nav a").forEach((item) => {
        item.addEventListener("mouseenter", () => {
          if (!item.classList.contains("bg-secondary-container")) {
            item.style.transform = "translateX(4px)";
          }
        });
        item.addEventListener("mouseleave", () => {
          item.style.transform = "translateX(0px)";
        });
      });

      // Simple form interaction simulation
      const switches = document.querySelectorAll('input[type="checkbox"]');
      switches.forEach((sw) => {
        sw.addEventListener("change", (e) => {
          const parent = e.target.closest("div");
          if (e.target.checked) {
            parent.classList.add("border-primary/30");
            parent.classList.remove("border-white");
          } else {
            parent.classList.remove("border-primary/30");
            parent.classList.add("border-white");
          }
        });
      });
    </script>
    <script src="/js/main.js"></script>
  </body>
</html>
