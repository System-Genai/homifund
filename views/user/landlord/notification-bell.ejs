<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const notificationUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = notificationUser.fullName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications" aria-current="page"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Account updates</p>
            <h1 class="text-headline-lg font-bold text-primary">Notifications</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review notification availability and the controls needed for trustworthy account updates.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-6 font-bold text-primary hover:bg-surface-container-lowest" href="/user/landlord/settings"><span class="material-symbols-outlined text-xl" aria-hidden="true">settings</span>Notification settings</a>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="notification-service-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">notifications_off</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Service unavailable</p>
                <h2 id="notification-service-status-title" class="mt-1 text-headline-md font-bold text-primary">Notifications are not connected</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">No application event, inbox record, unread state, preference, or delivery channel is connected. This page will not create alerts from sample data.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 notifications</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="notification-list-title">
              <div class="mb-4">
                <h2 id="notification-list-title" class="text-headline-md font-bold text-on-surface">Notification inbox</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Unread filters, mark-as-read, linked actions, and delivery history require persisted notification records.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">notifications_none</span>
                <h3 class="mt-3 font-bold text-on-surface">No notifications</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">No application, viewing, document, payment, message, or account event is available to display.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-low" href="/user/landlord/dashboard"><span class="material-symbols-outlined text-xl" aria-hidden="true">dashboard</span>Return to dashboard</a>
              </div>
            </section>

            <section aria-labelledby="notification-controls-title">
              <div class="mb-4">
                <h2 id="notification-controls-title" class="text-headline-md font-bold text-on-surface">Required notification controls</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Every alert should be traceable to a real event and a user-owned delivery preference.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">event</span><h3 class="mt-3 font-bold text-on-surface">Authoritative events</h3><p class="mt-2 text-body-sm text-on-surface-variant">Notification creation must reference a real record, event type, actor, recipient, and safe destination.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">inbox</span><h3 class="mt-3 font-bold text-on-surface">Persisted inbox state</h3><p class="mt-2 text-body-sm text-on-surface-variant">Created, delivered, read, archived, and failed states need server ownership and idempotent updates.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">tune</span><h3 class="mt-3 font-bold text-on-surface">Preferences and channels</h3><p class="mt-2 text-body-sm text-on-surface-variant">Users need category-level in-app and email preferences, mandatory-service rules, and verified destinations.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">link</span><h3 class="mt-3 font-bold text-on-surface">Safe linked actions</h3><p class="mt-2 text-body-sm text-on-surface-variant">Each action must authorize the destination again and remain useful after the notification is read.</p></article>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Notification guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="notification-quality-title">
              <h2 id="notification-quality-title" class="text-headline-md font-bold text-primary">Notification quality</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Do not show unread dots without persisted unread records.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Use clear event language without false urgency.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Avoid sensitive personal or financial detail in previews.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Keep notification delivery separate from the source record.</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="notification-actions-title">
              <h2 id="notification-actions-title" class="text-headline-md font-bold text-primary">Notification actions</h2>
              <dl class="mt-4 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Mark as read</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Archive or delete</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Category filters</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Email delivery</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
              </dl>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Notification help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/settings"><span>Settings</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/support"><span>Notification support</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
