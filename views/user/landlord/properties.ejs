<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const landlordProfile = typeof profile === 'object' && profile ? profile : {}; %>
    <% const propertyUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = propertyUser.fullName || landlordProfile.legalName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Portfolio workspace</p>
            <h1 class="text-headline-lg font-bold text-primary">Properties</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review saved property records and open the guided listing setup.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-6 font-bold text-on-primary hover:bg-primary-container" href="/user/landlord/properties/add/address"><span class="material-symbols-outlined text-xl" aria-hidden="true">add_home</span>Open property setup</a>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="property-record-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">home_work</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Saved records</p>
                <h2 id="property-record-status-title" class="mt-1 text-headline-md font-bold text-primary">No properties saved</h2>
                <p class="mt-2 max-w-2xl text-body-sm text-on-surface-variant">This build does not have a persisted Property model, so onboarding estimates and setup-page entries are not treated as saved listings.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 operational records</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="property-list-title">
              <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <h2 id="property-list-title" class="text-headline-md font-bold text-on-surface">Property records</h2>
                  <p class="mt-1 text-body-sm text-on-surface-variant">Search, filters, bulk actions, and exports will become useful after records can be stored.</p>
                </div>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">holiday_village</span>
                <h3 class="mt-3 font-bold text-on-surface">Your property list is empty</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">The guided setup can be reviewed, but entries are not published or retained as operational records in the current application.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-low" href="/user/landlord/properties/add/address"><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>Review setup steps</a>
              </div>
            </section>

            <section aria-labelledby="setup-stages-title">
              <div class="mb-4">
                <h2 id="setup-stages-title" class="text-headline-md font-bold text-on-surface">Property setup stages</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">The existing guided pages are organized into these five steps.</p>
              </div>
              <ol class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest" role="list">
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-on-primary">1</span><div><h3 class="font-bold text-on-surface">Address and property type</h3><p class="mt-1 text-body-sm text-on-surface-variant">Identify the property and basic building category.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">2</span><div><h3 class="font-bold text-on-surface">Listing details</h3><p class="mt-1 text-body-sm text-on-surface-variant">Describe the home, rooms, features, and access details.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">3</span><div><h3 class="font-bold text-on-surface">Photos and documents</h3><p class="mt-1 text-body-sm text-on-surface-variant">Review the media and evidence the listing may eventually require.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">4</span><div><h3 class="font-bold text-on-surface">Rent and availability</h3><p class="mt-1 text-body-sm text-on-surface-variant">Set proposed rent, availability, tenancy, and viewing information.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">5</span><div><h3 class="font-bold text-on-surface">Review</h3><p class="mt-1 text-body-sm text-on-surface-variant">Check the draft before any future save or publication service is enabled.</p></div></li>
              </ol>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Property workspace information">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="portfolio-context-title">
              <p class="text-label-sm font-bold uppercase text-secondary">Saved onboarding</p>
              <h2 id="portfolio-context-title" class="mt-1 text-headline-md font-bold text-primary">Portfolio context</h2>
              <dl class="mt-5 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Property estimate</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.propertyCount === 0 || landlordProfile.propertyCount ? landlordProfile.propertyCount + ' properties' : 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Locations</dt><dd class="max-w-[60%] text-right font-bold text-on-surface"><%= landlordProfile.primaryLocations || 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Management</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.managementStyle ? landlordProfile.managementStyle.replace('-', ' ') : 'Not set' %></dd></div>
              </dl>
              <p class="mt-4 text-body-sm text-on-surface-variant">This is self-reported setup context, not a count of saved listings.</p>
              <a class="mt-4 inline-flex min-h-11 items-center font-bold text-primary hover:underline" href="/onboarding-landlord">Update portfolio context</a>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="property-boundaries-title">
              <h2 id="property-boundaries-title" class="text-headline-md font-bold text-primary">Current boundaries</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>Setup pages do not currently save a property record.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>No listing is published to renters from this workspace.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>No valuation, occupancy, revenue, or map data is inferred.</span></li>
              </ul>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Property help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/dashboard"><span>Dashboard</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/support"><span>Property support</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
