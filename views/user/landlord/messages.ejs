<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const messageUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = messageUser.fullName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages" aria-current="page"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Communication workspace</p>
            <h1 class="text-headline-lg font-bold text-primary">Messages</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review messaging availability and the controls required for account-to-account communication.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-6 font-bold text-primary hover:bg-surface-container-lowest" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">support_agent</span>Message support</a>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="messaging-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">forum</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Service unavailable</p>
                <h2 id="messaging-status-title" class="mt-1 text-headline-md font-bold text-primary">Messaging is not connected</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">No conversation, participant, delivery, or read-status records exist. Do not send identity documents, banking details, passwords, or other sensitive information through Contact while messaging is unavailable.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 conversations</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="conversation-list-title">
              <div class="mb-4">
                <h2 id="conversation-list-title" class="text-headline-md font-bold text-on-surface">Conversations</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Search, unread filters, threads, composing, attachments, and read receipts require persisted authorized conversations.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">chat_bubble_outline</span>
                <h3 class="mt-3 font-bold text-on-surface">No conversations</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">No renter, applicant, property manager, or support thread is created by the current application.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-low" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">help</span>Open support</a>
              </div>
            </section>

            <section aria-labelledby="messaging-controls-title">
              <div class="mb-4">
                <h2 id="messaging-controls-title" class="text-headline-md font-bold text-on-surface">Required messaging controls</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Communication should be bound to real accounts and records, not client-only sample content.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">group</span><h3 class="mt-3 font-bold text-on-surface">Authorized participants</h3><p class="mt-2 text-body-sm text-on-surface-variant">Every thread must identify participants, related property/application context, role permissions, and membership history.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">send</span><h3 class="mt-3 font-bold text-on-surface">Durable delivery</h3><p class="mt-2 text-body-sm text-on-surface-variant">Messages need server timestamps, delivery states, idempotency, ordering, retries, and explicit failure recovery.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">report</span><h3 class="mt-3 font-bold text-on-surface">Safety and reporting</h3><p class="mt-2 text-body-sm text-on-surface-variant">Blocking, reporting, moderation escalation, rate limits, and abuse evidence need clear user feedback.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">policy</span><h3 class="mt-3 font-bold text-on-surface">Retention and attachments</h3><p class="mt-2 text-body-sm text-on-surface-variant">Retention, deletion, exports, attachment scanning, access revocation, and audit history need defined ownership.</p></article>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Messaging guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="communication-safety-title">
              <h2 id="communication-safety-title" class="text-headline-md font-bold text-primary">Communication safety</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Keep applicant and tenancy discussions within authorized participants.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Never request passwords, raw card details, or login codes.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Use an approved document service for sensitive evidence.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Keep notification delivery separate from message persistence.</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="messaging-actions-title">
              <h2 id="messaging-actions-title" class="text-headline-md font-bold text-primary">Messaging actions</h2>
              <dl class="mt-4 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">New conversation</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Send message</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Attachments</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Search and unread</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
              </dl>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Messaging help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/applicants"><span>Applicants</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/properties"><span>Properties</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
