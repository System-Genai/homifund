    <script>
      (() => {
        const menu = document.getElementById("landlord-messages-menu");
        const toggle = document.getElementById("landlord-messages-toggle");
        const dropdown = document.getElementById("landlord-messages-dropdown");
        const workspace = document.getElementById(
          "landlord-messages-workspace",
        );
        const closeWorkspace = document.getElementById(
          "close-landlord-messages-workspace",
        );
        const conversationRows = [
          ...document.querySelectorAll(".landlord-conversation-row"),
        ];
        const previewRows = [
          ...document.querySelectorAll(".landlord-message-preview"),
        ];
        const openAllButtons = [
          document.getElementById("landlord-open-all-messages"),
          document.getElementById("landlord-open-all-messages-bottom"),
        ];
        const activeAvatar = document.getElementById("landlord-active-avatar");
        const activeTitle = document.getElementById("landlord-active-title");
        const activeSubtitle = document.getElementById(
          "landlord-active-subtitle",
        );
        const thread = document.getElementById("landlord-message-thread");
        const input = document.getElementById("landlord-message-input");
        const sendButton = document.getElementById("landlord-send-message");
        const conversationSearch = document.getElementById(
          "landlord-conversation-search",
        );

        const conversations = {
          james: {
            initials: "JC",
            title: "James Carter",
            subtitle: "Applicant · Canary Wharf Suite",
            messages: [
              {
                side: "me",
                text: "Hello James, thank you for your application for Canary Wharf Suite.",
                time: "Today, 09:52",
              },
              {
                side: "them",
                text: "Thank you. I can attend the viewing tomorrow.",
                time: "Today, 10:01",
              },
              {
                side: "me",
                text: "Great. The viewing is confirmed for tomorrow at 2:00 PM.",
                time: "Now",
              },
            ],
          },
          elena: {
            initials: "ER",
            title: "Elena Rossi",
            subtitle: "Applicant · Shoreditch Warehouse Loft",
            messages: [
              {
                side: "me",
                text: "Thank you for your application for Shoreditch Warehouse Loft.",
                time: "Yesterday, 14:18",
              },
              {
                side: "them",
                text: "I have uploaded the requested application document.",
                time: "Yesterday, 14:34",
              },
              {
                side: "me",
                text: "Thanks. We will review it alongside the rest of your application.",
                time: "Yesterday, 14:45",
              },
            ],
          },
          agent: {
            initials: "LA",
            title: "Lettings agent",
            subtitle: "Portfolio updates and viewing requests",
            messages: [
              {
                side: "them",
                text: "A viewing request has been added to your calendar.",
                time: "Monday, 09:20",
              },
              {
                side: "me",
                text: "Thanks. Please confirm the prospective renter has received the viewing details.",
                time: "Monday, 09:26",
              },
              {
                side: "them",
                text: "Confirmed. The renter has been notified through HomiFund.",
                time: "Monday, 09:32",
              },
            ],
          },
        };

        let activeConversation = "james";

        function setDropdownOpen(open) {
          dropdown.classList.toggle("hidden", !open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.classList.toggle("bg-secondary-container", open);
          toggle.classList.toggle("text-primary", open);
        }


        // --- responsive master/detail (mobile shows one pane at a time) ---
        const landlordlistPane = document.getElementById("landlord-conversation-pane");
        const landlordthreadPane = document.getElementById("landlord-thread-pane");
        const landlordbackBtn = document.getElementById("landlord-thread-back");
        const isMobilePane = () => window.matchMedia("(max-width: 767px)").matches;
        function showThreadPane() {
          if (!isMobilePane()) return;
          landlordlistPane?.classList.add("hidden");
          landlordthreadPane?.classList.remove("hidden");
          landlordthreadPane?.classList.add("flex");
        }
        function showListPane() {
          if (!isMobilePane()) return;
          landlordlistPane?.classList.remove("hidden");
          landlordthreadPane?.classList.add("hidden");
          landlordthreadPane?.classList.remove("flex");
        }
        landlordbackBtn?.addEventListener("click", showListPane);
        window.addEventListener("resize", () => {
          if (!isMobilePane()) {
            landlordlistPane?.classList.remove("hidden");
            landlordthreadPane?.classList.remove("hidden");
            landlordthreadPane?.classList.add("flex");
          } else {
            showListPane();
          }
        });

        function renderThread() {
          const conversation = conversations[activeConversation];
          activeAvatar.textContent = conversation.initials;
          activeTitle.textContent = conversation.title;
          activeSubtitle.textContent = conversation.subtitle;
          thread.innerHTML = conversation.messages
            .map((message) => {
              const own = message.side === "me";
              return `<div class="flex ${own ? "justify-end" : "justify-start"}">
        <div class="max-w-[75%]">
          <div class="${own ? "bg-primary text-white" : "bg-surface-container-lowest border border-outline-variant text-on-surface"} rounded-xl px-4 py-3 text-sm">
            ${message.text}
          </div>
          <p class="text-[11px] text-on-surface-variant mt-1 ${own ? "text-right" : ""}">${message.time}</p>
        </div>
      </div>`;
            })
            .join("");
          thread.scrollTop = thread.scrollHeight;
        }

        function setActiveConversation(id) {
          activeConversation = id;
          conversationRows.forEach((row) => {
            const selected = row.dataset.conversation === id;
            row.classList.toggle("bg-secondary-container", selected);
            row.classList.toggle("hover:bg-surface-container-low", !selected);
            const title = row.querySelector("p.font-semibold");
            title?.classList.toggle("text-primary", selected);
            title?.classList.toggle("text-on-surface", !selected);
          });
          renderThread();
        }

        function openWorkspace(id = activeConversation) {
          setDropdownOpen(false);
          workspace.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
          setActiveConversation(id);
          if (isMobilePane()) showListPane();
          setTimeout(() => {
            if (!isMobilePane()) input.focus();
          }, 60);
        }

        function closeWorkspacePanel() {
          workspace.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
        }

        toggle.addEventListener("click", (event) => {
          event.stopPropagation();
          setDropdownOpen(dropdown.classList.contains("hidden"));
        });

        document.addEventListener("click", (event) => {
          if (!menu.contains(event.target)) setDropdownOpen(false);
        });

        previewRows.forEach((row) =>
          row.addEventListener("click", () =>
            openWorkspace(row.dataset.conversation),
          ),
        );
        conversationRows.forEach((row) =>
          row.addEventListener("click", () => {
            setActiveConversation(row.dataset.conversation);
            showThreadPane();
          }),
        );
        openAllButtons.forEach((button) =>
          button?.addEventListener("click", () => openWorkspace()),
        );
        closeWorkspace.addEventListener("click", closeWorkspacePanel);

        workspace.addEventListener("click", (event) => {
          if (event.target === workspace) closeWorkspacePanel();
        });

        function sendMessage() {
          const value = input.value.trim();
          if (!value) return;
          conversations[activeConversation].messages.push({
            side: "me",
            text: value,
            time: "Just now",
          });
          input.value = "";
          renderThread();
        }

        sendButton.addEventListener("click", sendMessage);
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
          }
        });

        conversationSearch.addEventListener("input", (event) => {
          const query = event.target.value.toLowerCase().trim();
          conversationRows.forEach((row) => {
            row.classList.toggle(
              "hidden",
              query && !row.textContent.toLowerCase().includes(query),
            );
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setDropdownOpen(false);
            closeWorkspacePanel();
          }
        });

        renderThread();
      })();
    </script>

    <script src="/js/main.js"></script>
  </body>
</html>
