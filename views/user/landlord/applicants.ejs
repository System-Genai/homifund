                      <button
                        class="px-2.5 py-2 rounded-lg border border-primary text-primary text-label-sm font-bold hover:bg-primary hover:text-on-primary transition-colors"
                        onclick="window.location.href = 'review-application'"
                      >
                        Review application
                      </button>
                    </td>
                  </tr>

                  <tr
                    class="hover:bg-surface-container-low/60 transition-colors"
                  >
                    <td class="px-3 py-4">
                      <div class="flex items-center gap-2.5">
                        <img
                          class="w-10 h-10 rounded-full object-cover border border-outline-variant/60"
                          alt="Marcus Chen"
                          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCxumPJ6siWAvQrEtQ13TveiaF_9EoZKk2_el9vQ-EHLXkCBGiKfj_TqTbVOWN_dM3Qbk1g-C6TJ3SyRN_Iw5_xeO2EfJNO3VyVr1X5evCKejnaCNyIwQZiEPOqmdgDWrv-0L6R43kzaTmUnKy6RZWZSEWGYdBj-YZZtZi_Cy7aEZRMOeO288Xx0ugf5JxNqod7CEBl7HcECgPp4m3d79e-fF3ZaUkcWoEoU7nrvPV9oEssQEusPE72-g"
                        />
                        <div>
                          <p class="text-label-md font-bold text-on-surface">
                            Marcus Chen
                          </p>
                          <p
                            class="text-label-sm text-on-surface-variant mt-0.5"
                          >
                            Applied 5 hours ago
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-md text-on-surface">Hudson Lofts</p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Shoreditch
                      </p>
                    </td>
                    <td class="px-3 py-4 text-center">
                      <span class="text-label-md font-bold text-on-surface"
                        >792</span
                      >
                      <div
                        class="mx-auto mt-1 h-1 w-12 bg-surface-container-high rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full w-[79%] bg-secondary rounded-full"
                        ></div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm font-bold text-on-surface">
                        Verified
                      </p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Within budget
                      </p>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm text-on-surface">15 Oct</p>
                    </td>
                    <td class="px-3 py-4">
                      <span
                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant text-[10px] uppercase font-bold tracking-wide"
                        ><span class="material-symbols-outlined text-[14px]"
                          >pending</span
                        >Needs review</span
                      >
                    </td>
                    <td class="px-3 py-4 text-right">
                      <button
                        class="px-2.5 py-2 rounded-lg border border-primary text-primary text-label-sm font-bold hover:bg-primary hover:text-on-primary transition-colors"
                        onclick="window.location.href = 'review-application'"
                      >
                        Review application
                      </button>
                    </td>
                  </tr>

                  <tr
                    class="hover:bg-surface-container-low/60 transition-colors"
                  >
                    <td class="px-3 py-4">
                      <div class="flex items-center gap-2.5">
                        <img
                          class="w-10 h-10 rounded-full object-cover border border-outline-variant/60"
                          alt="Elena Rodriguez"
                          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTD_SLdhhxXl1kaOXnlt_whOCv2U4uzr-Ah9zsokRGLUCFxAuF6k5caB7YGRmi4PGi9cS9mT821u1rChjOoF7Ux1qiReev81y3R87OiZN-NXqP4Uck5i8O3DnzcY_1pv-X_qeyvGXZg-s3BzLf0AAxgm4neN6pwRnSlqEp8OoHTuGTdeGm-NoBnwqYM9W_EwU8WZGD_9QxMebLqb3BuPKonEFRBXKC9WSsskNyXryZceyc2v_yyGvGxg"
                        />
                        <div>
                          <p class="text-label-md font-bold text-on-surface">
                            Elena Rodriguez
                          </p>
                          <p
                            class="text-label-sm text-on-surface-variant mt-0.5"
                          >
                            Applied yesterday
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-md text-on-surface">
                        The Glass House
                      </p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Canary Wharf
                      </p>
                    </td>
                    <td class="px-3 py-4 text-center">
                      <span class="text-label-md font-bold text-primary"
                        >912</span
                      >
                      <div
                        class="mx-auto mt-1 h-1 w-12 bg-surface-container-high rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full w-[91%] bg-primary rounded-full"
                        ></div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm font-bold text-on-surface">
                        Verified
                      </p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Strong rent fit
                      </p>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm text-on-surface">Now</p>
                    </td>
                    <td class="px-3 py-4">
                      <span
                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-primary text-[10px] uppercase font-bold tracking-wide"
                        ><span
                          class="material-symbols-outlined text-[14px]"
                          style="font-variation-settings: &quot;FILL&quot; 1"
                          >check_circle</span
                        >Shortlisted</span
                      >
                    </td>
                    <td class="px-3 py-4 text-right">
                      <button
                        class="px-2.5 py-2 rounded-lg border border-primary text-primary text-label-sm font-bold hover:bg-primary hover:text-on-primary transition-colors"
                        onclick="window.location.href = 'review-application'"
                      >
                        Review application
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div
              class="px-3 py-4 border-t border-outline-variant/70 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
            >
              <p class="text-label-sm text-on-surface-variant">
                Showing 1–10 of 37 applications
              </p>
              <div class="flex items-center gap-2">
                <button
                  class="w-8 h-8 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_left</span
                  >
                </button>
                <button
                  class="w-8 h-8 rounded-lg bg-secondary-container text-primary text-label-sm font-bold"
                >
                  1
                </button>
                <button
                  class="w-8 h-8 rounded-lg text-on-surface-variant hover:bg-surface-container-low text-label-sm font-bold"
                >
                  2
                </button>
                <button
                  class="w-8 h-8 rounded-lg text-on-surface-variant hover:bg-surface-container-low text-label-sm font-bold"
                >
                  3
                </button>
                <button
                  class="w-8 h-8 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_right</span
                  >
                </button>
              </div>
            </div>
          </section>
        </div>
      </section>
    </main>

    <script>
      document.querySelectorAll("aside nav a").forEach((item) => {
        item.addEventListener("mouseenter", () => {
          if (!item.classList.contains("bg-secondary-container"))
            item.style.transform = "translateX(4px)";
        });
        item.addEventListener(
          "mouseleave",
          () => (item.style.transform = "translateX(0px)"),
        );
      });
    </script>
    <script src="/js/main.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
