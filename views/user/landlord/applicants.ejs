                            Sarah Mitchell
                          </p>
                          <p
                            class="text-label-sm text-on-surface-variant mt-0.5"
                          >
                            Applied 2 days ago
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-md text-on-surface">
                        The Glass House
                      </p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Canary Wharf
                      </p>
                    </td>
                    <td class="px-3 py-4 text-center">
                      <span class="text-label-md font-bold text-primary"
                        >865</span
                      >
                      <div
                        class="mx-auto mt-1 h-1 w-12 bg-surface-container-high rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full w-[86%] bg-primary rounded-full"
                        ></div>
                      </div>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm font-bold text-on-surface">
                        Verified
                      </p>
                      <p class="text-label-sm text-on-surface-variant mt-0.5">
                        Strong rent fit
                      </p>
                    </td>
                    <td class="px-3 py-4">
                      <p class="text-label-sm text-on-surface">1 Oct</p>
                    </td>
                    <td class="px-3 py-4">
                      <span
                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-fixed/60 text-primary text-[10px] uppercase font-bold tracking-wide"
                        ><span
                          class="material-symbols-outlined text-[14px]"
                          style="font-variation-settings: &quot;FILL&quot; 1"
