<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const applicantUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = applicantUser.fullName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Application workspace</p>
            <h1 class="text-headline-lg font-bold text-primary">Applicants</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review applications connected to saved property listings.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-6 font-bold text-primary hover:bg-surface-container-lowest" href="/user/landlord/properties"><span class="material-symbols-outlined text-xl" aria-hidden="true">home_work</span>Open properties</a>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="application-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">assignment</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Saved records</p>
                <h2 id="application-status-title" class="mt-1 text-headline-md font-bold text-primary">No applications received</h2>
                <p class="mt-2 max-w-2xl text-body-sm text-on-surface-variant">This build has no persisted application records or renter-submission workflow. No applicant identity, score, affordability, or status is inferred.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 applicant records</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="applicant-records-title">
              <div class="mb-4">
                <h2 id="applicant-records-title" class="text-headline-md font-bold text-on-surface">Applicant records</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Search, filters, comparison, decisions, and export remain unavailable until applications can be submitted and stored.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">group</span>
                <h3 class="mt-3 font-bold text-on-surface">No applicants to review</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">Applicant rows will appear only when a saved listing and an application-submission service are connected.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-primary px-5 font-bold text-on-primary hover:bg-primary-container" href="/user/landlord/properties/add/address"><span class="material-symbols-outlined text-xl" aria-hidden="true">add_home</span>Review property setup</a>
              </div>
            </section>

            <section aria-labelledby="application-foundations-title">
              <div class="mb-4">
                <h2 id="application-foundations-title" class="text-headline-md font-bold text-on-surface">Required application foundations</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">These services need clear ownership before review actions are enabled.</p>
              </div>
              <ol class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest" role="list">
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-on-primary">1</span><div><h3 class="font-bold text-on-surface">Saved listing</h3><p class="mt-1 text-body-sm text-on-surface-variant">Every application must reference a persisted property and published listing state.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">2</span><div><h3 class="font-bold text-on-surface">Consent-based submission</h3><p class="mt-1 text-body-sm text-on-surface-variant">Renters need to know which details and documents are requested, why they are needed, and who can access them.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">3</span><div><h3 class="font-bold text-on-surface">Accountable review</h3><p class="mt-1 text-body-sm text-on-surface-variant">Shortlist, decline, and comparison actions need audit history, reasons, status notifications, and correction paths.</p></div></li>
              </ol>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Applicant review guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="fair-review-title">
              <h2 id="fair-review-title" class="text-headline-md font-bold text-primary">Fair review</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Use only relevant information supplied with clear notice and consent.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Treat HomiScore as supporting context, never the sole decision factor.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Do not infer or rank applicants by protected characteristics.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Keep decisions explainable and communicate application status.</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="review-actions-title">
              <h2 id="review-actions-title" class="text-headline-md font-bold text-primary">Review actions</h2>
              <dl class="mt-4 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Compare applicants</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Shortlist or decline</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Export applications</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
              </dl>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Application help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/properties"><span>Properties</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/support"><span>Application support</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
