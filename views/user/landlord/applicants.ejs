                      >37</span
                    >
                  </button>
                  <button
                    class="px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-low text-label-sm font-bold"
                  >
                    Needs review
                  </button>
                  <button
                    class="px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-low text-label-sm font-bold"
                  >
                    Viewings
                  </button>
                  <button
                    class="px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-low text-label-sm font-bold"
                  >
                    Shortlisted
