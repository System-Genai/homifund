              >
                <div>
                  <h3 class="text-headline-md text-on-surface">
                    Applicant pipeline
                  </h3>
                  <p class="text-label-sm text-on-surface-variant mt-1">
                    Compare renter readiness, then review the full application.
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <button
                    class="px-3 py-2 rounded-lg bg-secondary-container text-primary text-label-sm font-bold"
                  >
                    All
