                    <th class="px-3 py-3 font-bold">Affordability</th>
                    <th class="px-3 py-3 font-bold">Move-in</th>
                    <th class="px-3 py-3 font-bold">Status</th>
                    <th class="px-3 py-3 font-bold text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/50">
                  <tr
                    class="hover:bg-surface-container-low/60 transition-colors"
