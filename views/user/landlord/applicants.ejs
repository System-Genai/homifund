              >
            </div>
            <div
              class="bg-surface-container-lowest rounded-xl border border-outline-variant/70 px-3 py-4 flex items-center justify-between"
            >
              <div>
                <p
                  class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                >
                  Needs review
                </p>
                <p class="text-headline-md text-on-surface mt-1">12</p>
                <p class="text-label-sm text-error mt-1">3 received today</p>
              </div>
              <span class="material-symbols-outlined text-error text-[24px]"
                >priority_high</span
              >
            </div>
            <div
              class="bg-surface-container-lowest rounded-xl border border-outline-variant/70 px-3 py-4 flex items-center justify-between"
            >
              <div>
                <p
                  class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                >
                  Portfolio Trust
                </p>
                <p class="text-headline-md text-on-surface mt-1">94%</p>
                <p class="text-label-sm text-on-surface-variant mt-1">
