<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const documentUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = documentUser.fullName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Record workspace</p>
            <h1 class="text-headline-lg font-bold text-primary">Documents</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review document availability and the safeguards required before private files can be stored.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-6 font-bold text-primary hover:bg-surface-container-lowest" href="/landlord-verification"><span class="material-symbols-outlined text-xl" aria-hidden="true">fact_check</span>Review requirements</a>
        </div>

        <section class="mb-8 border-y border-error/40 bg-error-container/30 px-5 py-6 sm:px-6" aria-labelledby="document-storage-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-error text-on-error" aria-hidden="true">lock</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-error">Storage unavailable</p>
                <h2 id="document-storage-status-title" class="mt-1 text-headline-md font-bold text-on-surface">Secure document storage is not configured</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">Do not upload or send identity, ownership, tenancy, banking, or compliance documents through Contact or Messages. No private file-storage service is connected to this application.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 stored documents</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="document-records-title">
              <div class="mb-4">
                <h2 id="document-records-title" class="text-headline-md font-bold text-on-surface">Document records</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Search, category filters, expiry tracking, downloads, and sharing require persisted private records.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">folder_off</span>
                <h3 class="mt-3 font-bold text-on-surface">No documents stored</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">This workspace will remain read-only until secure upload, storage, access, retention, and deletion services are implemented.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-low" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">help</span>Document support</a>
              </div>
            </section>

            <section aria-labelledby="storage-controls-title">
              <div class="mb-4">
                <h2 id="storage-controls-title" class="text-headline-md font-bold text-on-surface">Required storage controls</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Each control must be implemented and tested before file upload is enabled.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">encrypted</span><h3 class="mt-3 font-bold text-on-surface">Private storage and access</h3><p class="mt-2 text-body-sm text-on-surface-variant">Tenant-scoped storage, encryption, least-privilege access, and auditable authorization are required.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">shield</span><h3 class="mt-3 font-bold text-on-surface">File safety</h3><p class="mt-2 text-body-sm text-on-surface-variant">Type, size, content, and malware checks must complete before any file becomes available.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">event_busy</span><h3 class="mt-3 font-bold text-on-surface">Retention and deletion</h3><p class="mt-2 text-body-sm text-on-surface-variant">Every category needs a documented retention period, owner-controlled deletion, and recovery policy.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">manage_accounts</span><h3 class="mt-3 font-bold text-on-surface">Consent and sharing</h3><p class="mt-2 text-body-sm text-on-surface-variant">Sharing needs recipient scope, purpose, expiry, revocation, download history, and clear consent.</p></article>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Document workspace guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="prepare-offline-title">
              <h2 id="prepare-offline-title" class="text-headline-md font-bold text-primary">Prepare offline</h2>
              <p class="mt-2 text-body-sm text-on-surface-variant">Keep required files in a storage location you control until HomiFund provides an approved upload process.</p>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">description</span><span>Identity and address evidence</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">description</span><span>Ownership or management authority</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">description</span><span>Property safety and compliance records</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">description</span><span>Tenancy records with appropriate access</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="document-actions-title">
              <h2 id="document-actions-title" class="text-headline-md font-bold text-primary">Document actions</h2>
              <dl class="mt-4 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Upload</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Download</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Share or revoke</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Expiry reminders</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
              </dl>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Document help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/landlord-verification"><span>Verification checklist</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/properties"><span>Properties</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
