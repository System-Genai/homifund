<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <%
      const profileUser = typeof currentUser === 'object' && currentUser ? currentUser : {};
      const landlordProfile = typeof profile === 'object' && profile ? profile : (profileUser.landlordProfile || {});
      const displayName = profileUser.fullName || 'Landlord';
      const humanizeProfileValue = (value) => value ? String(value).split('-').map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ') : 'Not provided';
      const propertyTypes = Array.isArray(landlordProfile.propertyTypes) && landlordProfile.propertyTypes.length
        ? landlordProfile.propertyTypes.map(humanizeProfileValue).join(', ')
        : 'Not provided';
    %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile" aria-current="page"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8">
          <p class="mb-1 text-label-md font-bold text-secondary">Account context</p>
          <h1 class="text-headline-lg font-bold text-primary">Landlord profile</h1>
          <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review the account identity and landlord onboarding details currently saved for this workspace.</p>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="profile-availability-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">badge</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Current capability</p>
                <h2 id="profile-availability-title" class="mt-1 text-headline-md font-bold text-primary">Saved account context is available</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">Account identity comes from sign-up and landlord details come from onboarding. Profile photo storage, direct account-field editing, public profile publishing, and sharing controls are not connected.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">Private account view</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="account-identity-title">
              <div class="mb-4">
                <h2 id="account-identity-title" class="text-headline-md font-bold text-on-surface">Account identity</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">These values belong to the authenticated HomiFund account.</p>
              </div>
              <dl class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest text-body-sm">
                <div class="flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between"><dt class="font-bold text-on-surface">Account name</dt><dd class="break-words text-on-surface-variant"><%= profileUser.fullName || 'Not available' %></dd></div>
                <div class="flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between"><dt class="font-bold text-on-surface">Email address</dt><dd class="break-all text-on-surface-variant"><%= profileUser.email || 'Not available' %></dd></div>
                <div class="flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between"><dt class="font-bold text-on-surface">Workspace role</dt><dd class="text-on-surface-variant">Landlord</dd></div>
              </dl>
            </section>

            <section aria-labelledby="landlord-details-title">
              <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <h2 id="landlord-details-title" class="text-headline-md font-bold text-on-surface">Saved landlord details</h2>
                  <p class="mt-1 text-body-sm text-on-surface-variant">Self-reported context from the landlord onboarding journey.</p>
                </div>
                <a class="inline-flex min-h-11 shrink-0 items-center gap-2 font-bold text-primary hover:underline" href="/onboarding-landlord"><span class="material-symbols-outlined text-xl" aria-hidden="true">edit</span>Update onboarding</a>
              </div>
              <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Legal or operating name</dt><dd class="mt-2 break-words font-bold text-on-surface"><%= landlordProfile.legalName || 'Not provided' %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Account type</dt><dd class="mt-2 font-bold text-on-surface"><%= humanizeProfileValue(landlordProfile.landlordType) %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Business name</dt><dd class="mt-2 break-words font-bold text-on-surface"><%= landlordProfile.businessName || 'Not provided' %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Portfolio estimate</dt><dd class="mt-2 font-bold text-on-surface"><%= Number.isFinite(Number(landlordProfile.propertyCount)) ? Number(landlordProfile.propertyCount).toLocaleString('en-GB') : 'Not provided' %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Primary locations</dt><dd class="mt-2 break-words font-bold text-on-surface"><%= landlordProfile.primaryLocations || 'Not provided' %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Property types</dt><dd class="mt-2 break-words font-bold text-on-surface"><%= propertyTypes %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Management model</dt><dd class="mt-2 font-bold text-on-surface"><%= humanizeProfileValue(landlordProfile.managementStyle) %></dd></div>
                <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><dt class="text-label-sm font-bold text-secondary">Primary goal</dt><dd class="mt-2 font-bold text-on-surface"><%= humanizeProfileValue(landlordProfile.primaryGoal) %></dd></div>
              </dl>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Profile guidance and actions">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="profile-actions-title">
              <h2 id="profile-actions-title" class="text-headline-md font-bold text-primary">Profile journeys</h2>
              <nav class="mt-4 divide-y divide-outline-variant" aria-label="Profile actions">
                <a class="flex min-h-12 items-center justify-between gap-4 py-3 font-bold text-primary hover:underline" href="/onboarding-landlord"><span>Update landlord details</span><span class="material-symbols-outlined shrink-0" aria-hidden="true">arrow_forward</span></a>
                <a class="flex min-h-12 items-center justify-between gap-4 py-3 font-bold text-primary hover:underline" href="/landlord-verification"><span>Review verification preparation</span><span class="material-symbols-outlined shrink-0" aria-hidden="true">arrow_forward</span></a>
                <a class="flex min-h-12 items-center justify-between gap-4 py-3 font-bold text-primary hover:underline" href="/user/landlord/settings"><span>Open account settings</span><span class="material-symbols-outlined shrink-0" aria-hidden="true">arrow_forward</span></a>
                <a class="flex min-h-12 items-center justify-between gap-4 py-3 font-bold text-primary hover:underline" href="/forget-password"><span>Reset password</span><span class="material-symbols-outlined shrink-0" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="profile-boundaries-title">
              <h2 id="profile-boundaries-title" class="text-headline-md font-bold text-primary">Current boundaries</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>No profile photo is uploaded or stored.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>This account context is not a published landlord profile.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span><span>Contact and sharing preferences are not inferred from onboarding.</span></li>
              </ul>
            </section>

            <section class="border-l-4 border-primary bg-surface-container-low px-5 py-4" aria-labelledby="profile-help-title">
              <h2 id="profile-help-title" class="font-bold text-on-surface">Need account help?</h2>
              <p class="mt-2 text-body-sm text-on-surface-variant">Use Support for product guidance or the Contact form for an account question. Do not send identity documents in the first message.</p>
              <a class="mt-3 inline-flex min-h-11 items-center gap-2 font-bold text-primary hover:underline" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">contact_support</span>Open support</a>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
