<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const paymentUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = paymentUser.fullName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Financial workspace</p>
            <h1 class="text-headline-lg font-bold text-primary">Payments</h1>
            <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review payment-service availability and the controls needed before rent or deposits can be recorded.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-6 font-bold text-primary hover:bg-surface-container-lowest" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">support_agent</span>Payment support</a>
        </div>

        <section class="mb-8 border-y border-error/40 bg-error-container/30 px-5 py-6 sm:px-6" aria-labelledby="payment-service-status-title">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-error text-on-error" aria-hidden="true">account_balance_wallet</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-error">Service unavailable</p>
                <h2 id="payment-service-status-title" class="mt-1 text-headline-md font-bold text-on-surface">Payments are not connected</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">Do not enter or send bank account, card, payment, or deposit information through Contact or Messages. No payment provider, ledger, payout account, or reconciliation service is connected.</p>
              </div>
            </div>
            <span class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-surface-container-high px-4 text-label-sm font-bold text-on-surface-variant">0 payment records</span>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="payment-records-title">
              <div class="mb-4">
                <h2 id="payment-records-title" class="text-headline-md font-bold text-on-surface">Payment records</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Totals, due dates, methods, statuses, receipts, filters, and exports require a persisted tenancy ledger.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-12 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">receipt_long</span>
                <h3 class="mt-3 font-bold text-on-surface">No payments recorded</h3>
                <p class="mx-auto mt-2 max-w-xl text-body-sm text-on-surface-variant">No expected, received, overdue, payout, refund, or deposit amount is calculated by the current application.</p>
                <a class="mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-low" href="/user/landlord/properties"><span class="material-symbols-outlined text-xl" aria-hidden="true">home_work</span>Open properties</a>
              </div>
            </section>

            <section aria-labelledby="payment-controls-title">
              <div class="mb-4">
                <h2 id="payment-controls-title" class="text-headline-md font-bold text-on-surface">Required payment controls</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">A financial workflow must be traceable from tenancy obligation to provider event and final ledger state.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">contract</span><h3 class="mt-3 font-bold text-on-surface">Tenancy obligations</h3><p class="mt-2 text-body-sm text-on-surface-variant">Each charge must reference a saved tenancy, payer, payee, amount, currency, due date, and revision history.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">sync</span><h3 class="mt-3 font-bold text-on-surface">Provider and reconciliation</h3><p class="mt-2 text-body-sm text-on-surface-variant">Signed webhooks, idempotency, settlement matching, retries, and exception handling must own status changes.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">account_balance</span><h3 class="mt-3 font-bold text-on-surface">Payout and account safety</h3><p class="mt-2 text-body-sm text-on-surface-variant">A regulated provider must handle account collection, verification, payout changes, and step-up confirmation.</p></article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5"><span class="material-symbols-outlined text-primary" aria-hidden="true">history</span><h3 class="mt-3 font-bold text-on-surface">Receipts and disputes</h3><p class="mt-2 text-body-sm text-on-surface-variant">Receipts, refunds, corrections, deposits, disputes, and audit history need explicit lifecycle states.</p></article>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Payment workspace guidance">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="payment-safety-title">
              <h2 id="payment-safety-title" class="text-headline-md font-bold text-primary">Financial safety</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Never collect raw card details in an application form.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Confirm payout-account changes through a protected provider flow.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Show pending, settled, failed, refunded, and disputed states distinctly.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>Keep money movement separate from notification delivery.</span></li>
              </ul>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="payment-actions-title">
              <h2 id="payment-actions-title" class="text-headline-md font-bold text-primary">Payment actions</h2>
              <dl class="mt-4 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Payment methods</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Payout settings</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Receipts and exports</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Payment reminders</dt><dd class="font-bold text-on-surface">Unavailable</dd></div>
              </dl>
              <nav class="mt-5 grid grid-cols-1 gap-2" aria-label="Payment help links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/properties"><span>Properties</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/support"><span>Payment support</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
