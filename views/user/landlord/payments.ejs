<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="bg-surface text-on-surface">
    <%- include('../partials/sidebar-landlord') %>

    <main class="md:ml-[240px] min-h-screen flex flex-col">
      <header
        class="sticky top-0 z-40 h-16 bg-surface flex justify-between items-center gap-3 pl-16 pr-4 sm:pr-6 md:pl-6 md:pr-6 lg:px-10 border-b border-outline-variant"
      >
        <div class="hidden sm:block relative w-full max-w-md">
          <span
            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant"
            >search</span
          ><input
            class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full text-sm"
            placeholder="Search payments, properties, applications..."
          />
        </div>
        <div class="flex items-center gap-1 sm:gap-3 lg:gap-6 ml-auto">
          <div class="flex items-center gap-0.5 sm:gap-2 lg:gap-4 text-on-surface-variant">
            <button>
              <span class="material-symbols-outlined"
                >notifications</span
              ></button
            ><button>
              <span class="material-symbols-outlined">settings</span></button
            ><button>
              <span class="material-symbols-outlined">chat_bubble</span>
            </button>
          </div>
          <div class="hidden sm:block h-8 w-px bg-outline-variant"></div>
          <div class="flex items-center gap-3">
            <div class="hidden lg:block text-right">
              <p class="text-sm font-bold">Alex S.</p>
              <p class="text-xs text-on-surface-variant">Landlord</p>
            </div>
            <div
              class="w-10 h-10 rounded-full bg-secondary-container text-primary flex items-center justify-center font-bold"
            >
              AS
            </div>
          </div>
        </div>
      </header>

      <section class="px-4 sm:px-6 lg:px-10 py-7">
        <div class="max-w-[1120px] mx-auto space-y-5">
          <div
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4"
          >
            <div>
              <p
                class="text-xs uppercase tracking-[.14em] text-on-surface-variant font-bold mb-1"
              >
                Rent and tenancy payments
              </p>
              <h2 class="text-3xl font-semibold text-primary">Payments</h2>
              <p class="text-sm text-on-surface-variant mt-2">
                Track rent received, upcoming payments and tenancy payment
                records in one place.
              </p>
            </div>
            <div class="flex gap-3">
              <button
                class="px-4 py-2.5 rounded-lg border border-outline-variant text-primary text-sm font-bold"
              >
                Payout settings</button
              ><button
                class="px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-bold flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >credit_card</span
                >Payment methods
              </button>
            </div>
          </div>

          <section class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div
              class="bg-surface-container-lowest border border-outline-variant rounded-xl px-4 py-3 flex items-center gap-3"
            >
              <span class="material-symbols-outlined text-primary"
                >calendar_month</span
              >
              <div>
                <p
                  class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                >
                  Expected this month
                </p>
                <p class="text-sm font-bold mt-0.5">£4,350</p>
                <p class="text-xs text-on-surface-variant">
                  Across 3 active tenancies
                </p>
              </div>
            </div>
            <div
              class="bg-surface-container-lowest border border-outline-variant rounded-xl px-4 py-3 flex items-center gap-3"
            >
              <span class="material-symbols-outlined text-primary"
                >receipt_long</span
              >
              <div>
                <p
                  class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                >
                  Received this month
                </p>
                <p class="text-sm font-bold mt-0.5">£2,900</p>
                <p class="text-xs text-on-surface-variant">
                  2 payments received
                </p>
              </div>
            </div>
            <div
              class="bg-surface-container-lowest border border-outline-variant rounded-xl px-4 py-3 flex items-center gap-3"
            >
              <span class="material-symbols-outlined text-[#b45309]"
                >warning</span
              >
              <div>
                <p
                  class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold"
                >
                  Needs attention
                </p>
                <p class="text-sm font-bold mt-0.5">1 payment overdue</p>
                <p class="text-xs text-[#b45309]">Hudson Lofts</p>
              </div>
            </div>
          </section>

          <section class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
            <div class="lg:col-span-8 space-y-4">
              <section
                class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden"
              >
                <div class="px-5 pt-4 border-b border-outline-variant">
                  <h3 class="text-sm font-bold">Rent payment activity</h3>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Review rent, deposit and tenancy payment records across your
                    properties.
                  </p>
                  <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                    <button
                      class="pb-3 text-xs font-bold text-primary border-b-2 border-primary"
                    >
                      All payments</button
                    ><button
                      class="pb-3 text-xs font-bold text-on-surface-variant"
                    >
                      Received</button
                    ><button
                      class="pb-3 text-xs font-bold text-on-surface-variant"
                    >
                      Scheduled</button
                    ><button
                      class="pb-3 text-xs font-bold text-on-surface-variant"
                    >
                      Overdue</button
                    ><button
                      class="pb-3 text-xs font-bold text-on-surface-variant"
                    >
                      Deposits
                    </button>
                  </div>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[900px] text-left">
                    <thead class="bg-surface-container-low">
                      <tr
                        class="text-[10px] uppercase tracking-wider text-on-surface-variant"
                      >
                        <th class="px-4 py-3">Tenant</th>
                        <th class="px-3 py-3">Property</th>
                        <th class="px-3 py-3">Payment</th>
                        <th class="px-3 py-3">Due date</th>
                        <th class="px-3 py-3">Amount</th>
                        <th class="px-3 py-3">Method</th>
                        <th class="px-3 py-3">Status</th>
                        <th class="px-4 py-3 text-right">Receipt</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/50 text-xs">
                      <tr>
                        <td class="px-4 py-3.5 font-bold">Sarah Mitchell</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          The Glass House
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Rent — July 2026
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          1 Jul 2026
                        </td>
                        <td class="px-3 py-3.5 font-bold">£1,450</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Direct Debit
                        </td>
                        <td class="px-3 py-3.5">
                          <span
                            class="inline-flex items-center gap-1 bg-secondary-container text-primary px-2 py-1 rounded-full text-[10px] font-bold"
                            ><span class="material-symbols-outlined text-[14px]"
                              >calendar_month</span
                            >Scheduled</span
                          >
                        </td>
                        <td class="px-4 py-3.5 text-right">
                          <button class="text-primary font-bold">
                            View receipt
                          </button>
                        </td>
                      </tr>
                      <tr>
                        <td class="px-4 py-3.5 font-bold">Sarah Mitchell</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          The Glass House
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Rent — June 2026
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          1 Jun 2026
                        </td>
                        <td class="px-3 py-3.5 font-bold">£1,450</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Direct Debit
                        </td>
                        <td class="px-3 py-3.5">
                          <span
                            class="inline-flex items-center gap-1 bg-primary/10 text-primary px-2 py-1 rounded-full text-[10px] font-bold"
                            ><span class="material-symbols-outlined text-[14px]"
                              >check_circle</span
                            >Received</span
                          >
                        </td>
                        <td class="px-4 py-3.5 text-right">
                          <button class="text-primary font-bold">
                            View receipt
                          </button>
                        </td>
                      </tr>
                      <tr>
                        <td class="px-4 py-3.5 font-bold">Daniel Roberts</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Hudson Lofts
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Rent — June 2026
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          1 Jun 2026
                        </td>
                        <td class="px-3 py-3.5 font-bold">£1,450</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Bank transfer
                        </td>
                        <td class="px-3 py-3.5">
                          <span
                            class="inline-flex items-center gap-1 bg-[#fff4e5] text-[#b45309] px-2 py-1 rounded-full text-[10px] font-bold"
                            ><span class="material-symbols-outlined text-[14px]"
                              >warning</span
                            >Overdue</span
                          >
                        </td>
                        <td class="px-4 py-3.5 text-right">
                          <button class="text-primary font-bold">
                            View tenancy
                          </button>
                        </td>
                      </tr>
                      <tr>
                        <td class="px-4 py-3.5 font-bold">Sarah Mitchell</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          The Glass House
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Tenancy Deposit
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          28 May 2026
                        </td>
                        <td class="px-3 py-3.5 font-bold">£1,673</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Bank transfer
                        </td>
                        <td class="px-3 py-3.5">
                          <span
                            class="inline-flex items-center gap-1 bg-primary/10 text-primary px-2 py-1 rounded-full text-[10px] font-bold"
                            ><span class="material-symbols-outlined text-[14px]"
                              >check_circle</span
                            >Received</span
                          >
                        </td>
                        <td class="px-4 py-3.5 text-right">
                          <button class="text-primary font-bold">
                            View record
                          </button>
                        </td>
                      </tr>
                      <tr>
                        <td class="px-4 py-3.5 font-bold">Daniel Roberts</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Hudson Lofts
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Holding Deposit
                        </td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          20 May 2026
                        </td>
                        <td class="px-3 py-3.5 font-bold">£335</td>
                        <td class="px-3 py-3.5 text-on-surface-variant">
                          Card ending 4821
                        </td>
                        <td class="px-3 py-3.5">
                          <span
                            class="inline-flex items-center gap-1 bg-primary/10 text-primary px-2 py-1 rounded-full text-[10px] font-bold"
                            ><span class="material-symbols-outlined text-[14px]"
                              >check_circle</span
                            >Received</span
                          >
                        </td>
                        <td class="px-4 py-3.5 text-right">
                          <button class="text-primary font-bold">
                            View receipt
                          </button>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>

              <section
                class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4"
              >
                <div
                  class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
                >
                  <div class="flex items-start gap-3">
                    <div
                      class="w-10 h-10 rounded-lg bg-secondary-container text-primary flex items-center justify-center"
                    >
                      <span class="material-symbols-outlined"
                        >calendar_month</span
                      >
                    </div>
                    <div>
                      <p class="text-sm font-bold">Next rent due</p>
                      <p class="text-xs text-on-surface-variant mt-1">
                        The Glass House · Sarah Mitchell · Rent for July 2026
                      </p>
                      <p class="text-xs text-on-surface-variant mt-1">
                        Due 1 Jul 2026 · Direct Debit
                      </p>
                      <p class="text-xl font-semibold mt-1">£1,450</p>
                    </div>
                  </div>
                  <div class="flex gap-2">
                    <button
                      class="px-3 py-2 rounded-lg border border-outline-variant text-primary text-xs font-bold"
                    >
                      View tenancy</button
                    ><button
                      class="px-3 py-2 rounded-lg bg-primary text-white text-xs font-bold"
                    >
                      Send reminder
                    </button>
                  </div>
                </div>
              </section>
            </div>

            <aside class="lg:col-span-4 space-y-4">
              <section
                class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4"
              >
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary"
                    >credit_card</span
                  >
                  <h3 class="text-sm font-bold">Payout account</h3>
                </div>
                <div class="mt-4 rounded-lg border border-outline-variant p-3">
                  <p class="text-xs text-on-surface-variant">Bank account</p>
                  <p class="text-sm font-bold mt-1">Account ending 4821</p>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Default for rent payments
                  </p>
                </div>
                <button
                  class="w-full mt-4 py-2.5 rounded-lg border border-outline-variant text-primary text-xs font-bold"
                >
                  Payout settings
                </button>
              </section>
              <section
                class="bg-[#fffaf2] border border-[#f0cf9e] rounded-xl p-4"
              >
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[#b45309]"
                    >warning</span
                  >
                  <h3 class="text-sm font-bold">Payment needing attention</h3>
                </div>
                <div class="mt-4">
                  <p class="text-sm font-bold">Daniel Roberts</p>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Hudson Lofts
                  </p>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Rent for June 2026
                  </p>
                  <p class="text-lg font-semibold text-[#b45309] mt-2">
                    £1,450 overdue
                  </p>
                </div>
                <div class="flex gap-3 mt-4">
                  <button class="text-primary text-xs font-bold">
                    View tenancy</button
                  ><button class="text-primary text-xs font-bold">
                    Send reminder
                  </button>
                </div>
              </section>
              <section
                class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4"
              >
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary"
                    >description</span
                  >
                  <h3 class="text-sm font-bold">Deposit records</h3>
                </div>
                <div class="mt-4 space-y-2 text-xs">
                  <div class="flex justify-between">
                    <span class="text-on-surface-variant"
                      >Active deposits protected</span
                    ><span class="font-bold">2</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-on-surface-variant"
                      >Pending deposit records</span
                    ><span class="font-bold">1</span>
                  </div>
                </div>
                <p class="text-xs text-on-surface-variant mt-4">
                  Deposit records are linked to each tenancy and stored with
                  your documents.
                </p>
                <button
                  class="w-full mt-4 py-2.5 rounded-lg border border-outline-variant text-primary text-xs font-bold"
                >
                  View deposit records
                </button>
              </section>
              <section
                class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4"
              >
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary"
                    >contact_support</span
                  >
                  <h3 class="text-sm font-bold">Need help with a payment?</h3>
                </div>
                <p class="text-xs text-on-surface-variant mt-3">
                  Get support with a missing payment, receipt or tenancy payment
                  record.
                </p>
                <button
                  class="w-full mt-4 py-2.5 rounded-lg border border-primary text-primary text-xs font-bold"
                >
                  Contact support
                </button>
              </section>
              <section
                class="bg-surface-container-low border border-outline-variant rounded-xl px-4 py-3 flex items-start gap-3"
              >
                <span class="material-symbols-outlined text-primary mt-0.5"
                  >receipt_long</span
                >
                <div>
                  <h3 class="text-xs font-bold">
                    Your payment records stay organised
                  </h3>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Rent and tenancy payment records are stored with the
                    relevant property and tenancy.
                  </p>
                </div>
              </section>
            </aside>
          </section>
        </div>
      </section>
    </main>
    <script src="/js/main.js"></script>
  </body>
</html>
