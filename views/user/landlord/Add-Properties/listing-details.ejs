<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../../partials/head') %>
  </head>
  <body class="bg-surface text-on-surface">
    <%- include('../../partials/sidebar-landlord') %>
    <!-- Shared landlord sidebar -->

    <main class="ml-[280px] min-h-screen flex flex-col">
      <!-- Shared landlord header -->
      <header
        class="sticky top-0 z-40 h-16 bg-surface flex justify-between items-center px-10 border-b border-outline-variant"
      >
        <div class="relative w-full max-w-md">
          <span
            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant"
            >search</span
          >
          <input
            class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-primary/20"
            placeholder="Search properties, applications, documents..."
            type="text"
          />
        </div>
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-4 text-on-surface-variant">
            <button
              class="relative hover:bg-surface-container-low p-2 rounded-full"
            >
              <span class="material-symbols-outlined">notifications</span
              ><span
                class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"
              ></span>
            </button>
            <button class="hover:bg-surface-container-low p-2 rounded-full">
              <span class="material-symbols-outlined">settings</span>
            </button>
            <button class="hover:bg-surface-container-low p-2 rounded-full">
              <span class="material-symbols-outlined">chat_bubble</span>
            </button>
          </div>
          <div class="h-8 w-px bg-outline-variant"></div>
          <div class="flex items-center gap-3">
            <div class="text-right">
              <p class="text-sm font-bold">Marcus R.</p>
              <p class="text-xs text-on-surface-variant">Landlord</p>
            </div>
            <div
              class="w-10 h-10 rounded-full bg-secondary-container text-primary flex items-center justify-center font-bold"
            >
              MR
            </div>
          </div>
        </div>
      </header>

      <section class="px-10 py-7">
        <div class="max-w-[1120px] mx-auto space-y-5">
          <div
            class="flex flex-col md:flex-row md:items-end md:justify-between gap-4"
          >
            <div>
              <p
                class="text-xs uppercase tracking-[.14em] text-on-surface-variant font-bold mb-1"
              >
                Property listing setup
              </p>
              <h1 class="text-3xl font-semibold text-primary">
                Listing details
              </h1>
              <p class="text-sm text-on-surface-variant mt-2">
                Create the information renters will see when they view this
                property.
              </p>
            </div>
            <button
              class="self-start md:self-auto text-primary text-sm font-bold hover:underline"
            >
              Save draft
            </button>
          </div>

          <!-- Compact five-step progress -->
          <section
            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-5 py-4"
          >
            <ol class="grid grid-cols-1 sm:grid-cols-5 gap-3">
              <li class="flex items-center gap-2 text-primary">
                <span
                  class="w-6 h-6 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center"
                  ><span class="material-symbols-outlined text-[15px]"
                    >check</span
                  ></span
                ><span class="text-xs font-bold">Address &amp; type</span>
              </li>
              <li class="flex items-center gap-2 text-primary">
                <span
                  class="w-6 h-6 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center"
                  >2</span
                ><span class="text-xs font-bold">Listing details</span>
              </li>
              <li class="flex items-center gap-2 text-on-surface-variant">
                <span
                  class="w-6 h-6 rounded-full bg-surface-container-high border border-outline-variant text-xs font-bold flex items-center justify-center"
                  >3</span
                ><span class="text-xs font-bold">Rent &amp; availability</span>
              </li>
              <li class="flex items-center gap-2 text-on-surface-variant">
                <span
                  class="w-6 h-6 rounded-full bg-surface-container-high border border-outline-variant text-xs font-bold flex items-center justify-center"
                  >4</span
                ><span class="text-xs font-bold">Photos &amp; documents</span>
              </li>
              <li class="flex items-center gap-2 text-on-surface-variant">
                <span
                  class="w-6 h-6 rounded-full bg-surface-container-high border border-outline-variant text-xs font-bold flex items-center justify-center"
                  >5</span
                ><span class="text-xs font-bold">Review &amp; publish</span>
              </li>
            </ol>
          </section>

          <section
            class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden"
          >
            <div class="px-5 py-4 border-b border-outline-variant">
              <h2 class="text-sm font-bold">Step 2: Listing details</h2>
              <p class="text-xs text-on-surface-variant mt-1">
                Add the public-facing details renters need to understand the
                home.
              </p>
            </div>

            <form class="p-5 space-y-6">
              <p class="text-xs text-on-surface-variant">
                Fields marked <span class="text-error font-bold">*</span> are
                required.
              </p>

              <section class="space-y-4">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <h3 class="text-sm font-bold">Listing information</h3>
                    <p class="text-xs text-on-surface-variant mt-1">
                      This content appears on the renter property page.
                    </p>
                  </div>
                  <span class="text-xs text-on-surface-variant">Public</span>
                </div>
                <div>
                  <label
                    class="block text-xs font-bold mb-1.5"
                    for="listing-title"
                    >Listing title <span class="text-error">*</span></label
                  >
                  <input
                    id="listing-title"
                    class="w-full max-w-2xl px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20"
                    placeholder="e.g. Bright two-bedroom apartment near Canary Wharf"
                    type="text"
                  />
                  <p class="text-xs text-on-surface-variant mt-1.5">
                    Keep it clear and factual. Avoid marketing claims that
                    cannot be verified.
                  </p>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold" for="description"
                      >Property description
                      <span class="text-error">*</span></label
                    >
                    <span class="text-xs text-on-surface-variant"
                      >0 / 1,500</span
                    >
                  </div>
                  <textarea
                    id="description"
                    rows="6"
                    class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm resize-y focus:outline-none focus:ring-2 focus:ring-primary/20"
                  ></textarea>
                  <p class="text-xs text-on-surface-variant mt-1.5">
                    Describe the property itself, its rooms and useful nearby
                    features. Do not include selection requirements about
                    personal characteristics.
                  </p>
                </div>
              </section>

              <section class="space-y-4">
                <div>
                  <h3 class="text-sm font-bold">Key features</h3>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Choose the details that help renters compare homes.
                  </p>
                </div>
                <div
                  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"
                >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >balcony</span
                      ><span class="text-sm font-semibold"
                        >Private balcony</span
                      ></span
                    ></label
                  >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >kitchen</span
                      ><span class="text-sm font-semibold"
                        >Fitted kitchen</span
                      ></span
                    ></label
                  >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >local_laundry_service</span
                      ><span class="text-sm font-semibold"
                        >In-home laundry</span
                      ></span
                    ></label
                  >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >elevator</span
                      ><span class="text-sm font-semibold"
                        >Lift access</span
                      ></span
                    ></label
                  >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >directions_car</span
                      ><span class="text-sm font-semibold"
                        >Parking available</span
                      ></span
                    ></label
                  >
                  <label class="cursor-pointer"
                    ><input class="peer sr-only" type="checkbox" /><span
                      class="flex items-center gap-3 p-3 border border-outline-variant rounded-lg bg-surface hover:bg-surface-container-low peer-checked:border-primary peer-checked:bg-secondary-container"
                      ><span class="material-symbols-outlined text-primary"
                        >park</span
                      ><span class="text-sm font-semibold"
                        >Outdoor space</span
                      ></span
                    ></label
                  >
                </div>
              </section>

              <section class="space-y-4">
                <div>
                  <h3 class="text-sm font-bold">Property information</h3>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Add practical details renters regularly ask about.
                  </p>
                </div>
                <div
                  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
                >
                  <div>
                    <label
                      class="block text-xs font-bold mb-1.5"
                      for="floor-area"
                      >Floor area</label
                    >
                    <div class="relative">
                      <input
                        id="floor-area"
                        class="w-full pr-10 px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                        placeholder="e.g. 72"
                        type="number"
                      /><span
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-on-surface-variant"
                        >m²</span
                      >
                    </div>
                  </div>
                  <div>
                    <label
                      class="block text-xs font-bold mb-1.5"
                      for="floor-level"
                      >Floor level</label
                    ><select
                      id="floor-level"
                      class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                    >
                      <option value="">Select</option>
                      <option>Ground floor</option>
                      <option>1st floor</option>
                      <option>2nd floor</option>
                      <option>3rd floor</option>
                      <option>4th floor</option>
                      <option>5th floor or above</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-bold mb-1.5" for="heating"
                      >Heating</label
                    ><select
                      id="heating"
                      class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                    >
                      <option value="">Select</option>
                      <option>Central heating</option>
                      <option>Electric heating</option>
                      <option>Underfloor heating</option>
                      <option>Other</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-bold mb-1.5" for="epc"
                      >EPC rating</label
                    ><select
                      id="epc"
                      class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                    >
                      <option value="">Add later</option>
                      <option>A</option>
                      <option>B</option>
                      <option>C</option>
                      <option>D</option>
                      <option>E</option>
                      <option>F</option>
                      <option>G</option>
                    </select>
                  </div>
                </div>
              </section>

              <section class="space-y-4">
                <div>
                  <h3 class="text-sm font-bold">
                    Accessibility and household details
                  </h3>
                  <p class="text-xs text-on-surface-variant mt-1">
                    Optional information that helps renters decide whether the
                    home works for them.
                  </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label
                      class="block text-xs font-bold mb-1.5"
                      for="accessibility"
                      >Accessibility features</label
                    >
                    <select
                      id="accessibility"
                      class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                    >
                      <option value="">Select</option>
                      <option>Step-free access</option>
                      <option>Lift access</option>
                      <option>Accessible bathroom</option>
                      <option>Other accessibility feature</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-bold mb-1.5" for="pets"
                      >Pets</label
                    >
                    <select
                      id="pets"
                      class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm"
                    >
                      <option value="">Select</option>
                      <option>Ask landlord</option>
                      <option>Pets considered</option>
                      <option>Pets not permitted</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label
                    class="block text-xs font-bold mb-1.5"
                    for="additional-notes"
                    >Additional property notes</label
                  >
                  <textarea
                    id="additional-notes"
                    rows="3"
                    class="w-full px-3 py-2.5 bg-surface border border-outline-variant rounded-lg text-sm resize-y"
                    placeholder="Add practical information such as bike storage, concierge access or building entry details."
                  ></textarea>
                </div>
              </section>
            </form>

            <div
              class="px-5 py-4 bg-surface-container-low border-t border-outline-variant flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
            >
              <button onclick="window.location.href = '/user/landlord/properties/add/address'"
                class="self-start px-4 py-2.5 rounded-lg border border-outline-variant text-primary text-sm font-bold flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >arrow_back</span
                >Back to address &amp; type
              </button>
              <button class="self-end px-4 py-2.5 bg-primary text-white rounded-lg text-sm font-bold flex items-center gap-2" onclick="window.location.href = '/user/landlord/properties/add/rent'">
                Continue to rent &amp; availability
                <span class="material-symbols-outlined text-[18px]"
                  >arrow_forward</span
                >
              </button>
            </div>
          </section>
        </div>
      </section>
    </main>
    <script src="../../../js/main.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
