    <div
      id="calendar-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 p-5"
    >
      <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 id="modal-title" class="text-lg font-bold">Viewing details</h2>
            <p id="modal-copy" class="text-sm text-on-surface-variant mt-1"></p>
          </div>
          <button
            id="modal-close"
            class="h-9 w-9 rounded-full hover:bg-surface-container-low"
          >
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div id="modal-content" class="mt-5"></div>
        <div class="mt-6 flex justify-end gap-3">
          <button
            id="modal-cancel"
            class="px-4 py-2.5 rounded-lg text-primary text-sm font-bold hover:bg-surface-container-low"
          >
            Close</button
          ><button
            id="modal-confirm"
            class="px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-bold"
          >
            Save
          </button>
        </div>
      </div>
    </div>

    <script>
      (function () {
        const modal = document.getElementById("calendar-modal"),
          title = document.getElementById("modal-title"),
          copy = document.getElementById("modal-copy"),
          content = document.getElementById("modal-content"),
          confirm = document.getElementById("modal-confirm");
        const close = () => {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        };
        const open = (type, details) => {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
          if (type === "schedule") {
            title.textContent = "Schedule viewing";
            copy.textContent = "Create a proposed viewing for an applicant.";
            content.innerHTML =
              '<div class="space-y-3"><input class="w-full p-3 border border-outline-variant rounded-lg text-sm" placeholder="Property"><input class="w-full p-3 border border-outline-variant rounded-lg text-sm" placeholder="Applicant"><div class="grid grid-cols-2 gap-3"><input class="p-3 border border-outline-variant rounded-lg text-sm" type="date"><input class="p-3 border border-outline-variant rounded-lg text-sm" type="time"></div></div>';
            confirm.textContent = "Create viewing";
          } else {
            title.textContent = "Viewing details";
            copy.textContent = details;
            content.innerHTML =
              '<div class="rounded-xl bg-surface-container-low p-4 text-sm text-on-surface-variant">This is a clickable calendar preview. Use the applicant profile to review the application or send a viewing message.</div>';
            confirm.textContent = "Done";
          }
        };
        document
          .querySelectorAll(".event-pill")
          .forEach((b) =>
            b.addEventListener("click", () => open("event", b.dataset.event)),
          );
        document
          .getElementById("new-viewing-button")
          .addEventListener("click", () => open("schedule"));
        document.getElementById("modal-close").addEventListener("click", close);
        document
          .getElementById("modal-cancel")
          .addEventListener("click", close);
        confirm.addEventListener("click", close);
        modal.addEventListener("click", (e) => {
          if (e.target === modal) close();
        });
        document
          .getElementById("today-button")
          .addEventListener(
            "click",
            () =>
              (document.getElementById("calendar-month").textContent =
                "October 2026"),
          );
        document
          .getElementById("prev-month")
          .addEventListener(
            "click",
            () =>
              (document.getElementById("calendar-month").textContent =
                "September 2026"),
          );
        document
          .getElementById("next-month")
          .addEventListener(
            "click",
            () =>
              (document.getElementById("calendar-month").textContent =
                "November 2026"),
          );
      })();
    </script>
