<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const landlordProfile = typeof profile === 'object' && profile ? profile : {}; %>
    <% const scoreUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = scoreUser.fullName || landlordProfile.legalName || 'Landlord'; %>
    <% const hasSavedProfile = Boolean(landlordProfile.landlordType || landlordProfile.primaryLocations || landlordProfile.managementStyle || landlordProfile.propertyCount === 0 || landlordProfile.propertyCount); %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8">
          <p class="mb-1 text-label-md font-bold text-secondary">Profile context</p>
          <h1 class="text-headline-lg font-bold text-primary">Landlord HomiScore</h1>
          <p class="mt-2 max-w-3xl text-body-md text-on-surface-variant">Review which source information is available before any score can be calculated or shared.</p>
        </div>

        <section class="mb-8 border-y border-outline-variant bg-surface-container-low px-5 py-6 sm:px-6" aria-labelledby="score-status-title">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex min-w-0 items-start gap-4">
              <span class="material-symbols-outlined flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true">pending</span>
              <div>
                <p class="text-label-sm font-bold uppercase text-secondary">Current status</p>
                <h2 id="score-status-title" class="mt-1 text-headline-md font-bold text-primary">Score not available</h2>
                <p class="mt-2 max-w-3xl text-body-sm text-on-surface-variant">HomiFund does not currently have a connected scoring service or the verified operational records needed to produce a landlord score. This page will not estimate one from onboarding answers.</p>
              </div>
            </div>
            <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-primary px-5 font-bold text-primary hover:bg-surface-container-lowest" href="/landlord-verification"><span class="material-symbols-outlined text-xl" aria-hidden="true">fact_check</span>Review requirements</a>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="coverage-title">
              <div class="mb-4">
                <h2 id="coverage-title" class="text-headline-md font-bold text-on-surface">Source coverage</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Only information actually available in this account is shown as present.</p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="material-symbols-outlined text-primary" aria-hidden="true">account_circle</span>
                    <span class="rounded-full bg-surface-container-high px-3 py-1 text-label-sm font-bold text-on-surface-variant"><%= hasSavedProfile ? 'Available' : 'Missing' %></span>
                  </div>
                  <h3 class="mt-4 font-bold text-on-surface">Profile details</h3>
                  <p class="mt-2 text-body-sm text-on-surface-variant"><%= hasSavedProfile ? 'Saved onboarding information is available as account context.' : 'No landlord onboarding details are available yet.' %></p>
                  <a class="mt-3 inline-flex min-h-11 items-center font-bold text-primary hover:underline" href="/onboarding-landlord"><%= hasSavedProfile ? 'Review details' : 'Complete profile' %></a>
                </article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="material-symbols-outlined text-primary" aria-hidden="true">verified_user</span>
                    <span class="rounded-full bg-surface-container-high px-3 py-1 text-label-sm font-bold text-on-surface-variant">Not submitted</span>
                  </div>
                  <h3 class="mt-4 font-bold text-on-surface">Verification evidence</h3>
                  <p class="mt-2 text-body-sm text-on-surface-variant">Requirements can be reviewed, but secure document submission is not configured.</p>
                  <a class="mt-3 inline-flex min-h-11 items-center font-bold text-primary hover:underline" href="/landlord-verification">Open checklist</a>
                </article>
                <article class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="material-symbols-outlined text-primary" aria-hidden="true">database</span>
                    <span class="rounded-full bg-surface-container-high px-3 py-1 text-label-sm font-bold text-on-surface-variant">Not connected</span>
                  </div>
                  <h3 class="mt-4 font-bold text-on-surface">Operational records</h3>
                  <p class="mt-2 text-body-sm text-on-surface-variant">Property, tenancy, applicant, and payment records are not connected to a scoring model.</p>
                  <a class="mt-3 inline-flex min-h-11 items-center font-bold text-primary hover:underline" href="/user/landlord/dashboard">Return to dashboard</a>
                </article>
              </div>
            </section>

            <section aria-labelledby="principles-title">
              <div class="mb-4">
                <h2 id="principles-title" class="text-headline-md font-bold text-on-surface">How a score should be handled</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">These safeguards are required before a score can be treated as meaningful account information.</p>
              </div>
              <ol class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest" role="list">
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-on-primary">1</span><div><h3 class="font-bold text-on-surface">Use verified source data</h3><p class="mt-1 text-body-sm text-on-surface-variant">The calculation should identify which current records were used and which information was unavailable.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">2</span><div><h3 class="font-bold text-on-surface">Explain the result</h3><p class="mt-1 text-body-sm text-on-surface-variant">Any future score needs a published method, factor-level explanation, effective date, and correction route.</p></div></li>
                <li class="flex gap-4 p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">3</span><div><h3 class="font-bold text-on-surface">Keep decisions accountable</h3><p class="mt-1 text-body-sm text-on-surface-variant">HomiScore is supporting context. It should not guarantee outcomes or replace a fair review of relevant information.</p></div></li>
              </ol>
            </section>

            <section aria-labelledby="history-title">
              <div class="mb-4">
                <h2 id="history-title" class="text-headline-md font-bold text-on-surface">Score history</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Calculated results and changes would appear here.</p>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-10 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">monitoring</span>
                <h3 class="mt-3 font-bold text-on-surface">No score history</h3>
                <p class="mx-auto mt-2 max-w-lg text-body-sm text-on-surface-variant">No score has been generated, so there is no trend, report, or shareable score link.</p>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="HomiScore information">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="profile-context-title">
              <p class="text-label-sm font-bold uppercase text-secondary">Saved onboarding</p>
              <h2 id="profile-context-title" class="mt-1 text-headline-md font-bold text-primary">Profile context</h2>
              <dl class="mt-5 space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Account type</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.landlordType ? landlordProfile.landlordType.replace('-', ' ') : 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Property estimate</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.propertyCount === 0 || landlordProfile.propertyCount ? landlordProfile.propertyCount + ' properties' : 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Locations</dt><dd class="max-w-[60%] text-right font-bold text-on-surface"><%= landlordProfile.primaryLocations || 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Management</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.managementStyle ? landlordProfile.managementStyle.replace('-', ' ') : 'Not set' %></dd></div>
              </dl>
              <p class="mt-4 text-body-sm text-on-surface-variant">These are self-reported setup details, not verified score inputs.</p>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="boundaries-title">
              <h2 id="boundaries-title" class="text-headline-md font-bold text-primary">Data boundaries</h2>
              <ul class="mt-4 space-y-3 text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>No credit-bureau data is shown or claimed.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>No income, portfolio value, or payment performance is inferred.</span></li>
                <li class="flex gap-3"><span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">check</span><span>No report or share link is available without a real score.</span></li>
              </ul>
              <a class="mt-5 inline-flex min-h-11 items-center gap-2 font-bold text-primary hover:underline" href="/user/landlord/support"><span class="material-symbols-outlined text-xl" aria-hidden="true">help</span>HomiScore support</a>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
