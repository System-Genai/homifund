    <!-- Sensitive Metric Modal -->
    <div
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 px-4"
      id="sensitiveMetricModal"
    >
      <div
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-2xl border border-outline-variant"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-headline-md font-bold text-on-surface">
              Sensitive Information
            </h3>
            <p
              class="mt-1 text-label-md font-semibold text-primary"
              id="sensitiveMetricTitle"
            ></p>
          </div>
          <button
            aria-label="Close sensitive information modal"
            class="rounded-full p-2 hover:bg-surface-container-low transition-colors"
            id="closeSensitiveModal"
            type="button"
          >
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <p class="mt-4 text-body-md text-on-surface-variant">
          This information is hidden by default because it may be commercially
          sensitive.
        </p>
        <p class="mt-3 text-body-md text-on-surface-variant">
          If you generate and share your secure HomiScore link, people with
          access to that link may be able to view this information depending on
          your sharing preferences.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <button
            class="flex-1 rounded-lg bg-primary px-4 py-3 text-label-md font-bold text-white hover:opacity-90 transition-opacity"
            id="revealSensitiveMetric"
            type="button"
          >
            Reveal Value
          </button>
          <button
            class="flex-1 rounded-lg border border-outline-variant bg-white px-4 py-3 text-label-md font-bold text-on-surface hover:bg-surface-container-low transition-colors"
            id="cancelSensitiveMetric"
            type="button"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
    <script>
      // Micro-interactions for buttons
      document.querySelectorAll("button").forEach((btn) => {
        btn.addEventListener("mousedown", () =>
          btn.classList.add("scale-[0.98]"),
        );
        btn.addEventListener("mouseup", () =>
          btn.classList.remove("scale-[0.98]"),
        );
        btn.addEventListener("mouseleave", () =>
          btn.classList.remove("scale-[0.98]"),
        );
      });

      // Sensitive metric reveal modal
      const sensitiveMetricModal = document.getElementById(
        "sensitiveMetricModal",
      );
      const sensitiveMetricTitle = document.getElementById(
        "sensitiveMetricTitle",
      );
      const revealSensitiveMetric = document.getElementById(
        "revealSensitiveMetric",
      );
      const closeSensitiveModal = document.getElementById(
        "closeSensitiveModal",
      );
      const cancelSensitiveMetric = document.getElementById(
        "cancelSensitiveMetric",
      );
      let activeSensitiveMetric = null;

      function openSensitiveModal(metricButton) {
        activeSensitiveMetric = metricButton;
        sensitiveMetricTitle.textContent = metricButton.dataset.label;
        sensitiveMetricModal.classList.remove("hidden");
        sensitiveMetricModal.classList.add("flex");
      }

      function closeSensitiveMetricModal() {
        sensitiveMetricModal.classList.add("hidden");
        sensitiveMetricModal.classList.remove("flex");
        activeSensitiveMetric = null;
      }

      document.querySelectorAll(".sensitive-metric").forEach((metricButton) => {
        metricButton.addEventListener("click", () =>
          openSensitiveModal(metricButton),
        );
      });

      revealSensitiveMetric.addEventListener("click", () => {
        if (!activeSensitiveMetric) return;
        const valueElement =
          activeSensitiveMetric.querySelector("p:nth-of-type(2)");
        const helperElement =
          activeSensitiveMetric.querySelector("p:nth-of-type(3)");
        valueElement.textContent = activeSensitiveMetric.dataset.value;
        valueElement.classList.remove("tracking-widest");
        helperElement.textContent = "Visible on this page";
        closeSensitiveMetricModal();
      });

      closeSensitiveModal.addEventListener("click", closeSensitiveMetricModal);
      cancelSensitiveMetric.addEventListener(
        "click",
        closeSensitiveMetricModal,
      );

      sensitiveMetricModal.addEventListener("click", (event) => {
        if (event.target === sensitiveMetricModal) {
          closeSensitiveMetricModal();
        }
      });
    </script>
    <script src="/js/main.js"></script>
  </body>
