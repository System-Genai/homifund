<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-surface-bright text-on-surface hf-dashboard">
    <% const landlordProfile = typeof profile === 'object' && profile ? profile : {}; %>
    <% const dashboardUser = typeof currentUser === 'object' && currentUser ? currentUser : {}; %>
    <% const displayName = dashboardUser.fullName || landlordProfile.legalName || 'Landlord'; %>
    <%- include('../partials/sidebar-landlord') %>

    <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between border-b border-outline-variant bg-surface px-4 shadow-sm md:pl-[264px] md:pr-8">
      <div class="min-w-0">
        <p class="truncate text-label-sm font-bold text-secondary">Landlord workspace</p>
        <p class="truncate text-body-sm text-on-surface-variant"><%= displayName %></p>
      </div>
      <div class="flex items-center gap-1 sm:gap-2">
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/notification-bell" aria-label="Notifications" title="Notifications"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/messages" aria-label="Messages" title="Messages"><span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/settings" aria-label="Settings" title="Settings"><span class="material-symbols-outlined" aria-hidden="true">settings</span></a>
        <a class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low" href="/user/landlord/user-profile" aria-label="Landlord profile" title="Landlord profile"><span class="material-symbols-outlined" aria-hidden="true">person</span></a>
      </div>
    </header>

    <main class="w-full px-4 py-6 md:ml-[240px] md:w-[calc(100%-240px)] md:px-8 md:py-8 hf-dashboard-main">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-label-md font-bold text-secondary">Overview</p>
            <h1 class="text-headline-lg font-bold text-primary">Landlord dashboard</h1>
            <p class="mt-2 max-w-2xl text-body-md text-on-surface-variant">Review account setup and open the property, applicant, document, and payment workspaces.</p>
          </div>
          <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-6 font-bold text-on-primary hover:bg-primary-container" href="/user/landlord/properties/add/address"><span class="material-symbols-outlined text-xl" aria-hidden="true">add_home</span>Add property</a>
        </div>

        <section class="mb-8" aria-labelledby="record-status-title">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 id="record-status-title" class="text-headline-md font-bold text-on-surface">Record status</h2>
            <p class="text-body-sm text-on-surface-variant">No operational records added</p>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/landlord/properties">
              <span class="material-symbols-outlined text-primary" aria-hidden="true">home_work</span>
              <p class="mt-4 text-label-sm font-bold uppercase text-on-surface-variant">Properties</p>
              <p class="mt-1 text-headline-md font-bold text-primary">No records</p>
              <p class="mt-2 text-body-sm text-on-surface-variant">Open the property workspace</p>
            </a>
            <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/landlord/applicants">
              <span class="material-symbols-outlined text-primary" aria-hidden="true">assignment</span>
              <p class="mt-4 text-label-sm font-bold uppercase text-on-surface-variant">Applicants</p>
              <p class="mt-1 text-headline-md font-bold text-primary">No records</p>
              <p class="mt-2 text-body-sm text-on-surface-variant">Open the applicant workspace</p>
            </a>
            <a class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 transition-colors hover:border-primary" href="/user/landlord/payments">
              <span class="material-symbols-outlined text-primary" aria-hidden="true">account_balance_wallet</span>
              <p class="mt-4 text-label-sm font-bold uppercase text-on-surface-variant">Payments</p>
              <p class="mt-1 text-headline-md font-bold text-primary">No records</p>
              <p class="mt-2 text-body-sm text-on-surface-variant">Open the payment workspace</p>
            </a>
          </div>
        </section>

        <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
          <div class="space-y-8 xl:col-span-8">
            <section aria-labelledby="getting-started-title">
              <div class="mb-4">
                <h2 id="getting-started-title" class="text-headline-md font-bold text-on-surface">Get started</h2>
                <p class="mt-1 text-body-sm text-on-surface-variant">Complete these tasks as the related records become available.</p>
              </div>
              <ol class="divide-y divide-outline-variant rounded-lg border border-outline-variant bg-surface-container-lowest" role="list">
                <li class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-on-primary">1</span><div><h3 class="font-bold text-on-surface">Add your first property</h3><p class="mt-1 text-body-sm text-on-surface-variant">Create the address and listing record used by the property workspace.</p></div></div>
                  <a class="inline-flex min-h-11 shrink-0 items-center justify-center px-3 font-bold text-primary hover:underline" href="/user/landlord/properties/add/address">Add property</a>
                </li>
                <li class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">2</span><div><h3 class="font-bold text-on-surface">Review verification requirements</h3><p class="mt-1 text-body-sm text-on-surface-variant">Check the preparation list before any document-submission service is enabled.</p></div></div>
                  <a class="inline-flex min-h-11 shrink-0 items-center justify-center px-3 font-bold text-primary hover:underline" href="/landlord-verification">Review requirements</a>
                </li>
                <li class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-container-high font-bold text-on-surface-variant">3</span><div><h3 class="font-bold text-on-surface">Confirm your profile</h3><p class="mt-1 text-body-sm text-on-surface-variant">Keep account and portfolio details current.</p></div></div>
                  <a class="inline-flex min-h-11 shrink-0 items-center justify-center px-3 font-bold text-primary hover:underline" href="/user/landlord/user-profile">Open profile</a>
                </li>
              </ol>
            </section>

            <section aria-labelledby="activity-title">
              <div class="mb-4 flex items-center justify-between gap-4">
                <h2 id="activity-title" class="text-headline-md font-bold text-on-surface">Recent activity</h2>
                <a class="inline-flex min-h-11 items-center px-2 font-bold text-primary hover:underline" href="/user/landlord/notification-bell">View notifications</a>
              </div>
              <div class="rounded-lg border border-dashed border-outline-variant px-5 py-10 text-center">
                <span class="material-symbols-outlined text-4xl text-outline" aria-hidden="true">inbox</span>
                <h3 class="mt-3 font-bold text-on-surface">No activity yet</h3>
                <p class="mx-auto mt-2 max-w-lg text-body-sm text-on-surface-variant">Property, applicant, document, and payment activity will appear here when those records are connected.</p>
              </div>
            </section>
          </div>

          <aside class="space-y-6 xl:col-span-4" aria-label="Account summary">
            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="profile-summary-title">
              <div class="mb-5 flex items-start justify-between gap-4">
                <div><p class="text-label-sm font-bold uppercase text-secondary">Saved onboarding</p><h2 id="profile-summary-title" class="mt-1 text-headline-md font-bold text-primary">Profile summary</h2></div>
                <span class="material-symbols-outlined text-primary" aria-hidden="true">account_circle</span>
              </div>
              <dl class="space-y-4 text-body-sm">
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Account type</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.landlordType ? landlordProfile.landlordType.replace('-', ' ') : 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Profile estimate</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.propertyCount === 0 || landlordProfile.propertyCount ? landlordProfile.propertyCount + ' properties' : 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4 border-b border-outline-variant pb-3"><dt class="text-on-surface-variant">Locations</dt><dd class="max-w-[60%] text-right font-bold text-on-surface"><%= landlordProfile.primaryLocations || 'Not set' %></dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-on-surface-variant">Management</dt><dd class="text-right font-bold text-on-surface"><%= landlordProfile.managementStyle ? landlordProfile.managementStyle.replace('-', ' ') : 'Not set' %></dd></div>
              </dl>
              <a class="mt-5 inline-flex min-h-11 items-center font-bold text-primary hover:underline" href="/onboarding-landlord">Update onboarding details</a>
            </section>

            <section class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6" aria-labelledby="workspace-links-title">
              <h2 id="workspace-links-title" class="text-headline-md font-bold text-primary">Workspace links</h2>
              <nav class="mt-4 grid grid-cols-1 gap-2" aria-label="Landlord workspace links">
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 text-body-sm font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/documents"><span>Documents</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 text-body-sm font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/messages"><span>Messages</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
                <a class="inline-flex min-h-11 items-center justify-between rounded-lg px-3 text-body-sm font-bold text-on-surface hover:bg-surface-container-low" href="/user/landlord/support"><span>Support</span><span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span></a>
              </nav>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
