      vertical-align: middle;
  }
  body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      min-height: 100dvh;
      overflow-x: hidden;
  }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #f1f5f9; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>
<link rel="stylesheet" href="/css/style.css" />
<style>
  /* ---------- Global responsive safety net (mobile / tablet / desktop) ---------- */
  html { -webkit-text-size-adjust: 100%; }
  *, *::before, *::after { min-width: 0; }
  img, video, canvas, svg { max-width: 100%; }

  /* Fluid down-scaling of the fixed design type scale on small screens.
     Scoped with `html` so it only affects elements that literally carry the
     unprefixed class (responsive variants such as md:text-headline-xl are untouched). */
  @media (max-width: 640px) {
    html .text-headline-xl { font-size: 30px; line-height: 38px; }
    html .text-headline-lg { font-size: 24px; line-height: 32px; }
    html .text-headline-md { font-size: 20px; line-height: 28px; }
    html .text-body-lg { font-size: 16px; line-height: 26px; }
    /* Design-system gutters collapse to mobile gutters */
    html .px-margin-desktop { padding-left: 16px; padding-right: 16px; }
    html .p-margin-desktop { padding: 16px; }
    html .gap-gutter-desktop { gap: 16px; }
  }
  @media (min-width: 641px) and (max-width: 1023px) {
    html .px-margin-desktop { padding-left: 24px; padding-right: 24px; }
  }


  /* ---------- Mobile / tablet spacing down-scale for the fixed desktop rhythm ---------- */
  @media (max-width: 640px) {
    html .py-16, html .py-20 { padding-top: 3rem; padding-bottom: 3rem; }
    html .py-24, html .py-28, html .py-32 { padding-top: 3.5rem; padding-bottom: 3.5rem; }
    html .pt-16, html .pt-20, html .pt-24, html .pt-28, html .pt-32 { padding-top: 3rem; }
    html .pb-16, html .pb-20, html .pb-24, html .pb-28, html .pb-32 { padding-bottom: 3rem; }
    html .mt-16, html .mt-20, html .mt-24 { margin-top: 2.5rem; }
    html .mb-16, html .mb-20, html .mb-24 { margin-bottom: 2.5rem; }
    html .p-8 { padding: 1.25rem; }
    html .p-10, html .p-12 { padding: 1.5rem; }
    html .px-8 { padding-left: 1.25rem; padding-right: 1.25rem; }
    html .gap-8 { gap: 1.25rem; }
    html .gap-10, html .gap-12, html .gap-16, html .gap-20 { gap: 1.5rem; }
    html .space-y-12 > :not([hidden]) ~ :not([hidden]) { margin-top: 2rem; }
  }
  @media (min-width: 641px) and (max-width: 1023px) {
    html .py-24, html .py-28, html .py-32 { padding-top: 4.5rem; padding-bottom: 4.5rem; }
    html .gap-16, html .gap-20 { gap: 2.5rem; }
  }

  /* Tables never break the layout - they scroll inside their wrapper */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* Comfortable touch targets on touch devices */
  @media (hover: none) and (pointer: coarse) {
    button, a[role="button"], .btn { min-height: 40px; }
  }

  /* Avoid iOS zoom-on-focus for form fields */
  @media (max-width: 640px) {
    input, select, textarea { font-size: 16px; }
  }

  /* Respect notches / home indicators */
  @supports (padding: max(0px)) {
    body { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
  }
</style>
