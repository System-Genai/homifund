<!-- Landlord Dashboard Sidebar -->
<aside
  class="fixed left-0 top-0 h-screen w-[240px] bg-white border-r border-outline-variant/30 hidden md:flex flex-col py-6 px-4 gap-8 z-50"
>
  <div class="px-2">
    <h1 class="text-headline-md font-bold text-primary">HomiFund</h1>
    <p class="text-[11px] text-secondary font-medium tracking-tight">
      Landlord Dashboard
    </p>
  </div>
  <nav class="flex-1 flex flex-col gap-1">
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'dashboard' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/dashboard"
    >
      <span class="material-symbols-outlined text-[20px]">dashboard</span>
      <span class="text-label-md">Dashboard</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'homiscore' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/homiscore"
    >
      <span class="material-symbols-outlined text-[20px]">verified</span>
      <span class="text-label-md">HomiScore</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'properties' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/properties"
    >
      <span class="material-symbols-outlined text-[20px]">home_work</span>
      <span class="text-label-md">Properties</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'applicants' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/applicants"
    >
      <span class="material-symbols-outlined text-[20px]">assignment</span>
      <span class="text-label-md">Applicants</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'documents' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/documents"
    >
      <span class="material-symbols-outlined text-[20px]">description</span>
      <span class="text-label-md">Documents</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'payments' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/landlord/payments"
    >
      <span class="material-symbols-outlined text-[20px]"
        >account_balance_wallet</span
      >
      <span class="text-label-md">Payments</span>
    </a>
  </nav>
  <div class="mt-auto pt-4 border-t border-outline-variant flex flex-col gap-1">
    <button
      class="w-full mb-4 py-3 px-4 bg-primary text-on-primary rounded-lg font-semibold text-label-md hover:opacity-90 transition-opacity"
      onclick="window.location.href = '/user/landlord/properties/add/address'"
    >
      Add Property
    </button>
    <a
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/user/landlord/support"
    >
      <span class="material-symbols-outlined">contact_support</span>
      <span class="text-label-md">Support</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/logout"
    >
      <span class="material-symbols-outlined">logout</span>
      <span class="text-label-md">Log Out</span>
    </a>
  </div>
</aside>
