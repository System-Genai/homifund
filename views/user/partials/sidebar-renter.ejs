<!-- Renter Dashboard Sidebar : responsive (off-canvas drawer on mobile / fixed rail on md+) -->

<!-- Mobile menu button -->
<button
  id="mobileNavToggle"
  type="button"
  aria-label="Open navigation menu"
  aria-controls="appSidebar"
  aria-expanded="false"
  class="md:hidden fixed top-3 left-3 z-[45] w-10 h-10 flex items-center justify-center rounded-lg bg-surface-container-lowest border border-outline-variant text-primary shadow-sm active:scale-95 transition-transform"
>
  <span class="material-symbols-outlined text-[22px]">menu</span>
</button>

<!-- Backdrop -->
<div
  id="mobileNavOverlay"
  class="hidden md:hidden fixed inset-0 bg-black/50 z-[55]"
  aria-hidden="true"
></div>

<aside
  id="appSidebar"
  class="fixed left-0 top-0 h-screen w-[264px] max-w-[85vw] md:w-[240px] bg-white border-r border-outline-variant/30 flex flex-col py-6 px-4 gap-6 md:gap-8 z-[60] overflow-y-auto overscroll-contain -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <div class="px-2 flex items-start justify-between gap-2">
    <div>
      <h1 class="text-headline-md font-bold text-primary">HomiFund</h1>
      <p class="text-[11px] text-secondary font-medium tracking-tight">
        Renter Dashboard
      </p>
    </div>
    <button
      id="mobileNavClose"
      type="button"
      aria-label="Close navigation menu"
      class="md:hidden -mr-1 -mt-1 w-9 h-9 flex items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-low"
    >
      <span class="material-symbols-outlined text-[22px]">close</span>
    </button>
  </div>
  <nav class="flex-1 flex flex-col gap-1">
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 md:py-2.5 <%= locals.currentPage === 'dashboard' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/renter/dashboard"
    >
      <span class="material-symbols-outlined text-[20px] shrink-0">dashboard</span>
      <span class="text-label-md">Dashboard</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 md:py-2.5 <%= locals.currentPage === 'homiscore' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/renter/homiscore"
    >
      <span class="material-symbols-outlined text-[20px] shrink-0">verified</span>
      <span class="text-label-md">HomiScore</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 md:py-2.5 <%= locals.currentPage === 'applications' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/renter/applications"
    >
      <span class="material-symbols-outlined text-[20px] shrink-0">assignment</span>
      <span class="text-label-md">Applications</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 md:py-2.5 <%= locals.currentPage === 'documents' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/renter/documents"
    >
      <span class="material-symbols-outlined text-[20px] shrink-0">description</span>
      <span class="text-label-md">Documents</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 md:py-2.5 <%= locals.currentPage === 'payments' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/user/renter/payments"
    >
      <span class="material-symbols-outlined text-[20px] shrink-0">account_balance_wallet</span>
      <span class="text-label-md">Payments</span>
    </a>
  </nav>
  <div class="mt-auto pt-4 border-t border-outline-variant flex flex-col gap-1">
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/user/renter/settings"
    >
      <span class="material-symbols-outlined shrink-0">settings</span>
      <span class="text-label-md">Settings</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/user/renter/support"
    >
      <span class="material-symbols-outlined shrink-0">contact_support</span>
      <span class="text-label-md">Support</span>
    </a>
    <a
      data-nav-link
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/logout"
    >
      <span class="material-symbols-outlined shrink-0">logout</span>
      <span class="text-label-md">Log Out</span>
    </a>
  </div>
</aside>

<script>
  (function () {
    var btn = document.getElementById("mobileNavToggle");
    var nav = document.getElementById("appSidebar");
    var overlay = document.getElementById("mobileNavOverlay");
    var closeBtn = document.getElementById("mobileNavClose");
    if (!btn || !nav || !overlay) return;

    function openNav() {
      nav.classList.remove("-translate-x-full");
      overlay.classList.remove("hidden");
      btn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }
    function closeNav() {
      nav.classList.add("-translate-x-full");
      overlay.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    btn.addEventListener("click", openNav);
    overlay.addEventListener("click", closeNav);
    if (closeBtn) closeBtn.addEventListener("click", closeNav);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeNav();
    });
    nav.querySelectorAll("[data-nav-link]").forEach(function (a) {
      a.addEventListener("click", function () {
        if (window.innerWidth < 768) closeNav();
      });
    });
    window.addEventListener("resize", function () {
      if (window.innerWidth >= 768) {
        overlay.classList.add("hidden");
        document.body.style.overflow = "";
      }
    });
  })();
</script>
