<!-- Renter Dashboard Sidebar -->
<aside
  id="dashboard-navigation"
  aria-label="Renter dashboard navigation"
  class="hf-sidebar fixed left-0 top-0 z-50 hidden h-screen w-[240px] flex-col gap-8 border-r border-outline-variant/30 bg-white px-4 py-6 md:flex"
>
  <div class="px-2">
    <div class="text-headline-md font-bold text-primary">HomiFund</div>
    <p class="text-[11px] font-medium tracking-tight text-secondary">Renter Dashboard</p>
  </div>
  <nav class="flex flex-1 flex-col gap-1">
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'dashboard' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/dashboard" <%- locals.currentPage === 'dashboard' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">dashboard</span><span class="text-label-md">Dashboard</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'homiscore' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/homiscore" <%- locals.currentPage === 'homiscore' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">verified</span><span class="text-label-md">HomiScore</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'applications' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/applications" <%- locals.currentPage === 'applications' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">assignment</span><span class="text-label-md">Applications</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'messages' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/messages" <%- locals.currentPage === 'messages' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">chat_bubble</span><span class="text-label-md">Messages</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'documents' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/documents" <%- locals.currentPage === 'documents' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">description</span><span class="text-label-md">Documents</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-2.5 transition-colors <%= locals.currentPage === 'payments' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %>" href="/user/renter/payments" <%- locals.currentPage === 'payments' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined text-[20px]" aria-hidden="true">account_balance_wallet</span><span class="text-label-md">Payments</span></a>
  </nav>
  <div class="mt-auto flex flex-col gap-1 border-t border-outline-variant pt-4">
    <a class="flex items-center gap-3 rounded-lg px-4 py-3 transition-colors <%= locals.currentPage === 'settings' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>" href="/user/renter/settings" <%- locals.currentPage === 'settings' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined" aria-hidden="true">settings</span><span class="text-label-md">Settings</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-3 transition-colors <%= locals.currentPage === 'support' ? 'bg-primary/10 text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>" href="/user/renter/support" <%- locals.currentPage === 'support' ? 'aria-current="page"' : '' %>><span class="material-symbols-outlined" aria-hidden="true">contact_support</span><span class="text-label-md">Support</span></a>
    <a class="flex items-center gap-3 rounded-lg px-4 py-3 text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface" href="/logout"><span class="material-symbols-outlined" aria-hidden="true">logout</span><span class="text-label-md">Log out</span></a>
  </div>
</aside>
