            class="flex flex-col sm:flex-row items-center justify-between gap-6 py-12 border-t border-outline-variant"
          >
            <a
              class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition font-label-md text-label-md"
              href="/onboarding-landlord"
            >
