    <!-- Footer -->
    <script>
      // Micro-interaction for file inputs and drag/drop visuals
      document.querySelectorAll(".drag-drop-area").forEach((area) => {
        area.addEventListener("dragover", (e) => {
          e.preventDefault();
          area.style.borderColor = "#00236f";
          area.style.backgroundColor = "#dce1ff";
        });
        area.addEventListener("dragleave", () => {
          area.style.borderColor = "#c5c5d3";
          area.style.backgroundColor = "transparent";
        });
      });

      // Simple button activation for radio cards
      document.querySelectorAll('input[type="radio"]').forEach((radio) => {
        radio.addEventListener("change", (e) => {
          document
            .querySelectorAll('input[name="' + e.target.name + '"]')
            .forEach((r) => {
              r.parentElement.classList.remove(
                "bg-primary-fixed",
                "border-primary",
              );
            });
          if (e.target.checked) {
            e.target.parentElement.classList.add(
              "bg-primary-fixed",
              "border-primary",
            );
          }
        });
      });
    </script>

    <script src="/js/main.js"></script>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
