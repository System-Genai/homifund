<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="bg-white font-body-md text-on-surface selection:bg-primary-fixed selection:text-on-primary-fixed">
    <%- include('partials/header') %>
    <main>
      <section class="border-b border-outline-variant bg-surface py-6 sm:py-12 lg:py-20">
        <div class="mx-auto grid max-w-container-max grid-cols-1 items-center gap-9 px-margin-mobile md:px-margin-desktop lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
          <div class="min-w-0">
            <p class="mb-4 text-label-md font-label-md font-semibold text-primary">A clearer landlord workspace</p>
            <h1 class="mb-5 text-headline-xl font-headline-xl text-primary">Manage rental decisions with better context</h1>
            <p class="max-w-xl text-body-lg font-body-lg leading-relaxed text-on-surface-variant">
              Organize properties, applicant information, documents, messages, and
              available payment records without scattering the rental workflow across tools.
            </p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <a class="inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-7 py-3 text-center font-bold text-on-primary transition hover:opacity-90" href="/signup">Create landlord account</a>
              <a class="inline-flex min-h-12 items-center justify-center rounded-lg border border-primary px-7 py-3 text-center font-bold text-primary transition hover:bg-surface-container-low" href="/pricing">View landlord plans</a>
            </div>
          </div>
          <figure class="min-w-0 overflow-hidden rounded-lg border border-outline-variant bg-surface-container-lowest shadow-lg">
            <img
              alt="Modern residential rental building viewed from a landscaped courtyard"
              class="aspect-[16/9] max-h-[300px] w-full object-cover lg:max-h-none lg:aspect-[4/3]"
              decoding="async"
              fetchpriority="high"
              height="1402"
              src="/images/about/rental-building.jpg"
              width="1122"
            />
            <figcaption class="border-t border-outline-variant px-4 py-3 text-body-sm text-secondary">
              Keep property and applicant work connected to the right rental record.
            </figcaption>
          </figure>
        </div>
      </section>

      <section aria-labelledby="applicant-review-heading" class="bg-surface-container-lowest py-12 sm:py-16 lg:py-20">
        <div class="mx-auto grid max-w-container-max grid-cols-1 items-start gap-10 px-margin-mobile md:px-margin-desktop lg:grid-cols-2 lg:gap-16">
          <div class="max-w-xl">
            <p class="mb-3 text-label-md font-semibold text-primary">Applicant review</p>
            <h2 id="applicant-review-heading" class="mb-5 text-headline-lg font-headline-lg text-primary">Review what was provided, then decide</h2>
            <p class="text-body-lg leading-relaxed text-on-surface-variant">
              Bring profile details, application documents, references, and verification
              progress into one review path. HomiScore can provide supporting context,
              but it does not replace your own criteria or guarantee an outcome.
            </p>
            <ul class="mt-7 space-y-4">
              <% [
                ['fact_check', 'Visible verification progress', 'See which requested steps are complete or still awaiting review.'],
                ['description', 'Application documents', 'Keep the files provided for an application close to its status and messages.'],
                ['rule', 'Your decision process', 'Review the information relevant to the property before taking an action.']
              ].forEach(([icon, heading, copy]) => { %>
                <li class="flex gap-4">
                  <span aria-hidden="true" class="hf-icon-tile material-symbols-outlined mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-secondary-container text-primary"><%= icon %></span>
                  <div>
                    <h3 class="font-semibold text-primary"><%= heading %></h3>
                    <p class="mt-1 text-body-md leading-relaxed text-secondary"><%= copy %></p>
                  </div>
                </li>
              <% }) %>
            </ul>
          </div>

          <aside aria-label="Illustrative applicant review summary" class="rounded-lg border border-outline-variant bg-white p-5 shadow-sm sm:p-6">
            <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-outline-variant pb-5">
              <div>
                <p class="mb-1 text-label-sm font-semibold uppercase text-secondary">Example workspace</p>
                <h3 class="text-headline-md font-headline-md text-primary">Application review</h3>
              </div>
              <span class="rounded-md bg-secondary-container px-3 py-1 text-label-sm font-semibold text-primary">In review</span>
            </div>
            <dl class="divide-y divide-outline-variant">
              <% [
                ['Profile details', 'Provided'],
                ['Identity step', 'Awaiting review'],
                ['Supporting documents', '2 files'],
                ['Reference', '1 provided']
              ].forEach(([label, value]) => { %>
                <div class="flex flex-wrap items-center justify-between gap-3 py-4">
                  <dt class="text-body-md text-secondary"><%= label %></dt>
                  <dd class="text-body-md font-semibold text-primary"><%= value %></dd>
                </div>
              <% }) %>
            </dl>
            <p class="mt-4 rounded-lg bg-surface-container-low px-4 py-3 text-body-sm leading-relaxed text-secondary">
              Review and decision actions belong in the authenticated landlord workspace.
            </p>
          </aside>
        </div>
      </section>

      <section aria-labelledby="property-workflow-heading" class="py-12 sm:py-16 lg:py-20">
        <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
          <div class="mx-auto mb-9 max-w-2xl text-center">
            <h2 id="property-workflow-heading" class="mb-4 text-headline-lg font-headline-lg text-primary">Keep each property workflow together</h2>
            <p class="text-body-md leading-relaxed text-on-surface-variant">Move from listing details to applicant review and ongoing records with property context intact.</p>
          </div>
          <ol class="grid grid-cols-1 gap-5 md:grid-cols-3">
            <% [
              ['1', 'Create the property record', 'Add address, listing details, photos or documents, rent, and availability through the guided property flow.'],
              ['2', 'Review listing activity', 'Keep applicant and message activity connected to the property being considered.'],
              ['3', 'Maintain the rental record', 'Organize documents and available payment information after a renter is selected.']
            ].forEach(([number, heading, copy]) => { %>
              <li class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm">
                <span aria-hidden="true" class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"><%= number %></span>
                <h3 class="mb-3 text-headline-md font-headline-md text-primary"><%= heading %></h3>
                <p class="text-body-md leading-relaxed text-secondary"><%= copy %></p>
              </li>
            <% }) %>
          </ol>
        </div>
      </section>

      <section aria-labelledby="landlord-operations-heading" class="bg-primary py-12 text-white sm:py-16 lg:py-20">
        <div class="mx-auto grid max-w-container-max grid-cols-1 gap-8 px-margin-mobile md:px-margin-desktop lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-16">
          <div>
            <h2 id="landlord-operations-heading" class="mb-4 text-headline-lg font-headline-lg">See the operational picture</h2>
            <p class="text-body-lg leading-relaxed text-white/85">
              Where payment services are enabled, the landlord workspace can organize
              schedules, status, and records. Processing and availability depend on the
              connected provider and account setup.
            </p>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <% [
              ['home_work', 'Property context', 'Keep payment and document records associated with the correct property.'],
              ['event', 'Schedule visibility', 'Review dates and amounts shown for the account.'],
              ['receipt_long', 'Status history', 'See available payment status and past records.'],
              ['notifications', 'Follow-up context', 'Use messages and notifications to track items that need attention.']
            ].forEach(([icon, heading, copy]) => { %>
              <div class="rounded-lg border border-white/25 p-5">
                <span aria-hidden="true" class="material-symbols-outlined mb-3"><%= icon %></span>
                <h3 class="mb-2 font-semibold"><%= heading %></h3>
                <p class="text-body-sm leading-relaxed text-white/80"><%= copy %></p>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

      <section aria-labelledby="landlord-trust-heading" class="bg-surface-container-lowest py-12 sm:py-16 lg:py-20">
        <div class="mx-auto grid max-w-container-max grid-cols-1 gap-8 px-margin-mobile md:px-margin-desktop lg:grid-cols-2 lg:items-center lg:gap-16">
          <div>
            <p class="mb-3 text-label-md font-semibold text-primary">Two-way rental context</p>
            <h2 id="landlord-trust-heading" class="mb-5 text-headline-lg font-headline-lg text-primary">Your landlord profile matters too</h2>
            <p class="text-body-lg leading-relaxed text-on-surface-variant">
              A landlord profile can organize identity, property, communication, and
              management context for renters to review. Any HomiScore summary is supporting
              information, not a promise of listing views, tenant quality, or retention.
            </p>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-outline-variant bg-white p-5">
              <span aria-hidden="true" class="material-symbols-outlined mb-3 text-primary">account_circle</span>
              <h3 class="mb-2 font-semibold text-primary">Profile completeness</h3>
              <p class="text-body-md leading-relaxed text-secondary">Keep landlord and property information current and understandable.</p>
            </div>
            <div class="rounded-lg border border-outline-variant bg-white p-5">
              <span aria-hidden="true" class="material-symbols-outlined mb-3 text-primary">forum</span>
              <h3 class="mb-2 font-semibold text-primary">Clear communication</h3>
              <p class="text-body-md leading-relaxed text-secondary">Use the message record to keep rental conversations in context.</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="landlord-faq-heading" class="bg-surface py-12 sm:py-16 lg:py-20">
        <div class="mx-auto max-w-3xl px-margin-mobile md:px-margin-desktop">
          <h2 id="landlord-faq-heading" class="mb-8 text-center text-headline-lg font-headline-lg text-primary">Landlord questions</h2>
          <div class="space-y-3">
            <details class="overflow-hidden rounded-lg border border-outline-variant bg-white" data-disclosure>
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 sm:px-6">
                <span class="font-semibold text-primary">Does HomiScore make an application decision?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <p class="border-t border-outline-variant px-4 py-5 text-body-md leading-relaxed text-secondary sm:px-6">No. HomiScore provides supporting profile context. Landlords remain responsible for applying their own criteria and making the final decision.</p>
            </details>
            <details class="overflow-hidden rounded-lg border border-outline-variant bg-white" data-disclosure>
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 sm:px-6">
                <span class="font-semibold text-primary">Is payment automation available for every account?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <p class="border-t border-outline-variant px-4 py-5 text-body-md leading-relaxed text-secondary sm:px-6">Availability depends on the selected plan, account setup, region, and connected payment provider. Confirm the applicable scope before relying on an automated schedule.</p>
            </details>
            <details class="overflow-hidden rounded-lg border border-outline-variant bg-white" data-disclosure>
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 sm:px-6">
                <span class="font-semibold text-primary">How do I add my first property?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <p class="border-t border-outline-variant px-4 py-5 text-body-md leading-relaxed text-secondary sm:px-6">Create an account, choose the landlord role, complete onboarding, and use the guided property flow for address, listing details, photos or documents, rent, availability, and review.</p>
            </details>
          </div>
          <div class="mt-7 text-center">
            <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 font-semibold text-primary underline underline-offset-4" href="/faqs?category=landlords">View all landlord FAQs</a>
          </div>
        </div>
      </section>

      <section class="border-y border-outline-variant bg-surface-container-lowest py-14 sm:py-16">
        <div class="mx-auto max-w-3xl px-margin-mobile text-center md:px-margin-desktop">
          <h2 class="mb-4 text-headline-lg font-headline-lg text-primary">Set up your landlord workspace</h2>
          <p class="mx-auto mb-7 max-w-2xl text-body-lg text-on-surface-variant">Create an account for standard workflows or contact sales to discuss a tailored plan.</p>
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            <a class="inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-7 py-3 font-bold text-white" href="/signup">Create landlord account</a>
            <a class="inline-flex min-h-12 items-center justify-center rounded-lg border border-primary px-7 py-3 font-bold text-primary" href="/contact#contact-form">Contact sales</a>
          </div>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
