<% const resetErrors = fieldErrors || {}; %>
<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-on-surface">
    <%- include('partials/header') %>
    <main class="flex flex-grow items-center justify-center px-margin-mobile py-10 md:px-margin-desktop md:py-14">
      <div class="w-full max-w-md">
        <div class="mb-7 text-center">
          <span aria-hidden="true" class="material-symbols-outlined mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-secondary-container text-[28px] text-primary">lock_reset</span>
          <h1 class="text-headline-md font-headline-md text-primary">Request a password reset</h1>
          <p class="mt-3 text-body-md leading-relaxed text-on-surface-variant">
            Enter your account email. If it matches an account, HomiFund will send a time-limited reset link.
          </p>
        </div>

        <section aria-labelledby="reset-request-heading" class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-sm sm:p-8">
          <h2 id="reset-request-heading" class="sr-only">Reset request details</h2>
          <form class="space-y-5" action="/forget-password" method="POST" data-submit-feedback data-submit-label="Sending link...">
            <% if (error) { %>
              <div class="rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container" data-focus-feedback role="alert" tabindex="-1"><%= error %></div>
            <% } %>
            <% if (success) { %>
              <div class="rounded-lg bg-secondary-container px-4 py-3 text-body-sm text-on-secondary-container" data-focus-feedback role="status" tabindex="-1"><%= success %></div>
            <% } %>

            <div>
              <label class="mb-2 block text-label-md font-semibold text-on-surface" for="email">Email address</label>
              <div class="relative">
                <span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">mail</span>
                <input
                  aria-invalid="<%= resetErrors.email ? 'true' : 'false' %>"
                  <%- resetErrors.email ? 'aria-describedby="reset-email-error"' : '' %>
                  autocomplete="email"
                  class="min-h-12 w-full rounded-lg border <%= resetErrors.email ? 'border-error' : 'border-outline-variant' %> bg-white py-3 pl-11 pr-4 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                  id="email"
                  maxlength="254"
                  name="email"
                  placeholder="you@example.com"
                  required
                  type="email"
                  value="<%= email || '' %>"
                />
              </div>
              <% if (resetErrors.email) { %><p class="mt-2 text-body-sm text-error" id="reset-email-error"><%= resetErrors.email %></p><% } %>
            </div>

            <button class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-6 py-3 font-bold text-on-primary shadow-sm transition hover:opacity-90 disabled:cursor-wait disabled:opacity-70" type="submit">Send reset link</button>
          </form>

          <div class="mt-7 border-t border-outline-variant pt-6 text-center">
            <a class="inline-flex min-h-11 items-center gap-2 font-semibold text-primary underline-offset-4 hover:underline" href="/login">
              <span aria-hidden="true" class="material-symbols-outlined text-[18px]">arrow_back</span>
              Back to sign in
            </a>
          </div>
        </section>

        <p class="mt-5 text-center text-body-sm text-secondary">
          Need more help?
          <a class="inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4" href="/contact#contact-form">Contact support</a>
        </p>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
