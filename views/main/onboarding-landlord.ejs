<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body
    class="text-on-surface selection:bg-primary-fixed selection:text-on-primary-fixed"
  >
    <%- include('partials/header') %>
    
    <main class="max-w-container-max mx-auto px-margin-desktop py-12">
      <!-- Progress Bar -->
      <div class="mb-12 w-full max-w-4xl mx-auto">
        <div class="relative flex items-center justify-between">
          <div
            class="absolute top-1/2 left-0 w-full h-0.5 bg-surface-container-high -translate-y-1/2 z-0"
          ></div>
          <div
            class="absolute top-1/2 left-0 w-[16%] h-0.5 bg-primary -translate-y-1/2 z-0 transition-all duration-500"
          ></div>
          <!-- Step 1: Active -->
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-label-md shadow-lg border-4 border-surface"
            >
              1
            </div>
            <span
              class="mt-2 font-label-md text-label-md text-primary font-bold"
              >Profile Setup</span
            >
          </div>
          <!-- Step 2 -->
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-10 h-10 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center font-bold text-label-md border-4 border-surface"
            >
              2
            </div>
            <span
              class="mt-2 font-label-md text-label-md text-on-surface-variant font-medium"
              >Verification</span
            >
          </div>
          <!-- Step 3 -->
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-10 h-10 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center font-bold text-label-md border-4 border-surface"
            >
              3
            </div>
            <span
              class="mt-2 font-label-md text-label-md text-on-surface-variant font-medium"
              >HomiScore</span
            >
          </div>
          <!-- Step 4 -->
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-10 h-10 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center font-bold text-label-md border-4 border-surface"
            >
              4
            </div>
            <span
              class="mt-2 font-label-md text-label-md text-on-surface-variant font-medium"
              >Dashboard</span
            >
          </div>
        </div>
      </div>
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-start"
      >
        <!-- Form Area (Left) -->
        <div class="lg:col-span-8 space-y-8">
          <div
            class="bg-surface-container-lowest rounded-xl border border-outline-variant p-8 shadow-[0_4px_12px_rgba(30,58,138,0.04)]"
          >
            <h1 class="font-headline-lg text-headline-lg text-primary mb-2">
              Complete Your Landlord Profile
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant mb-10">
              Provide your portfolio details to establish institutional trust
              within our network.
            </p>
            <form class="space-y-12">
              <!-- Section 1: Identity -->
              <section>
                <div class="flex items-center gap-3 mb-6">
                  <span class="material-symbols-outlined text-primary"
                    >badge</span
                  >
                  <h2 class="font-headline-md text-headline-md text-on-surface">
                    Identity &amp; Professional Profile
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Full Legal Name</label
                    >
                    <input
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                      placeholder="Johnathan Doe"
                      type="text"
                    />
                  </div>
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Landlord Type</label
                    >
                    <select
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                    >
                      <option>Individual</option>
                      <option>Company / Trust</option>
                      <option>Institutional Fund</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Business Name (Optional)</label
                    >
                    <input
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                      placeholder="Doe Property Group LTD"
                      type="text"
                    />
                  </div>
                </div>
              </section>
              <hr class="border-surface-container" />
              <!-- Section 2: Portfolio -->
              <section>
                <div class="flex items-center gap-3 mb-6">
                  <span class="material-symbols-outlined text-primary"
                    >domain</span
                  >
                  <h2 class="font-headline-md text-headline-md text-on-surface">
                    Portfolio &amp; Strategy
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Number of Properties</label
                    >
                    <input
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                      placeholder="e.g. 15"
                      type="number"
                    />
                  </div>
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Primary Locations</label
                    >
                    <input
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                      placeholder="London, Manchester, Birmingham"
                      type="text"
                    />
                  </div>
                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Property Types Managed</label
                    >
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-1">
                      <label
                        class="flex items-center gap-2 cursor-pointer p-3 border border-outline-variant rounded-lg hover:bg-surface transition-colors"
                      >
                        <input
                          class="rounded text-primary focus:ring-primary"
                          type="checkbox"
                        />
                        <span class="font-body-md text-on-surface-variant"
                          >Apartments</span
                        >
                      </label>
                      <label
                        class="flex items-center gap-2 cursor-pointer p-3 border border-outline-variant rounded-lg hover:bg-surface transition-colors"
                      >
                        <input
                          class="rounded text-primary focus:ring-primary"
                          type="checkbox"
                        />
                        <span class="font-body-md text-on-surface-variant"
                          >Houses</span
                        >
                      </label>
                      <label
                        class="flex items-center gap-2 cursor-pointer p-3 border border-outline-variant rounded-lg hover:bg-surface transition-colors"
                      >
                        <input
                          class="rounded text-primary focus:ring-primary"
                          type="checkbox"
                        />
                        <span class="font-body-md text-on-surface-variant"
                          >HMOs</span
                        >
                      </label>
                      <label
                        class="flex items-center gap-2 cursor-pointer p-3 border border-outline-variant rounded-lg hover:bg-surface transition-colors"
                      >
                        <input
                          class="rounded text-primary focus:ring-primary"
                          type="checkbox"
                        />
                        <span class="font-body-md text-on-surface-variant"
                          >Commercial</span
                        >
                      </label>
                    </div>
                  </div>
                </div>
              </section>
              <hr class="border-surface-container" />
              <!-- Section 3: Preferences -->
              <section>
                <div class="flex items-center gap-3 mb-6">
                  <span class="material-symbols-outlined text-primary"
                    >groups</span
                  >
                  <h2 class="font-headline-md text-headline-md text-on-surface">
                    Tenant &amp; Management Preferences
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Preferred Tenant Profile</label
                    >
                    <select
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                    >
                      <option>Working Professionals</option>
                      <option>Students</option>
                      <option>Families</option>
                      <option>Corporate Housing</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Management Style</label
                    >
                    <select
                      class="rounded-lg border-outline-variant p-3 focus:ring-2 focus:ring-primary focus:border-primary font-body-md"
                    >
                      <option>Self-managed</option>
                      <option>Agency-managed</option>
                      <option>Hybrid</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label
                      class="font-label-md text-label-md text-on-surface-variant"
                      >Primary Rental Goal</label
                    >
                    <div class="flex gap-4">
                      <label
                        class="flex-1 flex items-center justify-center gap-2 cursor-pointer p-4 border border-outline-variant rounded-lg hover:border-primary transition-all has-[:checked]:border-primary has-[:checked]:bg-primary-fixed"
                      >
                        <input
                          checked=""
                          class="hidden"
                          name="goal"
                          type="radio"
                        />
                        <span class="font-label-md text-label-md"
                          >High Yield</span
                        >
                      </label>
                      <label
                        class="flex-1 flex items-center justify-center gap-2 cursor-pointer p-4 border border-outline-variant rounded-lg hover:border-primary transition-all has-[:checked]:border-primary has-[:checked]:bg-primary-fixed"
                      >
                        <input class="hidden" name="goal" type="radio" />
                        <span class="font-label-md text-label-md"
                          >Capital Stability</span
                        >
                      </label>
                    </div>
                  </div>
                </div>
              </section>
              <div class="flex flex-col sm:flex-row items-center gap-6 pt-6">
                <a
                  id="landlord-continue-btn"
                  class="w-full sm:w-auto bg-primary text-on-primary px-8 py-4 rounded-lg font-label-md text-label-md font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-all shadow-md active:scale-95"
                  href="dashboards/landlord/dashboard.html"
                >
                  Continue to Verification
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <a
                  class="text-on-surface-variant font-label-md text-label-md font-semibold hover:text-primary transition-colors cursor-pointer"
                  href="/"
                >
                  Save and Finish Later
                </a>
              </div>
            </form>
          </div>
        </div>
        <!-- Sticky Summary Card (Right) -->
        <aside class="lg:col-span-4 sticky top-28 mt-40">
          <div
            class="bg-surface-container-lowest rounded-xl border-2 border-primary/10 overflow-hidden shadow-xl"
          >
            <!-- Card Header -->
            <div
              class="bg-primary p-6 text-on-primary relative overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -mr-16 -mt-16"
              ></div>
              <p
                class="font-label-sm text-label-sm uppercase tracking-widest opacity-80 mb-1"
              >
                Landlord Passport
              </p>
              <div class="flex items-center gap-4 mt-4">
                <div
                  class="w-16 h-16 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary shadow-md"
                >
                  <span class="material-symbols-outlined !text-4xl"
                    >account_circle</span
                  >
                </div>
                <div>
                  <h3
                    class="font-headline-md text-headline-md font-bold leading-tight"
                  >
                    Johnathan Doe
                  </h3>
                  <p class="font-label-md text-label-md opacity-90">
                    Individual Landlord
                  </p>
                </div>
              </div>
            </div>
            <div class="p-6 space-y-6">
              <!-- Progress Section -->
              <div class="space-y-2">
                <div class="flex justify-between items-end">
                  <span
                    class="font-label-md text-label-md text-on-surface-variant"
                    >Profile Progress</span
                  >
                  <span class="font-bold text-primary text-label-md">25%</span>
                </div>
                <div
                  class="w-full h-2 bg-surface-container rounded-full overflow-hidden"
                >
                  <div class="w-1/4 h-full bg-primary rounded-full"></div>
                </div>
                <p class="text-[12px] text-on-surface-variant italic">
                  Step 1 of 4: Profile Setup
                </p>
              </div>
              <!-- Metrics Section -->
              <div class="space-y-3">
                <div
                  class="flex justify-between items-center py-2 border-b border-surface-variant/50"
                >
                  <span
                    class="text-on-surface-variant font-label-md text-label-md"
                    >Portfolio Size</span
                  >
                  <span class="text-on-surface font-semibold font-body-md"
                    >0 Properties</span
                  >
                </div>
                <div
                  class="flex justify-between items-center py-2 border-b border-surface-variant/50"
                >
                  <span
                    class="text-on-surface-variant font-label-md text-label-md"
                    >Operating Region</span
                  >
                  <span
                    class="text-on-surface-variant italic font-body-md text-sm"
                    >Not Selected</span
                  >
                </div>
                <div
                  class="flex justify-between items-center py-2 border-b border-surface-variant/50"
                >
                  <span
                    class="text-on-surface-variant font-label-md text-label-md"
                    >Management Style</span
                  >
                  <span
                    class="text-on-surface-variant italic font-body-md text-sm"
                    >Not Selected</span
                  >
                </div>
                <div
                  class="flex justify-between items-center py-2 border-b border-surface-variant/50"
                >
                  <span
                    class="text-on-surface-variant font-label-md text-label-md"
                    >Tenant Preference</span
                  >
                  <span
                    class="text-on-surface-variant italic font-body-md text-sm"
                    >Not Selected</span
                  >
                </div>
              </div>
              <!-- Verification Status Grid -->
              <div class="grid grid-cols-2 gap-2">
                <div
                  class="p-2 rounded bg-surface-container-low border border-outline-variant/30 flex items-center gap-2"
                >
                  <span class="material-symbols-outlined !text-sm text-outline"
                    >pending</span
                  >
                  <span
                    class="text-[11px] font-bold uppercase tracking-tighter text-on-surface-variant"
                    >Identity</span
                  >
                </div>
                <div
                  class="p-2 rounded bg-surface-container-low border border-outline-variant/30 flex items-center gap-2"
                >
                  <span class="material-symbols-outlined !text-sm text-outline"
                    >pending</span
                  >
                  <span
                    class="text-[11px] font-bold uppercase tracking-tighter text-on-surface-variant"
                    >Property</span
                  >
                </div>
                <div
                  class="p-2 rounded bg-surface-container-low border border-outline-variant/30 flex items-center gap-2"
                >
                  <span class="material-symbols-outlined !text-sm text-outline"
                    >pending</span
                  >
                  <span
                    class="text-[11px] font-bold uppercase tracking-tighter text-on-surface-variant"
                    >Business</span
                  >
                </div>
                <div
                  class="p-2 rounded bg-surface-container-low border border-outline-variant/30 flex items-center gap-2"
                >
                  <span class="material-symbols-outlined !text-sm text-outline"
                    >pending</span
                  >
                  <span
                    class="text-[11px] font-bold uppercase tracking-tighter text-on-surface-variant"
                    >Payment</span
                  >
                </div>
              </div>
              <!-- Trust Score Explainer -->
              <div
                class="bg-primary-container/10 p-4 rounded-lg border border-primary/10"
              >
                <div class="flex gap-3">
                  <span class="material-symbols-outlined text-primary !text-xl"
                    >verified_user</span
                  >
                  <div class="space-y-1">
                    <p
                      class="font-label-md text-label-md font-bold text-primary"
                    >
                      Institutional Trust Score
                    </p>
                    <p
                      class="font-body-md text-[13px] leading-relaxed text-on-surface-variant"
                    >
                      Complete verification to unlock your HomiScore Profile and
                      improve visibility to high-quality tenants.
                    </p>
                  </div>
                </div>
              </div>
              <!-- Benefits Section -->
              <div class="pt-2">
                <p
                  class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-3"
                >
                  Verification Benefits
                </p>
                <ul class="space-y-2">
                  <li
                    class="flex items-center gap-2 text-[13px] text-on-surface-variant"
                  >
                    <span
                      class="material-symbols-outlined text-primary !text-sm"
                      >check_circle</span
                    >
                    Verified Landlord Badge
                  </li>
                  <li
                    class="flex items-center gap-2 text-[13px] text-on-surface-variant"
                  >
                    <span
                      class="material-symbols-outlined text-primary !text-sm"
                      >check_circle</span
                    >
                    Priority Listing Visibility
                  </li>
                  <li
                    class="flex items-center gap-2 text-[13px] text-on-surface-variant"
                  >
                    <span
                      class="material-symbols-outlined text-primary !text-sm"
                      >check_circle</span
                    >
                    Higher Tenant Match Quality
                  </li>
                </ul>
              </div>
              <div class="pt-4 text-center border-t border-surface-variant/50">
                <p class="font-label-sm text-label-sm text-outline">
                  Verified Member ID: HF-LL-000000
                </p>
              </div>
            </div>
          </div>
          <!-- Trust Badges -->
          <div class="mt-6 flex justify-center gap-6 grayscale opacity-40">
            <div class="flex flex-col items-center gap-1">
              <span class="material-symbols-outlined !text-4xl">security</span>
              <span class="font-label-sm text-[10px] uppercase">AES-256</span>
            </div>
            <div class="flex flex-col items-center gap-1">
              <span class="material-symbols-outlined !text-4xl">verified</span>
              <span class="font-label-sm text-[10px] uppercase">AML/KYC</span>
            </div>
            <div class="flex flex-col items-center gap-1">
              <span class="material-symbols-outlined !text-4xl"
                >cloud_done</span
              >
              <span class="font-label-sm text-[10px] uppercase">SOC2</span>
            </div>
          </div>
        </aside>
      </div>
    </main>
    <!-- Footer -->
    <script>
      // Simple interactivity for form fields to show 'live' feedback in the summary card (mockup)
      const inputs = document.querySelectorAll("input, select");
      inputs.forEach((input) => {
        input.addEventListener("change", () => {
          // Future implementation: update summary card values
          console.log("Update summary card with:", input.value);
        });
      });
    </script>

    <script>
      const landlordContinueBtn = document.getElementById(
        "landlord-continue-btn",
      );
      if (landlordContinueBtn) {
        landlordContinueBtn.addEventListener("click", (event) => {
          event.preventDefault();
          window.location.href = "dashboards/landlord/dashboard";
        });
      }
    </script>
    <script src="/js/main.js"></script>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
