<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-on-surface hf-public-page">
    <% const landlordForm = typeof form === 'object' && form ? form : {}; %>
    <% const landlordErrors = typeof fieldErrors === 'object' && fieldErrors ? fieldErrors : {}; %>
    <% const selectedPropertyTypes = Array.isArray(landlordForm.propertyTypes) ? landlordForm.propertyTypes : []; %>
    <%- include('partials/header') %>

    <main class="mx-auto w-full max-w-6xl flex-grow px-margin-mobile py-8 md:px-margin-desktop md:py-12">
      <nav class="hf-auth-stepper mx-auto mb-8 max-w-3xl md:mb-10" aria-label="Landlord onboarding progress">
        <ol class="hf-auth-stepper-list" role="list">
          <li class="hf-auth-stepper-step is-current" aria-current="step">
            <span class="hf-auth-stepper-marker">1</span>
            <span class="hf-auth-stepper-label">Profile</span>
          </li>
          <li class="hf-auth-stepper-step">
            <span class="hf-auth-stepper-marker">2</span>
            <span class="hf-auth-stepper-label">Verification</span>
          </li>
          <li class="hf-auth-stepper-step">
            <span class="hf-auth-stepper-marker">3</span>
            <span class="hf-auth-stepper-label">Finish</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-8">
          <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-sm sm:p-8">
            <div class="mb-8">
              <p class="mb-2 text-label-md font-bold text-secondary">Step 1 of 3</p>
              <h1 class="mb-3 text-headline-lg font-bold text-primary">Set up your landlord profile</h1>
              <p class="max-w-2xl text-body-md text-on-surface-variant">
                Add the account and portfolio details used to organize your landlord workspace.
                Fields marked required must be complete before verification.
              </p>
            </div>

            <% if (error) { %>
              <div
                class="mb-6 rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container"
                data-focus-feedback
                role="alert"
                tabindex="-1"
              ><%= error %></div>
            <% } else if (success) { %>
              <div
                class="mb-6 rounded-lg bg-secondary-container px-4 py-3 text-body-sm text-on-secondary-container"
                data-focus-feedback
                role="status"
                tabindex="-1"
              ><%= success %></div>
            <% } %>

            <form action="/onboarding-landlord" method="POST" data-submit-feedback>
              <section class="border-b border-outline-variant pb-8" aria-labelledby="landlord-account-heading">
                <div class="mb-6 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">badge</span>
                  <h2 id="landlord-account-heading" class="text-headline-md font-bold text-on-surface">Account details</h2>
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="legalName">Legal name <span class="text-error">*</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="legalName"
                      name="legalName"
                      type="text"
                      autocomplete="name"
                      maxlength="120"
                      required
                      value="<%= landlordForm.legalName || '' %>"
                      aria-invalid="<%= landlordErrors.legalName ? 'true' : 'false' %>"
                      <%- landlordErrors.legalName ? 'aria-describedby="legalName-error"' : '' %>
                    />
                    <% if (landlordErrors.legalName) { %><p class="text-body-sm text-error" id="legalName-error"><%= landlordErrors.legalName %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="landlordType">Account type <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="landlordType"
                      name="landlordType"
                      required
                      aria-invalid="<%= landlordErrors.landlordType ? 'true' : 'false' %>"
                      <%- landlordErrors.landlordType ? 'aria-describedby="landlordType-error"' : '' %>
                    >
                      <option value="">Choose an account type</option>
                      <option value="individual" <%= landlordForm.landlordType === 'individual' ? 'selected' : '' %>>Individual</option>
                      <option value="company" <%= landlordForm.landlordType === 'company' ? 'selected' : '' %>>Company</option>
                      <option value="partnership" <%= landlordForm.landlordType === 'partnership' ? 'selected' : '' %>>Partnership or trust</option>
                    </select>
                    <% if (landlordErrors.landlordType) { %><p class="text-body-sm text-error" id="landlordType-error"><%= landlordErrors.landlordType %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label class="font-label-md font-bold text-on-surface" for="businessName">Business name <span class="font-normal text-on-surface-variant">(optional)</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="businessName"
                      name="businessName"
                      type="text"
                      autocomplete="organization"
                      maxlength="120"
                      value="<%= landlordForm.businessName || '' %>"
                      aria-invalid="<%= landlordErrors.businessName ? 'true' : 'false' %>"
                      <%- landlordErrors.businessName ? 'aria-describedby="businessName-error"' : '' %>
                    />
                    <% if (landlordErrors.businessName) { %><p class="text-body-sm text-error" id="businessName-error"><%= landlordErrors.businessName %></p><% } %>
                  </div>
                </div>
              </section>

              <section class="border-b border-outline-variant py-8" aria-labelledby="landlord-portfolio-heading">
                <div class="mb-6 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">domain</span>
                  <h2 id="landlord-portfolio-heading" class="text-headline-md font-bold text-on-surface">Portfolio details</h2>
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="propertyCount">Properties managed <span class="text-error">*</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="propertyCount"
                      name="propertyCount"
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max="100000"
                      step="1"
                      required
                      value="<%= landlordForm.propertyCount ?? '' %>"
                      aria-invalid="<%= landlordErrors.propertyCount ? 'true' : 'false' %>"
                      <%- landlordErrors.propertyCount ? 'aria-describedby="propertyCount-error"' : '' %>
                    />
                    <% if (landlordErrors.propertyCount) { %><p class="text-body-sm text-error" id="propertyCount-error"><%= landlordErrors.propertyCount %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="primaryLocations">Operating locations <span class="text-error">*</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="primaryLocations"
                      name="primaryLocations"
                      type="text"
                      maxlength="250"
                      required
                      value="<%= landlordForm.primaryLocations || '' %>"
                      aria-invalid="<%= landlordErrors.primaryLocations ? 'true' : 'false' %>"
                      aria-describedby="<%= landlordErrors.primaryLocations ? 'primaryLocations-help primaryLocations-error' : 'primaryLocations-help' %>"
                    />
                    <p class="text-body-sm text-on-surface-variant" id="primaryLocations-help">Enter cities or regions separated by commas.</p>
                    <% if (landlordErrors.primaryLocations) { %><p class="text-body-sm text-error" id="primaryLocations-error"><%= landlordErrors.primaryLocations %></p><% } %>
                  </div>

                  <fieldset class="md:col-span-2" aria-describedby="<%= landlordErrors.propertyTypes ? 'propertyTypes-error' : '' %>">
                    <legend class="mb-3 font-label-md font-bold text-on-surface">Property types <span class="text-error">*</span></legend>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                      <% [['apartments', 'Apartments'], ['houses', 'Houses'], ['hmos', 'Shared homes (HMOs)'], ['commercial', 'Commercial property']].forEach(([value, label]) => { %>
                        <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-outline-variant px-4 py-3 transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary-fixed">
                          <input class="h-5 w-5 accent-primary" name="propertyTypes" type="checkbox" value="<%= value %>" <%= selectedPropertyTypes.includes(value) ? 'checked' : '' %> />
                          <span class="text-body-md text-on-surface"><%= label %></span>
                        </label>
                      <% }) %>
                    </div>
                    <% if (landlordErrors.propertyTypes) { %><p class="mt-2 text-body-sm text-error" id="propertyTypes-error"><%= landlordErrors.propertyTypes %></p><% } %>
                  </fieldset>
                </div>
              </section>

              <section class="pt-8" aria-labelledby="landlord-preferences-heading">
                <div class="mb-6 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">tune</span>
                  <h2 id="landlord-preferences-heading" class="text-headline-md font-bold text-on-surface">Workspace preferences</h2>
                </div>
                <div class="grid grid-cols-1 gap-6">
                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="managementStyle">Management style <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="managementStyle"
                      name="managementStyle"
                      required
                      aria-invalid="<%= landlordErrors.managementStyle ? 'true' : 'false' %>"
                      <%- landlordErrors.managementStyle ? 'aria-describedby="managementStyle-error"' : '' %>
                    >
                      <option value="">Choose a management style</option>
                      <option value="self-managed" <%= landlordForm.managementStyle === 'self-managed' ? 'selected' : '' %>>Self-managed</option>
                      <option value="agency-managed" <%= landlordForm.managementStyle === 'agency-managed' ? 'selected' : '' %>>Managed by an agency</option>
                      <option value="hybrid" <%= landlordForm.managementStyle === 'hybrid' ? 'selected' : '' %>>A mix of both</option>
                    </select>
                    <% if (landlordErrors.managementStyle) { %><p class="text-body-sm text-error" id="managementStyle-error"><%= landlordErrors.managementStyle %></p><% } %>
                  </div>

                  <fieldset aria-describedby="<%= landlordErrors.primaryGoal ? 'primaryGoal-error' : '' %>">
                    <legend class="mb-3 font-label-md font-bold text-on-surface">First workspace goal <span class="text-error">*</span></legend>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                      <% [['manage-properties', 'Manage properties'], ['review-applicants', 'Review applicants'], ['organize-rent', 'Organize rent records']].forEach(([value, label]) => { %>
                        <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-outline-variant px-4 py-3 transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary-fixed">
                          <input class="h-5 w-5 shrink-0 accent-primary" name="primaryGoal" type="radio" value="<%= value %>" required <%= landlordForm.primaryGoal === value ? 'checked' : '' %> />
                          <span class="text-body-sm font-bold text-on-surface"><%= label %></span>
                        </label>
                      <% }) %>
                    </div>
                    <% if (landlordErrors.primaryGoal) { %><p class="mt-2 text-body-sm text-error" id="primaryGoal-error"><%= landlordErrors.primaryGoal %></p><% } %>
                  </fieldset>
                </div>
              </section>

              <div class="mt-8 flex flex-col gap-3 border-t border-outline-variant pt-6 sm:flex-row">
                <button
                  class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-primary px-6 font-label-md font-bold text-on-primary transition-colors hover:bg-primary-container disabled:cursor-wait disabled:opacity-70"
                  name="intent"
                  type="submit"
                  value="continue"
                  data-pending-label="Saving profile..."
                >
                  Continue to verification
                  <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>
                </button>
                <button
                  class="inline-flex min-h-12 items-center justify-center rounded-lg border border-outline-variant px-6 font-label-md font-bold text-primary transition-colors hover:bg-surface-container-low disabled:cursor-wait disabled:opacity-70"
                  name="intent"
                  type="submit"
                  value="draft"
                  formnovalidate
                  data-pending-label="Saving draft..."
                >Save draft</button>
              </div>
            </form>
          </div>
        </div>

        <aside class="lg:sticky lg:top-28 lg:col-span-4" aria-labelledby="onboarding-next-heading">
          <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm">
            <p class="mb-2 text-label-sm font-bold uppercase text-secondary">Your setup</p>
            <h2 id="onboarding-next-heading" class="mb-4 text-headline-md font-bold text-primary">What happens next</h2>
            <ol class="space-y-5" role="list">
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">1</span>
                <div><p class="font-bold text-on-surface">Save this profile</p><p class="mt-1 text-body-sm text-on-surface-variant">Your answers are stored on your account and can be updated later.</p></div>
              </li>
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-sm font-bold text-on-surface-variant">2</span>
                <div><p class="font-bold text-on-surface">Review verification</p><p class="mt-1 text-body-sm text-on-surface-variant">The next screen explains the information requested before you submit anything.</p></div>
              </li>
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-sm font-bold text-on-surface-variant">3</span>
                <div><p class="font-bold text-on-surface">Open your workspace</p><p class="mt-1 text-body-sm text-on-surface-variant">Use the dashboard to manage the records available for your account.</p></div>
              </li>
            </ol>
            <div class="mt-6 border-t border-outline-variant pt-5">
              <p class="flex items-start gap-2 text-body-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">info</span>
                Save draft lets you leave required fields incomplete and resume from this page later.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
