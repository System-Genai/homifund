<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="bg-surface text-on-surface flex flex-col min-h-screen">
    <%- include('partials/header') %>
    <main class="flex-grow flex items-center justify-center px-4 py-12">
      <div class="text-center">
        <div class="text-primary font-headline-xl text-headline-xl mb-4">
          404
        </div>
        <h1 class="font-headline-lg text-headline-lg text-primary mb-4">
          Page Not Found
        </h1>
        <p
          class="font-body-md text-body-md text-secondary mb-8 max-w-md mx-auto"
        >
          The page you're looking for doesn't exist or has been moved. Let us
          help you find your way home.
        </p>
        <a
          href="/"
          class="bg-primary text-on-primary px-8 py-3 rounded-lg font-label-md text-label-md hover:opacity-90 transition-all inline-flex items-center gap-2"
        >
          <span class="material-symbols-outlined">home</span>
          Back to Home
        </a>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
