<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="bg-background text-on-surface antialiased">
    <%- include('partials/header') %>
    <main data-faq-explorer>
      <section
        class="border-b border-outline-variant bg-surface-container-lowest py-14 sm:py-20 lg:py-24"
      >
        <div class="mx-auto max-w-3xl px-margin-mobile md:px-margin-desktop text-center">
          <h1 class="mb-5 text-headline-xl font-headline-xl text-primary">
            Frequently Asked Questions
          </h1>
          <p class="mx-auto mb-9 max-w-2xl text-body-lg font-body-lg text-secondary">
            Find practical guidance about accounts, renter and landlord workflows,
            HomiScore, payments, and privacy.
          </p>

          <form class="mx-auto max-w-xl text-left" role="search" data-faq-search-form>
            <label
              class="mb-2 block text-label-md font-label-md font-semibold text-on-surface"
              for="faq-search"
            >
              Search FAQs
            </label>
            <div
              class="flex min-h-12 items-center rounded-lg border border-outline-variant bg-white px-4 shadow-sm transition focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20"
            >
              <span
                aria-hidden="true"
                class="material-symbols-outlined mr-3 shrink-0 text-outline"
                data-icon="search"
                >search</span
              >
              <input
                id="faq-search"
                class="min-w-0 flex-1 border-0 bg-transparent py-3 text-body-md font-body-md text-on-surface outline-none placeholder:text-outline focus:ring-0"
                maxlength="120"
                name="q"
                placeholder="Search questions"
                type="search"
                autocomplete="off"
                data-faq-search
              />
              <button
                aria-label="Clear FAQ search"
                class="ml-2 inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-secondary transition hover:bg-surface-container focus-visible:outline-none"
                hidden
                title="Clear search"
                type="button"
                data-faq-clear
              >
                <span aria-hidden="true" class="material-symbols-outlined">close</span>
              </button>
            </div>
          </form>
        </div>
      </section>

      <section aria-labelledby="faq-topics-heading" class="border-b border-outline-variant bg-surface py-5">
        <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
          <h2 id="faq-topics-heading" class="sr-only">Filter by topic</h2>
          <div
            aria-label="FAQ topics"
            class="flex gap-2 overflow-x-auto pb-1 md:justify-center"
            role="group"
            data-faq-categories
          >
            <% [
              ['all', 'All topics'],
              ['general', 'General'],
              ['renters', 'For renters'],
              ['landlords', 'For landlords'],
              ['security', 'Security and trust']
            ].forEach(([value, label]) => { %>
              <button
                aria-pressed="<%= value === 'all' ? 'true' : 'false' %>"
                class="min-h-11 shrink-0 rounded-md border border-outline-variant bg-white px-4 py-2 text-label-md font-label-md font-semibold text-on-surface-variant transition hover:border-primary hover:text-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white"
                type="button"
                data-faq-category="<%= value %>"
              >
                <%= label %>
              </button>
            <% }) %>
          </div>
        </div>
      </section>

      <section aria-labelledby="faq-results-heading" class="bg-background py-12 sm:py-16 lg:py-20">
        <div class="mx-auto max-w-3xl px-margin-mobile md:px-margin-desktop">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-2">
            <h2 id="faq-results-heading" class="text-headline-md font-headline-md text-primary">
              Answers
            </h2>
            <p class="text-body-sm font-body-sm text-secondary" aria-live="polite" data-faq-status>
              8 results
            </p>
          </div>

          <div class="space-y-3" data-faq-list>
            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="general"
              open
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">What is HomiFund?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                HomiFund brings renter profiles, property workflows, applications,
                documents, messages, and payment records into one rental workspace.
                Available actions depend on whether an account is set up as a renter
                or a landlord.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="general"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">What is a HomiScore?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                HomiScore is a profile summary intended to make relevant rental
                information easier to review. The information shown can include
                profile completion, payment records, references, and verification
                progress. It is supporting context, not a guarantee of approval or
                future behavior.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="renters"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">How do renters get started?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                Create an account, choose the renter role, and complete the requested
                profile and verification steps. You can then use the renter workspace
                to review properties, applications, documents, messages, and payment
                records available to your account.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="renters"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">Does HomiFund guarantee an application will be approved?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                No. Application decisions remain with the landlord or property
                manager. A complete profile can make information easier to review,
                but it does not guarantee approval.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="landlords"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">How do landlords use the platform?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                Landlord accounts can organize property listings, review available
                applicant information, manage documents and messages, and track the
                payment records shown in their workspace.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="landlords"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">How does rent collection work?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                Where payment collection is enabled for an account, the workspace can
                show scheduled amounts, due dates, and payment status. Processing time
                and availability depend on the connected payment service and account
                setup, so confirm those details before relying on a schedule.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="security"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">Who can access my workspace?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                Authenticated workspaces are separated by account role, and protected
                routes require the matching renter or landlord role. Keep your login
                private, sign out on shared devices, and contact support if you suspect
                unauthorized access.
              </div>
            </details>

            <details
              class="group overflow-hidden rounded-lg border border-outline-variant bg-white shadow-sm open:border-primary/40"
              data-faq-item
              data-faq-topic="security"
            >
              <summary class="faq-summary flex min-h-14 cursor-pointer items-center justify-between gap-4 px-4 py-4 text-left sm:px-6">
                <span class="text-body-lg font-semibold text-primary">How should I handle sensitive information?</span>
                <span aria-hidden="true" class="faq-chevron material-symbols-outlined shrink-0 text-primary transition-transform">expand_more</span>
              </summary>
              <div class="border-t border-outline-variant px-4 py-5 text-body-md font-body-md leading-relaxed text-secondary sm:px-6">
                Use the relevant document or account workflow instead of placing bank,
                identity, or other sensitive details in a general message. Review what
                you are sharing before submitting it and contact support when you are
                unsure which workflow to use.
              </div>
            </details>
          </div>

          <div
            class="mt-6 rounded-lg border border-dashed border-outline bg-surface-container-lowest px-5 py-8 text-center"
            hidden
            data-faq-empty
          >
            <h3 class="mb-2 text-body-lg font-semibold text-primary">No matching answers</h3>
            <p class="mb-5 text-body-md text-secondary">Try a broader search or clear the topic filter.</p>
            <button class="min-h-11 rounded-md border border-primary px-5 font-semibold text-primary" type="button" data-faq-reset>
              Show all topics
            </button>
          </div>
        </div>
      </section>

      <section class="border-y border-outline-variant bg-primary py-14 text-on-primary sm:py-16">
        <div class="mx-auto max-w-2xl px-margin-mobile text-center md:px-margin-desktop">
          <h2 class="mb-4 text-headline-lg font-headline-lg">Still need help?</h2>
          <p class="mx-auto mb-7 max-w-xl text-body-lg font-body-lg text-white/85">
            Send the support team your question and the account area you were using.
            Response times depend on support availability.
          </p>
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-7 py-3 font-bold text-primary transition hover:bg-surface-container-lowest"
            href="/contact#contact-form"
          >
            Contact support
          </a>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
