<% const loginForm = form || {}; const loginErrors = fieldErrors || {}; %>
<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-on-surface">
    <%- include('partials/header') %>
    <main class="flex flex-grow items-center justify-center px-margin-mobile py-10 md:px-margin-desktop md:py-14">
      <div class="w-full max-w-md">
        <div class="mb-7 text-center">
          <p class="mb-2 text-label-md font-semibold text-primary">Your rental workspace</p>
          <h1 class="text-headline-lg font-headline-lg text-primary">Welcome back</h1>
          <p class="mt-3 text-body-md text-on-surface-variant">Sign in with the email and password for your account.</p>
        </div>

        <section aria-labelledby="login-form-heading" class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-sm sm:p-8">
          <h2 id="login-form-heading" class="sr-only">Sign-in details</h2>

          <form id="login-form" class="space-y-5" action="/login" method="POST" data-submit-feedback data-submit-label="Signing in...">
            <% if (returnTo) { %>
              <input type="hidden" name="returnTo" value="<%= returnTo %>" />
            <% } %>

            <% if (error) { %>
              <div class="rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container" data-focus-feedback role="alert" tabindex="-1"><%= error %></div>
            <% } %>
            <% if (notice) { %>
              <div class="rounded-lg bg-secondary-container px-4 py-3 text-body-sm text-on-secondary-container" data-focus-feedback role="status" tabindex="-1"><%= notice %></div>
            <% } %>

            <div>
              <label class="mb-2 block text-label-md font-semibold text-on-surface" for="email">Email address</label>
              <input
                aria-invalid="<%= loginErrors.email ? 'true' : 'false' %>"
                <%- loginErrors.email ? 'aria-describedby="login-email-error"' : '' %>
                autocomplete="email"
                class="min-h-12 w-full rounded-lg border <%= loginErrors.email ? 'border-error' : 'border-outline-variant' %> bg-white px-4 py-3 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                id="email"
                maxlength="254"
                name="email"
                placeholder="you@example.com"
                required
                type="email"
                value="<%= loginForm.email || '' %>"
              />
              <% if (loginErrors.email) { %><p class="mt-2 text-body-sm text-error" id="login-email-error"><%= loginErrors.email %></p><% } %>
            </div>

            <div>
              <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                <label class="text-label-md font-semibold text-on-surface" for="password">Password</label>
                <a class="inline-flex min-h-11 items-center text-label-sm font-semibold text-primary underline-offset-4 hover:underline" href="/forget-password">Forgot password?</a>
              </div>
              <div class="relative">
                <input
                  aria-invalid="<%= loginErrors.password ? 'true' : 'false' %>"
                  <%- loginErrors.password ? 'aria-describedby="login-password-error"' : '' %>
                  autocomplete="current-password"
                  class="min-h-12 w-full rounded-lg border <%= loginErrors.password ? 'border-error' : 'border-outline-variant' %> bg-white py-3 pl-4 pr-14 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                  id="password"
                  maxlength="128"
                  name="password"
                  required
                  type="password"
                />
                <button
                  aria-controls="password"
                  aria-label="Show password"
                  aria-pressed="false"
                  class="absolute right-1 top-1/2 inline-flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-md text-secondary transition hover:bg-surface-container-low hover:text-primary"
                  title="Show password"
                  type="button"
                  data-password-toggle="password"
                ><span aria-hidden="true" class="material-symbols-outlined">visibility</span></button>
              </div>
              <% if (loginErrors.password) { %><p class="mt-2 text-body-sm text-error" id="login-password-error"><%= loginErrors.password %></p><% } %>
            </div>

            <button class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-6 py-3 font-bold text-on-primary shadow-sm transition hover:opacity-90 disabled:cursor-wait disabled:opacity-70" type="submit">Sign in</button>
          </form>

          <div class="mt-7 border-t border-outline-variant pt-6 text-center">
            <p class="text-label-md text-on-surface-variant">
              Need an account?
              <a class="inline-flex min-h-11 items-center font-bold text-primary underline-offset-4 hover:underline" href="/signup">Create one</a>
            </p>
          </div>
        </section>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
