<!-- Public Header / Navbar -->
<header
  class="w-full top-0 sticky bg-surface dark:bg-surface-dim border-b border-outline-variant dark:border-outline shadow-sm z-50"
>
  <div
    class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max mx-auto"
  >
    <a
      class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed cursor-pointer transition-opacity active:opacity-80"
      href="/"
      >HomiFund</a
    >
    <nav class="hidden md:flex space-x-8">
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/renters"
        >Renters</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/landlords"
        >Landlords</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/contact"
        >Contact</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/about"
        >About Us</a
      >
    </nav>
    <div class="flex items-center space-x-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span class="hidden lg:inline text-body-sm text-on-surface-variant">
          Signed in as <strong class="font-semibold text-on-surface"><%= currentUser.email %></strong>
        </span>
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-outline-variant px-4 font-body-md font-bold text-primary transition-colors hover:bg-surface-container-low"
          href="/logout"
          >Sign out</a
        >
      <% } else { %>
        <a
          class="font-body-md text-body-md text-primary dark:text-primary-fixed font-bold cursor-pointer"
          href="/login"
          >Login</a
        >
        <a
          class="font-body-md text-body-md bg-primary text-on-primary px-6 py-2 rounded-lg hover:opacity-90 transition-all"
          href="/signup"
          >Sign Up</a
        >
      <% } %>
    </div>
  </div>
</header>
