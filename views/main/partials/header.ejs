<!-- Public Header / Navbar : responsive -->
<header
  class="w-full top-0 sticky bg-surface dark:bg-surface-dim border-b border-outline-variant dark:border-outline shadow-sm z-50"
>
  <div
    class="flex justify-between items-center gap-3 px-4 sm:px-6 lg:px-margin-desktop py-3 md:py-4 max-w-container-max mx-auto"
  >
    <a
      class="font-headline-md text-xl sm:text-headline-md font-bold text-primary dark:text-primary-fixed cursor-pointer transition-opacity active:opacity-80 shrink-0"
      href="/"
      >HomiFund</a
    >

    <!-- Desktop nav -->
    <nav class="hidden md:flex md:gap-6 lg:gap-8">
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/renters"
        >Renters</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/landlords"
        >Landlords</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/contact"
        >Contact</a
      >
      <a
        class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed transition-colors"
        href="/about"
        >About Us</a
      >
    </nav>

    <!-- Desktop actions -->
    <div class="hidden md:flex items-center gap-4 shrink-0">
      <a
        class="font-body-md text-body-md text-primary dark:text-primary-fixed font-bold border-b-2 border-primary cursor-pointer"
        href="/login"
        >Login</a
      >
      <a
        class="font-body-md text-body-md bg-primary text-on-primary px-5 lg:px-6 py-2 rounded-lg hover:opacity-90 transition-all whitespace-nowrap"
        href="/signup"
        >Sign Up</a
      >
    </div>

    <!-- Mobile actions -->
    <div class="flex md:hidden items-center gap-2 shrink-0">
      <a
        class="text-label-md font-bold bg-primary text-on-primary px-4 py-2 rounded-lg active:opacity-80 transition-opacity whitespace-nowrap"
        href="/signup"
        >Sign Up</a
      >
      <button
        id="publicNavToggle"
        type="button"
        aria-label="Open menu"
        aria-controls="publicNavPanel"
        aria-expanded="false"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-primary hover:bg-surface-container-low active:scale-95 transition-transform"
      >
        <span
          id="publicNavToggleIcon"
          class="material-symbols-outlined text-[26px]"
          >menu</span
        >
      </button>
    </div>
  </div>

  <!-- Mobile dropdown panel -->
  <div
    id="publicNavPanel"
    class="hidden md:hidden border-t border-outline-variant bg-surface dark:bg-surface-dim px-4 py-3"
  >
    <nav class="flex flex-col">
      <a
        class="py-3 text-body-md text-on-surface-variant hover:text-primary border-b border-outline-variant/60 transition-colors"
        href="/renters"
        >Renters</a
      >
      <a
        class="py-3 text-body-md text-on-surface-variant hover:text-primary border-b border-outline-variant/60 transition-colors"
        href="/landlords"
        >Landlords</a
      >
      <a
        class="py-3 text-body-md text-on-surface-variant hover:text-primary border-b border-outline-variant/60 transition-colors"
        href="/pricing"
        >Pricing</a
      >
      <a
        class="py-3 text-body-md text-on-surface-variant hover:text-primary border-b border-outline-variant/60 transition-colors"
        href="/contact"
        >Contact</a
      >
      <a
        class="py-3 text-body-md text-on-surface-variant hover:text-primary border-b border-outline-variant/60 transition-colors"
        href="/about"
        >About Us</a
      >
      <a
        class="mt-3 py-3 text-center text-body-md font-bold text-primary border border-primary rounded-lg"
        href="/login"
        >Login</a
      >
    </nav>
  </div>
</header>

<script>
  (function () {
    var btn = document.getElementById("publicNavToggle");
    var panel = document.getElementById("publicNavPanel");
    var icon = document.getElementById("publicNavToggleIcon");
    if (!btn || !panel) return;
    btn.addEventListener("click", function () {
      var open = panel.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      if (icon) icon.textContent = open ? "close" : "menu";
    });
    window.addEventListener("resize", function () {
      if (window.innerWidth >= 768) {
        panel.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        if (icon) icon.textContent = "menu";
      }
    });
  })();
</script>
