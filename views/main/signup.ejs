<% const signupForm = form || {}; const signupErrors = fieldErrors || {}; %>
<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-on-surface">
    <%- include('partials/header') %>
    <main class="flex flex-grow items-center justify-center px-margin-mobile py-10 md:px-margin-desktop md:py-14">
      <div class="w-full max-w-[480px]">
        <div class="mb-7 text-center">
          <p class="mb-2 text-label-md font-semibold text-primary">Start with one account</p>
          <h1 class="text-headline-lg font-headline-lg text-primary">Create your HomiFund account</h1>
          <p class="mt-3 text-body-md text-on-surface-variant">
            You will choose a renter or landlord workspace after signup.
          </p>
        </div>

        <section aria-labelledby="signup-form-heading" class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-sm sm:p-8">
          <h2 id="signup-form-heading" class="sr-only">Account details</h2>

          <form
            id="signup-form"
            class="space-y-5"
            action="/signup"
            method="POST"
            data-submit-feedback
            data-submit-label="Creating account..."
          >
            <% if (error) { %>
              <div
                class="rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container"
                data-focus-feedback
                role="alert"
                tabindex="-1"
              >
                <%= error %>
              </div>
            <% } %>

            <div>
              <label class="mb-2 block text-label-sm font-semibold text-on-surface-variant" for="full_name">
                Full name
              </label>
              <input
                aria-invalid="<%= signupErrors.full_name ? 'true' : 'false' %>"
                <%- signupErrors.full_name ? 'aria-describedby="full-name-error"' : '' %>
                autocomplete="name"
                class="min-h-12 w-full rounded-lg border <%= signupErrors.full_name ? 'border-error' : 'border-outline-variant' %> bg-surface px-4 py-3 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                id="full_name"
                maxlength="120"
                minlength="2"
                name="full_name"
                placeholder="Your full name"
                required
                type="text"
                value="<%= signupForm.full_name || '' %>"
              />
              <% if (signupErrors.full_name) { %>
                <p class="mt-2 text-body-sm text-error" id="full-name-error"><%= signupErrors.full_name %></p>
              <% } %>
            </div>

            <div>
              <label class="mb-2 block text-label-sm font-semibold text-on-surface-variant" for="email">
                Email address
              </label>
              <input
                aria-invalid="<%= signupErrors.email ? 'true' : 'false' %>"
                <%- signupErrors.email ? 'aria-describedby="email-error"' : '' %>
                autocomplete="email"
                class="min-h-12 w-full rounded-lg border <%= signupErrors.email ? 'border-error' : 'border-outline-variant' %> bg-surface px-4 py-3 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                id="email"
                maxlength="254"
                name="email"
                placeholder="you@example.com"
                required
                type="email"
                value="<%= signupForm.email || '' %>"
              />
              <% if (signupErrors.email) { %>
                <p class="mt-2 text-body-sm text-error" id="email-error"><%= signupErrors.email %></p>
              <% } %>
            </div>

            <div>
              <label class="mb-2 block text-label-sm font-semibold text-on-surface-variant" for="password">
                Password
              </label>
              <div class="relative">
                <input
                  aria-invalid="<%= signupErrors.password ? 'true' : 'false' %>"
                  aria-describedby="password-help<%= signupErrors.password ? ' password-error' : '' %>"
                  autocomplete="new-password"
                  class="min-h-12 w-full rounded-lg border <%= signupErrors.password ? 'border-error' : 'border-outline-variant' %> bg-surface py-3 pl-4 pr-14 text-body-md outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                  id="password"
                  maxlength="128"
                  minlength="8"
                  name="password"
                  required
                  type="password"
                />
                <button
                  aria-controls="password"
                  aria-label="Show password"
                  aria-pressed="false"
                  class="absolute right-1 top-1/2 inline-flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-md text-secondary transition hover:bg-surface-container-low hover:text-primary"
                  title="Show password"
                  type="button"
                  data-password-toggle="password"
                >
                  <span aria-hidden="true" class="material-symbols-outlined">visibility</span>
                </button>
              </div>
              <p class="mt-2 text-body-sm text-secondary" id="password-help">Use 8 to 128 characters.</p>
              <% if (signupErrors.password) { %>
                <p class="mt-2 text-body-sm text-error" id="password-error"><%= signupErrors.password %></p>
              <% } %>
            </div>

            <button
              class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-6 py-3 font-bold text-white shadow-sm transition hover:opacity-90 disabled:cursor-wait disabled:opacity-70"
              type="submit"
            >
              Create account
            </button>

            <div class="text-center text-body-sm leading-relaxed text-secondary">
              <p>Account terms and privacy documents are not yet published.</p>
              <a class="mt-1 inline-flex min-h-11 items-center justify-center font-semibold text-primary underline underline-offset-4" href="mailto:support@homifund.com">Ask support about policies</a>
            </div>
          </form>

          <div class="mt-7 border-t border-outline-variant pt-6 text-center">
            <p class="text-label-md text-on-surface-variant">
              Already have an account?
              <a class="inline-flex min-h-11 items-center font-bold text-primary underline-offset-4 hover:underline" href="/login">Sign in</a>
            </p>
          </div>
        </section>

        <p class="mt-5 flex items-center justify-center gap-2 text-center text-body-sm text-secondary">
          <span aria-hidden="true" class="material-symbols-outlined text-[18px]">lock</span>
          Passwords are stored as one-way hashes.
        </p>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
