<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="bg-surface text-on-surface min-h-screen flex flex-col">
    <%- include('partials/header') %>
    <!-- Main Content: Join Screen -->
    <main class="flex-grow flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-[480px] space-y-8">
        <!-- Hero Header -->
        <div class="text-center space-y-2">
          <h1
            class="text-headline-lg font-headline-lg text-primary tracking-tight"
          >
            Join the Ecosystem
          </h1>
          <p class="text-body-md text-on-surface-variant">
            Institutional-grade tools for modern property management.
          </p>
        </div>
        <!-- Registration Card -->
        <div
          class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-[0_4px_12px_rgba(0,35,111,0.04)]"
        >
          <!-- Social Auth -->
          <div class="grid grid-cols-2 gap-4 mb-8">
            <button
              class="flex items-center justify-center gap-3 px-4 py-3 border border-outline rounded-lg text-label-md font-medium hover:bg-surface-container-low transition-colors"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  fill="#4285F4"
                ></path>
                <path
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  fill="#34A853"
                ></path>
                <path
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                  fill="#FBBC05"
                ></path>
                <path
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 1.16-4.53z"
                  fill="#EA4335"
                ></path>
              </svg>
              Google
            </button>
            <button
              class="flex items-center justify-center gap-3 px-4 py-3 border border-outline rounded-lg text-label-md font-medium hover:bg-surface-container-low transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.06.74s2.12-.81 3.63-.64c1.86.2 3.27 1.03 4.11 2.42-3.41 2.04-2.86 6.37.55 7.74-.69 1.74-1.7 3.4-3.35 4.71zM12.03 7.25c-.02-2.23 1.84-4.14 4.01-4.25.24 2.48-2.34 4.54-4.01 4.25z"
                ></path>
              </svg>
              Apple
            </button>
          </div>
          <!-- Divider -->
          <div class="relative mb-8 text-center">
            <div aria-hidden="true" class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-outline-variant"></div>
            </div>
            <span
              class="relative bg-surface-container-lowest px-4 text-label-sm font-semibold text-outline tracking-widest"
              >OR JOIN WITH EMAIL</span
            >
          </div>
          <!-- Registration Form -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-error-container text-on-error-container px-4 py-3 rounded-lg text-label-md mb-4"><%= error %></div>
          <% } %>
          <form id="signup-form" class="space-y-6" action="/signup" method="POST">
            <div class="space-y-2">
              <label
                class="block text-label-sm font-semibold text-on-surface-variant"
                for="full_name"
                >Full Name</label
              >
              <input
                class="w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary-container outline-none transition-all text-body-md"
                id="full_name"
                name="full_name"
                placeholder="Johnathan Doe"
                required=""
                type="text"
              />
            </div>
            <div class="space-y-2">
              <label
                class="block text-label-sm font-semibold text-on-surface-variant"
                for="email"
                >Email Address</label
              >
              <input
                class="w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary-container outline-none transition-all text-body-md"
                id="email"
                name="email"
                placeholder="john@example.com"
                required=""
                type="email"
              />
            </div>
            <div class="space-y-2">
              <label
                class="block text-label-sm font-semibold text-on-surface-variant"
                for="password"
                >Create Password</label
              >
              <div class="relative">
                <input
                  class="w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary-container outline-none transition-all text-body-md"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  required=""
                  type="password"
                />
                <button
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-outline-variant hover:text-primary"
                  onclick="togglePasswordVisibility()"
                  type="button"
                >
                  <span class="material-symbols-outlined" id="eye_icon"
                    >visibility</span
                  >
                </button>
              </div>
            </div>
            <div class="flex items-start gap-3 pt-2">
              <input
                class="mt-1 rounded border-outline-variant text-primary focus:ring-primary-container"
                id="terms"
                type="checkbox"
              />
              <label
                class="text-label-sm text-on-surface-variant leading-relaxed"
                for="terms"
              >
                I agree to the
                <a class="text-primary hover:underline" href="#"
                  >Terms of Service</a
                ><!-- TODO: target page not created yet -->
                and
                <a class="text-primary hover:underline" href="#"
                  >Privacy Policy</a
                ><!-- TODO: target page not created yet -->.
              </label>
            </div>
            <button
              class="w-full py-4 bg-primary text-white rounded-lg font-bold text-label-md shadow-lg hover:opacity-90 active:scale-95 transition-all flex items-center justify-center"
              type="submit"
            >
              Join HomiFund
            </button>
            <div id="signup-message" class="min-h-5 text-sm text-center"></div>
          </form>
          <!-- Footer Sign In Link -->
          <div class="mt-8 text-center border-t border-outline-variant pt-6">
            <p class="text-label-md text-on-surface-variant">
              Already have an account?
              <a class="text-primary font-bold hover:underline" href="/login"
                >Sign In</a
              >
            </p>
          </div>
        </div>
        <!-- Trust Indicator -->
        <div class="flex justify-center items-center gap-2 text-outline">
          <span class="material-symbols-outlined text-[18px]"
            >verified_user</span
          >
          <span class="text-label-sm font-medium"
            >Secure, encrypted registration</span
          >
        </div>
      </div>
    </main>
    <script>
      function togglePasswordVisibility() {
        const p = document.getElementById("password");
        const icon = document.getElementById("eye_icon");
        if (p.type === "password") { p.type = "text"; icon.innerText = "visibility_off"; }
        else { p.type = "password"; icon.innerText = "visibility"; }
      }
    </script>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
