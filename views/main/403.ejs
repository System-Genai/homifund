<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="hf-legacy-page flex min-h-screen flex-col bg-surface text-on-surface hf-public-page">
    <% const recoveryUrl = typeof dashboardUrl === 'string' && dashboardUrl.startsWith('/') ? dashboardUrl : '/role-selection'; %>
    <%- include('partials/header') %>

    <main class="flex flex-grow items-center justify-center px-4 py-12 sm:px-6 sm:py-16">
      <div class="mx-auto w-full max-w-3xl rounded-xl border border-outline-variant bg-surface-container-lowest p-8 shadow-[0_4px_12px_rgba(0,35,111,0.04)] md:p-12">
        <section class="text-center" aria-labelledby="access-denied-title">
          <span class="material-symbols-outlined mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-error-container text-[32px] text-on-error-container" aria-hidden="true">lock</span>
          <p class="mt-6 text-label-md font-bold text-error">Error 403</p>
          <h1 id="access-denied-title" class="mt-2 text-headline-lg font-bold text-primary">You do not have access to this page</h1>
          <p class="mx-auto mt-4 max-w-2xl text-body-md text-on-surface-variant">Your account is signed in, but its current workspace does not permit this page. No account data or permission setting was changed.</p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="<%= recoveryUrl %>" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-primary px-6 font-bold text-on-primary transition-opacity hover:opacity-90">
              <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
              Return to your workspace
            </a>
            <a href="/contact#contact-form" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-outline px-6 font-bold text-primary transition-colors hover:bg-surface-container-low">
              <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
              Contact support
            </a>
          </div>
        </section>

        <div class="mt-10 grid grid-cols-1 border-y border-outline-variant md:grid-cols-2 md:divide-x md:divide-outline-variant">
          <section class="px-2 py-6 text-left sm:px-6" aria-labelledby="access-recovery-title">
            <h2 id="access-recovery-title" class="font-bold text-on-surface">What to do next</h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">Return to your workspace and use its navigation. Contact support if a page required for your assigned role remains unavailable.</p>
          </section>
          <section class="border-t border-outline-variant px-2 py-6 text-left sm:px-6 md:border-t-0" aria-labelledby="access-privacy-title">
            <h2 id="access-privacy-title" class="font-bold text-on-surface">Permission privacy</h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">This response does not reveal whether the requested record exists or which permission is missing. Do not send passwords or identity documents when reporting the issue.</p>
          </section>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
