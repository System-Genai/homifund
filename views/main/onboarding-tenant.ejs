<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-on-surface hf-public-page">
    <% const renterForm = typeof form === 'object' && form ? form : {}; %>
    <% const renterErrors = typeof fieldErrors === 'object' && fieldErrors ? fieldErrors : {}; %>
    <%- include('partials/header') %>

    <main class="mx-auto w-full max-w-6xl flex-grow px-margin-mobile py-8 md:px-margin-desktop md:py-12">
      <nav class="hf-auth-stepper mx-auto mb-8 max-w-3xl md:mb-10" aria-label="Renter onboarding progress">
        <ol class="hf-auth-stepper-list" role="list">
          <li class="hf-auth-stepper-step is-current" aria-current="step">
            <span class="hf-auth-stepper-marker">1</span>
            <span class="hf-auth-stepper-label">Profile</span>
          </li>
          <li class="hf-auth-stepper-step">
            <span class="hf-auth-stepper-marker">2</span>
            <span class="hf-auth-stepper-label">Verification</span>
          </li>
          <li class="hf-auth-stepper-step">
            <span class="hf-auth-stepper-marker">3</span>
            <span class="hf-auth-stepper-label">Finish</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-8">
          <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-5 shadow-sm sm:p-8">
            <div class="mb-8">
              <p class="mb-2 text-label-md font-bold text-secondary">Step 1 of 3</p>
              <h1 class="mb-3 text-headline-lg font-bold text-primary">Set up your renter profile</h1>
              <p class="max-w-2xl text-body-md text-on-surface-variant">
                Add the household and search details used to organize your renter workspace.
                Fields marked required must be complete before verification.
              </p>
            </div>

            <% if (error) { %>
              <div
                class="mb-6 rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container"
                data-focus-feedback
                role="alert"
                tabindex="-1"
              ><%= error %></div>
            <% } else if (success) { %>
              <div
                class="mb-6 rounded-lg bg-secondary-container px-4 py-3 text-body-sm text-on-secondary-container"
                data-focus-feedback
                role="status"
                tabindex="-1"
              ><%= success %></div>
            <% } %>

            <form action="/onboarding-tenant" method="POST" data-submit-feedback>
              <section class="border-b border-outline-variant pb-8" aria-labelledby="renter-household-heading">
                <div class="mb-6 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">group</span>
                  <h2 id="renter-household-heading" class="text-headline-md font-bold text-on-surface">Account and household</h2>
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="legalName">Legal name <span class="text-error">*</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="legalName"
                      name="legalName"
                      type="text"
                      autocomplete="name"
                      maxlength="120"
                      required
                      value="<%= renterForm.legalName || '' %>"
                      aria-invalid="<%= renterErrors.legalName ? 'true' : 'false' %>"
                      <%- renterErrors.legalName ? 'aria-describedby="legalName-error"' : '' %>
                    />
                    <% if (renterErrors.legalName) { %><p class="text-body-sm text-error" id="legalName-error"><%= renterErrors.legalName %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="phone">Phone number <span class="font-normal text-on-surface-variant">(optional)</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="phone"
                      name="phone"
                      type="tel"
                      inputmode="tel"
                      autocomplete="tel"
                      maxlength="30"
                      value="<%= renterForm.phone || '' %>"
                      aria-invalid="<%= renterErrors.phone ? 'true' : 'false' %>"
                      <%- renterErrors.phone ? 'aria-describedby="phone-error"' : '' %>
                    />
                    <% if (renterErrors.phone) { %><p class="text-body-sm text-error" id="phone-error"><%= renterErrors.phone %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="householdSize">Household size <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="householdSize"
                      name="householdSize"
                      required
                      aria-invalid="<%= renterErrors.householdSize ? 'true' : 'false' %>"
                      <%- renterErrors.householdSize ? 'aria-describedby="householdSize-error"' : '' %>
                    >
                      <option value="">Choose household size</option>
                      <option value="one" <%= renterForm.householdSize === 'one' ? 'selected' : '' %>>1 person</option>
                      <option value="two" <%= renterForm.householdSize === 'two' ? 'selected' : '' %>>2 people</option>
                      <option value="three" <%= renterForm.householdSize === 'three' ? 'selected' : '' %>>3 people</option>
                      <option value="four-plus" <%= renterForm.householdSize === 'four-plus' ? 'selected' : '' %>>4 or more people</option>
                    </select>
                    <% if (renterErrors.householdSize) { %><p class="text-body-sm text-error" id="householdSize-error"><%= renterErrors.householdSize %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="petStatus">Pets <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="petStatus"
                      name="petStatus"
                      required
                      aria-invalid="<%= renterErrors.petStatus ? 'true' : 'false' %>"
                      <%- renterErrors.petStatus ? 'aria-describedby="petStatus-error"' : '' %>
                    >
                      <option value="">Choose pet status</option>
                      <option value="none" <%= renterForm.petStatus === 'none' ? 'selected' : '' %>>No pets</option>
                      <option value="one" <%= renterForm.petStatus === 'one' ? 'selected' : '' %>>One pet</option>
                      <option value="multiple" <%= renterForm.petStatus === 'multiple' ? 'selected' : '' %>>More than one pet</option>
                    </select>
                    <% if (renterErrors.petStatus) { %><p class="text-body-sm text-error" id="petStatus-error"><%= renterErrors.petStatus %></p><% } %>
                  </div>
                </div>
              </section>

              <section class="border-b border-outline-variant py-8" aria-labelledby="renter-situation-heading">
                <div class="mb-3 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">work</span>
                  <h2 id="renter-situation-heading" class="text-headline-md font-bold text-on-surface">Current situation</h2>
                </div>
                <p class="mb-6 text-body-sm text-on-surface-variant">Supporting documents are requested only in the next verification step.</p>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label class="font-label-md font-bold text-on-surface" for="employmentStatus">Employment status <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="employmentStatus"
                      name="employmentStatus"
                      required
                      aria-invalid="<%= renterErrors.employmentStatus ? 'true' : 'false' %>"
                      <%- renterErrors.employmentStatus ? 'aria-describedby="employmentStatus-error"' : '' %>
                    >
                      <option value="">Choose employment status</option>
                      <option value="employed" <%= renterForm.employmentStatus === 'employed' ? 'selected' : '' %>>Employed</option>
                      <option value="self-employed" <%= renterForm.employmentStatus === 'self-employed' ? 'selected' : '' %>>Self-employed</option>
                      <option value="student" <%= renterForm.employmentStatus === 'student' ? 'selected' : '' %>>Student</option>
                      <option value="retired" <%= renterForm.employmentStatus === 'retired' ? 'selected' : '' %>>Retired</option>
                      <option value="other" <%= renterForm.employmentStatus === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                    <% if (renterErrors.employmentStatus) { %><p class="text-body-sm text-error" id="employmentStatus-error"><%= renterErrors.employmentStatus %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="jobTitle">Job title <span class="font-normal text-on-surface-variant">(optional)</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="jobTitle"
                      name="jobTitle"
                      type="text"
                      autocomplete="organization-title"
                      maxlength="120"
                      value="<%= renterForm.jobTitle || '' %>"
                      aria-invalid="<%= renterErrors.jobTitle ? 'true' : 'false' %>"
                      <%- renterErrors.jobTitle ? 'aria-describedby="jobTitle-error"' : '' %>
                    />
                    <% if (renterErrors.jobTitle) { %><p class="text-body-sm text-error" id="jobTitle-error"><%= renterErrors.jobTitle %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="employer">Employer <span class="font-normal text-on-surface-variant">(optional)</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="employer"
                      name="employer"
                      type="text"
                      autocomplete="organization"
                      maxlength="120"
                      value="<%= renterForm.employer || '' %>"
                      aria-invalid="<%= renterErrors.employer ? 'true' : 'false' %>"
                      <%- renterErrors.employer ? 'aria-describedby="employer-error"' : '' %>
                    />
                    <% if (renterErrors.employer) { %><p class="text-body-sm text-error" id="employer-error"><%= renterErrors.employer %></p><% } %>
                  </div>
                </div>
              </section>

              <section class="pt-8" aria-labelledby="renter-search-heading">
                <div class="mb-6 flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">home_search</span>
                  <h2 id="renter-search-heading" class="text-headline-md font-bold text-on-surface">Home search</h2>
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="monthlyBudget">Maximum monthly budget <span class="text-error">*</span></label>
                    <div class="relative">
                      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-body-sm text-on-surface-variant">GBP</span>
                      <input
                        class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface pl-12 pr-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                        id="monthlyBudget"
                        name="monthlyBudget"
                        type="number"
                        inputmode="decimal"
                        min="0"
                        max="1000000"
                        step="0.01"
                        required
                        value="<%= renterForm.monthlyBudget ?? '' %>"
                        aria-invalid="<%= renterErrors.monthlyBudget ? 'true' : 'false' %>"
                        <%- renterErrors.monthlyBudget ? 'aria-describedby="monthlyBudget-error"' : '' %>
                      />
                    </div>
                    <% if (renterErrors.monthlyBudget) { %><p class="text-body-sm text-error" id="monthlyBudget-error"><%= renterErrors.monthlyBudget %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="preferredLocations">Preferred locations <span class="text-error">*</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="preferredLocations"
                      name="preferredLocations"
                      type="text"
                      maxlength="250"
                      required
                      value="<%= renterForm.preferredLocations || '' %>"
                      aria-invalid="<%= renterErrors.preferredLocations ? 'true' : 'false' %>"
                      aria-describedby="<%= renterErrors.preferredLocations ? 'preferredLocations-help preferredLocations-error' : 'preferredLocations-help' %>"
                    />
                    <p class="text-body-sm text-on-surface-variant" id="preferredLocations-help">Enter cities or neighbourhoods separated by commas.</p>
                    <% if (renterErrors.preferredLocations) { %><p class="text-body-sm text-error" id="preferredLocations-error"><%= renterErrors.preferredLocations %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="propertyType">Property type <span class="text-error">*</span></label>
                    <select
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="propertyType"
                      name="propertyType"
                      required
                      aria-invalid="<%= renterErrors.propertyType ? 'true' : 'false' %>"
                      <%- renterErrors.propertyType ? 'aria-describedby="propertyType-error"' : '' %>
                    >
                      <option value="">Choose a property type</option>
                      <option value="apartment" <%= renterForm.propertyType === 'apartment' ? 'selected' : '' %>>Apartment</option>
                      <option value="house" <%= renterForm.propertyType === 'house' ? 'selected' : '' %>>House</option>
                      <option value="studio" <%= renterForm.propertyType === 'studio' ? 'selected' : '' %>>Studio</option>
                      <option value="shared-home" <%= renterForm.propertyType === 'shared-home' ? 'selected' : '' %>>Shared home</option>
                      <option value="flexible" <%= renterForm.propertyType === 'flexible' ? 'selected' : '' %>>No preference</option>
                    </select>
                    <% if (renterErrors.propertyType) { %><p class="text-body-sm text-error" id="propertyType-error"><%= renterErrors.propertyType %></p><% } %>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="font-label-md font-bold text-on-surface" for="moveInDate">Preferred move-in date <span class="font-normal text-on-surface-variant">(optional)</span></label>
                    <input
                      class="min-h-12 rounded-lg border border-outline-variant bg-surface px-3 text-body-md focus:border-primary focus:ring-2 focus:ring-primary"
                      id="moveInDate"
                      name="moveInDate"
                      type="date"
                      value="<%= renterForm.moveInDate || '' %>"
                      aria-invalid="<%= renterErrors.moveInDate ? 'true' : 'false' %>"
                      <%- renterErrors.moveInDate ? 'aria-describedby="moveInDate-error"' : '' %>
                    />
                    <% if (renterErrors.moveInDate) { %><p class="text-body-sm text-error" id="moveInDate-error"><%= renterErrors.moveInDate %></p><% } %>
                  </div>
                </div>
              </section>

              <div class="mt-8 flex flex-col gap-3 border-t border-outline-variant pt-6 sm:flex-row">
                <button
                  class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-primary px-6 font-label-md font-bold text-on-primary transition-colors hover:bg-primary-container disabled:cursor-wait disabled:opacity-70"
                  name="intent"
                  type="submit"
                  value="continue"
                  data-pending-label="Saving profile..."
                >
                  Continue to verification
                  <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>
                </button>
                <button
                  class="inline-flex min-h-12 items-center justify-center rounded-lg border border-outline-variant px-6 font-label-md font-bold text-primary transition-colors hover:bg-surface-container-low disabled:cursor-wait disabled:opacity-70"
                  name="intent"
                  type="submit"
                  value="draft"
                  formnovalidate
                  data-pending-label="Saving draft..."
                >Save draft</button>
              </div>
            </form>
          </div>
        </div>

        <aside class="lg:sticky lg:top-28 lg:col-span-4" aria-labelledby="renter-next-heading">
          <div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm">
            <p class="mb-2 text-label-sm font-bold uppercase text-secondary">Your setup</p>
            <h2 id="renter-next-heading" class="mb-4 text-headline-md font-bold text-primary">What happens next</h2>
            <ol class="space-y-5" role="list">
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">1</span>
                <div><p class="font-bold text-on-surface">Save this profile</p><p class="mt-1 text-body-sm text-on-surface-variant">Your answers are stored on your account and can be updated later.</p></div>
              </li>
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-sm font-bold text-on-surface-variant">2</span>
                <div><p class="font-bold text-on-surface">Review verification</p><p class="mt-1 text-body-sm text-on-surface-variant">The next screen explains any documents or consent before submission.</p></div>
              </li>
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-container-high text-sm font-bold text-on-surface-variant">3</span>
                <div><p class="font-bold text-on-surface">Open your workspace</p><p class="mt-1 text-body-sm text-on-surface-variant">Use the dashboard to organize applications, messages, and rental records.</p></div>
              </li>
            </ol>
            <div class="mt-6 border-t border-outline-variant pt-5">
              <p class="flex items-start gap-2 text-body-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-xl text-primary" aria-hidden="true">privacy_tip</span>
                Income evidence is not collected on this screen. Review the verification request before sharing supporting documents.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
