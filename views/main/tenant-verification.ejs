<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="bg-background text-on-surface">
    <%- include('partials/header') %>
    <main class="max-w-container-max mx-auto px-margin-desktop py-12">
      <!-- Progress Stepper -->
      <div class="mb-10 sm:mb-12 overflow-x-auto pb-2">
        <div class="flex items-center justify-between max-w-4xl mx-auto min-w-[560px]">
          <!-- Step 1: Profile -->
          <div class="flex flex-col items-center gap-2">
            <div
              class="w-10 h-10 rounded-full bg-primary-container text-white flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-xl">check</span>
            </div>
            <span class="font-label-sm text-label-sm text-primary"
              >Profile Setup</span
            >
          </div>
          <div class="flex-1 h-[2px] bg-primary mx-4 -mt-6"></div>
          <!-- Step 2: Verification (Active) -->
          <div class="flex flex-col items-center gap-2">
            <div
              class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center ring-4 ring-primary-fixed"
            >
              <span class="font-label-md text-label-md">02</span>
            </div>
            <span class="font-label-sm text-label-sm text-primary font-bold"
              >Verification</span
            >
          </div>
          <div class="flex-1 h-[2px] bg-surface-variant mx-4 -mt-6"></div>
          <!-- Step 3: HomiScore -->
          <div class="flex flex-col items-center gap-2">
            <div
              class="w-10 h-10 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center"
            >
              <span class="font-label-md text-label-md">03</span>
            </div>
            <span class="font-label-sm text-label-sm text-on-surface-variant"
              >HomiScore</span
            >
          </div>
          <div class="flex-1 h-[2px] bg-surface-variant mx-4 -mt-6"></div>
          <!-- Step 4: Dashboard -->
          <div class="flex flex-col items-center gap-2">
            <div
              class="w-10 h-10 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center"
            >
              <span class="font-label-md text-label-md">04</span>
            </div>
            <span class="font-label-sm text-label-sm text-on-surface-variant"
              >Dashboard</span
            >
          </div>
        </div>
      </div>
      <!-- Page Content -->
      <div class="grid grid-cols-12 gap-gutter-desktop">
        <!-- Left Column: Verification Tasks (col-span-8) -->
        <div class="col-span-12 lg:col-span-8 flex flex-col gap-8">
          <!-- Identity Verification -->
          <section
            class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant card-shadow"
          >
            <div class="flex justify-between items-start mb-6">
              <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-2">
                  Identity Verification
                </h2>
                <p class="font-body-md text-body-md text-secondary max-w-xl">
                  We use government-grade security to verify your identity. This
                  is required for institutional trust scoring.
                </p>
              </div>
              <span
                class="inline-flex items-center px-4 py-1.5 rounded-full bg-surface-container-low text-on-surface-variant font-medium text-label-sm border border-outline-variant/30"
              >
                <span class="material-symbols-outlined text-[18px] mr-1.5"
                  >schedule</span
                >
                Pending
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-6">
              <button
                class="flex flex-col items-center justify-center p-4 border border-primary rounded-lg bg-primary-fixed/30 text-primary transition-all"
              >
                <span class="material-symbols-outlined text-2xl mb-2"
                  >public</span
                >
                <span class="font-label-sm text-label-sm">Passport</span>
              </button>
              <button
                class="flex flex-col items-center justify-center p-4 border border-outline-variant rounded-lg hover:border-primary hover:bg-surface-container-low transition-all"
              >
                <span class="material-symbols-outlined text-2xl mb-2"
                  >directions_car</span
                >
                <span class="font-label-sm text-label-sm">Driving License</span>
              </button>
              <button
                class="flex flex-col items-center justify-center p-4 border border-outline-variant rounded-lg hover:border-primary hover:bg-surface-container-low transition-all"
              >
                <span class="material-symbols-outlined text-2xl mb-2"
                  >badge</span
                >
                <span class="font-label-sm text-label-sm">National ID</span>
              </button>
            </div>
            <div
              class="border-2 border-dashed border-outline-variant rounded-xl p-10 flex flex-col items-center justify-center bg-surface-bright hover:bg-surface-container transition-colors cursor-pointer group"
            >
              <span
                class="material-symbols-outlined text-4xl text-on-surface-variant mb-3 group-hover:text-primary"
                >upload_file</span
              >
              <p class="font-body-md text-body-md text-on-surface mb-1">
                Drag and drop your document here
              </p>
              <p class="font-label-sm text-label-sm text-secondary">
                PDF, JPEG, or PNG (Max 10MB)
              </p>
            </div>
          </section>
          <!-- Address Verification -->
          <section
            class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant card-shadow"
          >
            <div class="flex justify-between items-start mb-6">
              <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-2">
                  Address Verification
                </h2>
                <p class="font-body-md text-body-md text-secondary max-w-xl">
                  Provide a document from the last 3 months to confirm your
                  current residency.
                </p>
              </div>
              <span
                class="inline-flex items-center px-4 py-1.5 rounded-full bg-surface-container-low text-on-surface-variant font-medium text-label-sm border border-outline-variant/30"
              >
                <span class="material-symbols-outlined text-[18px] mr-1.5"
                  >schedule</span
                >
                Pending
              </span>
            </div>
            <div class="flex flex-wrap gap-3 mb-6">
              <span
                class="px-4 py-2 border border-outline-variant rounded-full text-label-md font-label-md hover:bg-secondary-container cursor-pointer transition-all"
                >Utility Bill</span
              >
              <span
                class="px-4 py-2 border border-outline-variant rounded-full text-label-md font-label-md hover:bg-secondary-container cursor-pointer transition-all"
                >Bank Statement</span
              >
              <span
                class="px-4 py-2 border border-outline-variant rounded-full text-label-md font-label-md hover:bg-secondary-container cursor-pointer transition-all"
                >Council Tax</span
              >
            </div>
            <div
              class="border border-outline-variant rounded-lg p-4 flex items-center justify-between"
            >
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 rounded bg-surface-container-high flex items-center justify-center"
                >
                  <span class="material-symbols-outlined text-on-surface-variant"
                    >description</span
                  >
                </div>
                <div>
                  <p class="font-label-md text-label-md text-on-surface">
                    Upload Proof of Address
                  </p>
                  <p class="text-[12px] text-secondary">Scan or digital copy</p>
                </div>
              </div>
              <button class="text-primary font-label-md hover:underline">
                Choose File
              </button>
            </div>
          </section>
          <!-- Income Verification -->
          <section
            class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant card-shadow"
          >
            <div class="flex justify-between items-start mb-6">
              <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-2">
                  Income Verification
                </h2>
                <p class="font-body-md text-body-md text-secondary max-w-xl">
                  Verify your earnings to unlock higher HomiScores and lower
                  rental deposits.
                </p>
              </div>
              <span
                class="inline-flex items-center px-4 py-1.5 rounded-full bg-surface-container-highest/50 text-on-surface-variant font-medium text-label-sm border border-outline-variant/30"
              >
                <span class="material-symbols-outlined text-[18px] mr-1.5"
                  >link_off</span
                >
                Not Connected
              </span>
            </div>
            <div
              class="bg-primary-container/10 border border-primary/20 rounded-xl p-5 sm:p-6 mb-6 flex flex-col sm:flex-row gap-4 sm:gap-6 sm:items-center"
            >
              <div class="bg-primary-container p-3 rounded-full text-white">
                <span class="material-symbols-outlined text-2xl"
                  >account_balance</span
                >
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3
                    class="font-label-md text-label-md text-primary font-bold"
                  >
                    Open Banking (Recommended)
                  </h3>
                  <span
                    class="bg-tertiary-container text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider"
                    >Fastest</span
                  >
                </div>
                <p class="font-label-sm text-label-sm text-secondary">
                  Instantly verify 12 months of rental payments and income via
                  secure bank API.
                </p>
              </div>
              <button
                class="bg-primary text-white font-label-md text-label-md px-6 py-2 rounded-lg shadow-sm hover:opacity-90"
              >
                Connect Bank
              </button>
            </div>
            <div
              class="flex items-center gap-4 py-4 border-t border-outline-variant"
            >
              <p class="font-label-sm text-label-sm text-secondary">
                Prefer manual upload?
              </p>
              <button
                class="text-primary font-label-md text-label-md font-bold flex items-center"
              >
                Upload Payslips
                <span class="material-symbols-outlined ml-1 text-base"
                  >arrow_forward</span
                >
              </button>
            </div>
          </section>
          <!-- Rental History Verification -->
          <section
            class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant card-shadow"
          >
            <div class="flex justify-between items-start mb-6">
              <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-2">
                  Rental History
                </h2>
                <p class="font-body-md text-body-md text-secondary max-w-xl">
                  Provide details of your last landlord to confirm your history
                  of timely payments.
                </p>
              </div>
              <span
                class="inline-flex items-center px-4 py-1.5 rounded-full bg-surface-container-highest/50 text-on-surface-variant font-medium text-label-sm border border-outline-variant/30"
              >
                <span class="material-symbols-outlined text-[18px] mr-1.5"
                  >radio_button_unchecked</span
                >
                Not Submitted
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-1.5">
                <label class="font-label-sm text-label-sm text-secondary"
                  >Landlord / Agency Name</label
                >
                <input
                  class="border border-outline-variant rounded-lg p-3 focus:border-primary outline-none transition-all"
                  placeholder="e.g. John Doe or Foxtons"
                  type="text"
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="font-label-sm text-label-sm text-secondary"
                  >Reference Email Address</label
                >
                <input
                  class="border border-outline-variant rounded-lg p-3 focus:border-primary outline-none transition-all"
                  placeholder="landlord@example.com"
                  type="email"
                />
              </div>
              <div class="flex flex-col gap-1.5 md:col-span-2">
                <label class="font-label-sm text-label-sm text-secondary"
                  >Tenancy Length (Years/Months)</label
                >
                <input
                  class="border border-outline-variant rounded-lg p-3 focus:border-primary outline-none transition-all"
                  placeholder="e.g. 2 Years"
                  type="text"
                />
              </div>
            </div>
          </section>
          <!-- Bottom Actions -->
          <div
            class="flex items-center justify-between mt-8 py-8 border-t border-outline-variant"
          >
            <button
              class="text-secondary font-label-md text-label-md hover:text-on-surface transition-colors flex items-center"
            >
              <span class="material-symbols-outlined mr-2">arrow_back</span>
              Back
            </button>
            <div class="flex gap-4">
              <button
                class="px-6 py-3 border border-outline rounded-lg font-label-md text-label-md hover:bg-surface-container-low transition-all"
              >
                Save and Finish Later
              </button>
              <button
                id="continue-to-homiscore-btn"
                type="button"
                class="px-8 py-3 bg-primary text-white rounded-lg font-label-md text-label-md font-bold shadow-md hover:opacity-90 transition-all flex items-center gap-2"
              >
                Continue to HomiScore
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </div>
          </div>
        </div>
        <!-- Right Column: Rental Passport Sidebar (col-span-4) -->
        <aside class="col-span-12 lg:col-span-4">
          <div class="lg:sticky lg:top-24 flex flex-col gap-6">
            <!-- Passport Card -->
            <div
              class="bg-primary text-on-primary p-8 rounded-xl shadow-2xl relative overflow-hidden"
            >
              <div
                class="absolute -right-12 -top-12 w-48 h-48 bg-white/5 rounded-full blur-3xl"
              ></div>
              <div
                class="absolute -left-12 -bottom-12 w-48 h-48 bg-primary-container/20 rounded-full blur-3xl"
              ></div>
              <div class="relative z-10">
                <div class="flex items-center justify-between mb-8">
                  <h3
                    class="font-label-md text-label-md tracking-widest uppercase opacity-80"
                  >
                    Rental Passport
                  </h3>
                  <div
                    class="bg-tertiary-container/50 px-2 py-1 rounded text-[10px] font-bold border border-white/20"
                  >
                    PRE-DRAFT
                  </div>
                </div>
                <div class="flex items-center gap-4 mb-8">
                  <div
                    class="w-16 h-16 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-inner text-primary overflow-hidden"
                  >
                    <div
                      class="w-full h-full flex items-center justify-center bg-surface-variant text-on-surface-variant"
                    >
                      <span class="material-symbols-outlined text-4xl"
                        >person</span
                      >
                    </div>
                  </div>
                  <div>
                    <h4 class="font-headline-md text-headline-md leading-tight">
                      Marcus Thorne
                    </h4>
                    <p class="text-on-primary/70 font-label-sm text-label-sm">
                      Digital Rental Passport
                    </p>
                  </div>
                </div>
                <div class="space-y-4 pt-6 border-t border-white/10">
                  <div class="flex justify-between items-center">
                    <span class="text-on-primary/60 font-label-sm text-label-sm"
                      >Identity</span
                    >
                    <span
                      class="flex items-center gap-1 text-[11px] font-bold text-secondary-fixed"
                    >
                      <span class="material-symbols-outlined text-[14px]"
                        >pending</span
                      >
                      Pending
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-on-primary/60 font-label-sm text-label-sm"
                      >Address</span
                    >
                    <span
                      class="flex items-center gap-1 text-[11px] font-bold text-secondary-fixed"
                    >
                      <span class="material-symbols-outlined text-[14px]"
                        >pending</span
                      >
                      Pending
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-on-primary/60 font-label-sm text-label-sm"
                      >Income</span
                    >
                    <span
                      class="text-on-primary/70 font-bold text-[11px] uppercase tracking-wider"
                      >Empty</span
                    >
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-on-primary/60 font-label-sm text-label-sm"
                      >Rental History</span
                    >
                    <span
                      class="text-on-primary/70 font-bold text-[11px] uppercase tracking-wider"
                      >Empty</span
                    >
                  </div>
                </div>
                <div
                  class="mt-8 bg-white/10 p-4 rounded-lg border border-white/5 backdrop-blur-sm"
                >
                  <div class="flex items-center gap-3 mb-2">
                    <span
                      class="material-symbols-outlined text-secondary-fixed"
                      data-weight="fill"
                      >verified</span
                    >
                    <p class="text-label-sm font-bold text-white">
                      HomiScore Status
                    </p>
                  </div>
                  <p class="text-[11px] leading-relaxed opacity-70">
                    Awaiting Verification
                  </p>
                </div>
              </div>
            </div>
            <!-- Why Verify? Card -->
            <div
              class="mt-6 p-6 bg-secondary-container/30 border border-secondary-container rounded-xl flex gap-4"
            >
              <span
                class="material-symbols-outlined text-primary"
                data-weight="fill"
                >lightbulb</span
              >
              <div>
                <p class="text-label-md font-bold text-primary mb-1">
                  Why Verify?
                </p>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2">
                    <span
                      class="material-symbols-outlined text-primary text-[16px] mt-0.5"
                      >check_circle</span
                    >
                    <p class="text-label-sm text-on-secondary-container">
                      Instantly pre-qualify for 90% of prime rental listings.
                    </p>
                  </li>
                  <li class="flex items-start gap-2">
                    <span
                      class="material-symbols-outlined text-primary text-[16px] mt-0.5"
                      >check_circle</span
                    >
                    <p class="text-label-sm text-on-secondary-container">
                      Avoid double-deposits with verified history.
                    </p>
                  </li>
                  <li class="flex items-start gap-2">
                    <span
                      class="material-symbols-outlined text-primary text-[16px] mt-0.5"
                      >check_circle</span
                    >
                    <p class="text-label-sm text-on-secondary-container">
                      Unlock exclusive institutional landlord portfolios.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </main>
    <!-- Footer (Shared Component) -->
    <script>
      // Micro-interactions for buttons
      document.querySelectorAll("button").forEach((btn) => {
        btn.addEventListener("mousedown", () => {
          btn.classList.add("scale-95");
        });
        btn.addEventListener("mouseup", () => {
          btn.classList.remove("scale-95");
        });
        btn.addEventListener("mouseleave", () => {
          btn.classList.remove("scale-95");
        });
      });
    </script>

    <script>
      const continueToHomiScoreBtn = document.getElementById(
        "continue-to-homiscore-btn",
      );
      if (continueToHomiScoreBtn) {
        continueToHomiScoreBtn.addEventListener("click", () => {
          window.location.href = "dashboards/Renter/HomiScore";
        });
      }
    </script>

    <script src="/js/main.js"></script>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
