<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-on-surface hf-public-page">
    <%- include('partials/header') %>

    <main class="flex flex-grow items-center justify-center px-margin-mobile py-10 md:px-margin-desktop md:py-14">
      <div class="w-full max-w-3xl">
        <div class="mb-8 text-center md:mb-10">
          <p class="mb-2 text-label-md font-bold text-secondary">Account setup</p>
          <h1 class="mb-3 text-headline-lg font-bold text-primary">
            Choose how you will use HomiFund
          </h1>
          <p class="mx-auto max-w-2xl text-body-md text-on-surface-variant">
            Select one primary workspace for this account. Your choice determines
            the dashboard and tools shown after setup.
          </p>
        </div>

        <% if (error) { %>
          <div
            class="mb-6 rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container"
            data-focus-feedback
            role="alert"
            tabindex="-1"
          ><%= error %></div>
        <% } %>

        <form action="/role-selection" method="POST" data-submit-feedback>
          <fieldset>
            <legend class="sr-only">Primary account workspace</legend>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
              <div class="relative">
                <input
                  class="hf-role-option sr-only"
                  id="role-renter"
                  name="role"
                  required
                  type="radio"
                  value="renter"
                  aria-describedby="role-renter-description"
                  <%= selectedRole === 'renter' ? 'checked' : '' %>
                />
                <label
                  class="hf-role-card flex min-h-[250px] cursor-pointer flex-col rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm transition-colors md:min-h-[280px] md:p-8"
                  for="role-renter"
                >
                  <span class="mb-6 flex items-start justify-between gap-4">
                    <span class="inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary-fixed text-primary">
                      <span class="material-symbols-outlined text-[30px]" aria-hidden="true">person_pin_circle</span>
                    </span>
                    <span class="hf-role-check hidden h-8 w-8 items-center justify-center rounded-full bg-primary text-on-primary" aria-hidden="true">
                      <span class="material-symbols-outlined text-xl">check</span>
                    </span>
                  </span>
                  <span class="mb-3 text-headline-md font-bold text-primary">Renter workspace</span>
                  <span id="role-renter-description" class="mb-6 flex-grow text-body-md text-on-surface-variant">
                    Organize your renter profile, application details, documents,
                    messages, and payment records.
                  </span>
                  <span class="inline-flex items-center gap-2 font-label-md font-bold text-primary">
                    Select renter
                    <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>
                  </span>
                </label>
              </div>

              <div class="relative">
                <input
                  class="hf-role-option sr-only"
                  id="role-landlord"
                  name="role"
                  required
                  type="radio"
                  value="landlord"
                  aria-describedby="role-landlord-description"
                  <%= selectedRole === 'landlord' ? 'checked' : '' %>
                />
                <label
                  class="hf-role-card flex min-h-[250px] cursor-pointer flex-col rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm transition-colors md:min-h-[280px] md:p-8"
                  for="role-landlord"
                >
                  <span class="mb-6 flex items-start justify-between gap-4">
                    <span class="inline-flex h-14 w-14 items-center justify-center rounded-lg bg-secondary-fixed text-secondary">
                      <span class="material-symbols-outlined text-[30px]" aria-hidden="true">apartment</span>
                    </span>
                    <span class="hf-role-check hidden h-8 w-8 items-center justify-center rounded-full bg-primary text-on-primary" aria-hidden="true">
                      <span class="material-symbols-outlined text-xl">check</span>
                    </span>
                  </span>
                  <span class="mb-3 text-headline-md font-bold text-primary">Landlord workspace</span>
                  <span id="role-landlord-description" class="mb-6 flex-grow text-body-md text-on-surface-variant">
                    Manage properties, applicant reviews, agreements, rent records,
                    and tenant communication.
                  </span>
                  <span class="inline-flex items-center gap-2 font-label-md font-bold text-primary">
                    Select landlord
                    <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>
                  </span>
                </label>
              </div>
            </div>
          </fieldset>

          <div class="mt-8 flex flex-col items-center gap-4">
            <button
              class="inline-flex min-h-12 w-full max-w-sm items-center justify-center rounded-lg bg-primary px-6 font-label-md font-bold text-on-primary transition-colors hover:bg-primary-container disabled:cursor-wait disabled:opacity-70"
              type="submit"
              data-default-label="Continue to setup"
              data-pending-label="Preparing setup..."
            >
              <span data-submit-label>Continue to setup</span>
            </button>
            <p class="text-center text-body-sm text-on-surface-variant">
              Need to use another account?
              <a class="inline-flex min-h-11 items-center px-2 font-bold text-primary hover:underline" href="/logout">Sign out</a>
            </p>
          </div>
        </form>
      </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
