<% const passwordErrors = fieldErrors || {}; %>
<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="hf-legacy-page flex min-h-screen flex-col bg-surface text-on-surface">
    <%- include('partials/header') %>
    <main class="flex flex-grow items-center justify-center py-12 px-margin-mobile md:px-0 bg-surface">
      <div class="w-full max-w-md">
        <section aria-labelledby="reset-password-heading" class="bg-surface-container-lowest p-8 md:p-10 rounded-xl shadow-[0_4px_12px_rgba(0,35,111,0.04)] border border-outline-variant transition-all duration-300">
        <div class="mb-7 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary-container mb-6">
            <span class="material-symbols-outlined text-primary text-[32px]" aria-hidden="true">lock_reset</span>
          </div>
          <p class="mb-2 text-label-md font-semibold text-primary">Account security</p>
          <h1 id="reset-password-heading" class="text-headline-md font-headline-md text-primary">Choose a new password</h1>
          <p class="mt-3 text-body-md text-on-surface-variant">Use 8 to 128 characters and avoid a password used on another account.</p>
        </div>

          <% if (invalid) { %>
            <div class="mb-5 rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container" data-focus-feedback role="alert" tabindex="-1">This reset link is invalid or has expired.</div>
            <a class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-5 py-3 font-bold text-on-primary" href="/forget-password">Request a new link</a>
          <% } else if (success) { %>
            <div class="mb-5 rounded-lg bg-secondary-container px-4 py-3 text-body-sm text-on-secondary-container" data-focus-feedback role="status" tabindex="-1"><%= success %></div>
            <a class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-5 py-3 font-bold text-on-primary" href="/login">Sign in</a>
          <% } else { %>
            <form action="/reset-password/<%= token %>" class="space-y-5" method="POST" data-submit-feedback data-submit-label="Updating password...">
              <% if (error) { %>
                <div class="rounded-lg bg-error-container px-4 py-3 text-body-sm text-on-error-container" data-focus-feedback role="alert" tabindex="-1"><%= error %></div>
              <% } %>

              <div>
                <label class="mb-2 block text-label-md font-semibold" for="password">New password</label>
                <div class="relative">
                  <input
                    aria-invalid="<%= passwordErrors.password ? 'true' : 'false' %>"
                    aria-describedby="reset-password-help<%= passwordErrors.password ? ' reset-password-error' : '' %>"
                    autocomplete="new-password"
                    class="min-h-12 w-full rounded-lg border <%= passwordErrors.password ? 'border-error' : 'border-outline-variant' %> py-3 pl-4 pr-14 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                    id="password"
                    maxlength="128"
                    minlength="8"
                    name="password"
                    required
                    type="password"
                  />
                  <button aria-controls="password" aria-label="Show password" aria-pressed="false" class="absolute right-1 top-1/2 inline-flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-md text-secondary hover:bg-surface-container-low" data-password-toggle="password" title="Show password" type="button"><span aria-hidden="true" class="material-symbols-outlined">visibility</span></button>
                </div>
                <p class="mt-2 text-body-sm text-secondary" id="reset-password-help">Use 8 to 128 characters.</p>
                <% if (passwordErrors.password) { %><p class="mt-2 text-body-sm text-error" id="reset-password-error"><%= passwordErrors.password %></p><% } %>
              </div>

              <div>
                <label class="mb-2 block text-label-md font-semibold" for="passwordConfirmation">Confirm new password</label>
                <div class="relative">
                  <input
                    aria-invalid="<%= passwordErrors.passwordConfirmation ? 'true' : 'false' %>"
                    <%- passwordErrors.passwordConfirmation ? 'aria-describedby="reset-confirmation-error"' : '' %>
                    autocomplete="new-password"
                    class="min-h-12 w-full rounded-lg border <%= passwordErrors.passwordConfirmation ? 'border-error' : 'border-outline-variant' %> py-3 pl-4 pr-14 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
                    id="passwordConfirmation"
                    maxlength="128"
                    minlength="8"
                    name="passwordConfirmation"
                    required
                    type="password"
                  />
                  <button aria-controls="passwordConfirmation" aria-label="Show password confirmation" aria-pressed="false" class="absolute right-1 top-1/2 inline-flex min-h-11 min-w-11 -translate-y-1/2 items-center justify-center rounded-md text-secondary hover:bg-surface-container-low" data-password-name="password confirmation" data-password-toggle="passwordConfirmation" title="Show password confirmation" type="button"><span aria-hidden="true" class="material-symbols-outlined">visibility</span></button>
                </div>
                <% if (passwordErrors.passwordConfirmation) { %><p class="mt-2 text-body-sm text-error" id="reset-confirmation-error"><%= passwordErrors.passwordConfirmation %></p><% } %>
              </div>

              <button class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-5 py-3 font-bold text-on-primary disabled:cursor-wait disabled:opacity-70" type="submit">Update password</button>
            </form>
          <% } %>
        </section>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
