      </section>
      <!-- The HomiScore for Renters -->
      <section class="py-24 px-margin-desktop bg-surface-container-lowest">
        <div class="max-w-container-max mx-auto">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-4">
              Build Your Rental Reputation
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Your HomiScore is more than just a number; it's a verifiable track
              record of your reliability, making you the most attractive
              candidate for any landlord.
            </p>
          </div>
          <div class="bento-grid">
            <div
              class="col-span-12 md:col-span-8 glass-card p-10 rounded-2xl flex flex-col justify-between group hover:shadow-lg transition-shadow"
            >
              <div>
                <div
                  class="w-12 h-12 bg-primary-container rounded-lg flex items-center justify-center mb-6 text-white group-hover:scale-110 transition-transform"
