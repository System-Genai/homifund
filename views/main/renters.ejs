              <h3 class="font-headline-md text-headline-md mb-4">
                Accountability Matters
              </h3>
              <p class="font-body-md text-body-md opacity-90">
                Verified tenants with high HomiScores are 4x more likely to
                secure their first-choice property within 48 hours of applying.
              </p>
              <a
                class="mt-8 font-label-md text-label-md underline underline-offset-4 hover:opacity-80 transition-opacity"
                href="/FAQs"
                >Learn about scoring logic</a
              >
            </div>
          </div>
        </div>
      </section>
      <!-- Secure & Fast Applications -->
      <section class="py-24 px-margin-desktop overflow-hidden">
        <div
          class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center"
        >
          <div class="order-2 lg:order-1 relative">
            <div
              class="p-8 bg-white rounded-2xl shadow-2xl border border-outline-variant relative z-10"
