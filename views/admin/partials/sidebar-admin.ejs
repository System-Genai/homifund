<!-- Admin Dashboard Sidebar -->
<aside
  class="fixed left-0 top-0 h-screen w-[240px] bg-white border-r border-outline-variant/30 hidden md:flex flex-col py-6 px-4 gap-8 z-50"
>
  <div class="px-2">
    <h1 class="text-headline-md font-bold text-primary">HomiFund</h1>
    <p class="text-[11px] text-secondary font-medium tracking-tight">
      Admin Panel
    </p>
  </div>
  <nav class="flex-1 flex flex-col gap-1">
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'management' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/admin/management"
    >
      <span class="material-symbols-outlined text-[20px]">dashboard</span>
      <span class="text-label-md">Management</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-2.5 <%= locals.currentPage === 'verification-review' ? 'bg-primary/10 rounded-lg text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-low' %> rounded-lg transition-all"
      href="/admin/verification-review"
    >
      <span class="material-symbols-outlined text-[20px]">verified</span>
      <span class="text-label-md">Verification Review</span>
    </a>
  </nav>
  <div class="mt-auto pt-4 border-t border-outline-variant flex flex-col gap-1">
    <a
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all rounded-lg"
      href="/logout"
    >
      <span class="material-symbols-outlined">logout</span>
      <span class="text-label-md">Log Out</span>
    </a>
  </div>
</aside>
