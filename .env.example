DB_URI=mongodb://127.0.0.1:27017/homifund
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
# Authentication cookie lifetime in milliseconds; keep aligned with JWT_EXPIRE.
COOKIE_MAX_AGE_MS=604800000
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=HomiFund <no-reply@example.com>
CONTACT_TO=support@homifund.com
